generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  PARENT
  PARTNER
  TEACHER
  OPERATOR
  CAMPUS_MANAGER
  SUPER_ADMIN
  HR
  FINANCE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ClassGroupStatus {
  ACTIVE
  ARCHIVED
}

enum LessonSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  REVERSED
  CANCELLED
}

enum LessonKind {
  REGULAR
  MAKEUP
  TRIAL
}

enum AttendanceStatus {
  PRESENT
  LEAVE
  ABSENT
}

enum LessonLedgerEntryType {
  GRANT
  CONSUME
  REVERSAL
  ADJUSTMENT
  REFUND
  CORRECTION
}

enum LessonUnitBucket {
  MAIN
  GIFT
}

enum TeachingRecordStatus {
  COMPLETED
  REVERSED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum ParentLeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuthProvider {
  MOCK
  WECHAT
}

enum TeacherEarningBasisType {
  PER_COMPLETED_SESSION
  PER_LESSON_UNIT
  PER_PRESENT_ATTENDEE
}

enum TeacherEarningBasisStatus {
  PRICED
  UNPRICED
  REVERSED
}

enum TeacherEarningEntryType {
  ACCRUAL
  REVERSAL
}

enum TeacherEarningStatus {
  PENDING_REVIEW
  AVAILABLE
  REJECTED
  REVERSED
}

enum PartnerEarningBasisStatus {
  PRICED
  UNPRICED
  REVERSED
}

enum PartnerEarningEntryType {
  ACCRUAL
  REVERSAL
}

enum PartnerEarningStatus {
  PENDING_REVIEW
  AVAILABLE
  REJECTED
  REVERSED
}

enum ConfigurationStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum WithdrawalStatus {
  SUBMITTED
  APPROVED
  PAYING
  PAID
  CANCELLED
  REJECTED
  FAILED
}

enum StoredFilePurpose {
  HR_TEACHER_RECORD_ATTACHMENT
  FINANCE_RECEIPT_PROOF
  FINANCE_REFUND_PROOF
  PAYOUT_PROOF
  PAYMENT_PROOF
  COURSE_PRODUCT_COVER
  STUDENT_FEEDBACK_IMAGE
  CUSTOMER_SERVICE_QR
  GROUP_CAMPAIGN_POSTER
}

enum HrTeacherRecordKind {
  QUALIFICATION
  TRAINING
  GROWTH
}

enum CourseProductStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum EnrollmentOrderStatus {
  AWAITING_PROOF
  AWAITING_PAYMENT
  PENDING_REVIEW
  PAID
  REJECTED
  EFFECTIVE
  REFUNDING
  REFUNDED
  CANCELLED
  VOIDED
}

enum EnrollmentOrderReviewAction {
  APPROVE
  REJECT
  VOID
}

enum GroupCampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum GroupTeamStatus {
  OPEN
  SETTLED
  CANCELLED
}

enum GroupMemberStatus {
  PENDING_PAYMENT
  PAID
  SETTLED
  REFUNDING
  REFUNDED
  CANCELLED
}

enum PaymentTransactionType {
  PAYMENT
  REFUND
}

enum PaymentProvider {
  MOCK
  WECHAT
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model Campus {
  financeReceipts             FinanceReceipt[]
  id                          String                 @id @default(uuid()) @db.Uuid
  code                        String                 @unique @db.VarChar(50)
  name                        String                 @db.VarChar(200)
  timezone                    String                 @default("Asia/Shanghai") @db.VarChar(50)
  contactPhone                String?                @db.VarChar(30)
  customerServiceName         String?                @db.VarChar(100)
  customerServiceQrFileId     String?                @db.Uuid
  address                     String?                @db.VarChar(300)
  latitude                    Decimal?               @db.Decimal(10, 7)
  longitude                   Decimal?               @db.Decimal(10, 7)
  mapVisible                  Boolean                @default(false)
  lessonWarningThresholdUnits Int                    @default(500)
  version                     Int                    @default(1)
  createdAt                   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime               @updatedAt @db.Timestamptz(3)
  userRoles                   UserRole[]
  teacherProfiles             TeacherProfile[]
  students                    Student[]
  classGroups                 ClassGroup[]
  classMembers                ClassMember[]
  lessonSessions              LessonSession[]
  coursePackages              CoursePackage[]
  attendanceRecords           AttendanceRecord[]
  lessonLedger                LessonLedgerEntry[]
  teachingRecords             TeachingRecord[]
  studentFeedback             StudentFeedback[]
  idempotencyRecords          IdempotencyRecord[]
  auditLogs                   AuditLog[]
  parentBindings              ParentStudentBinding[]
  parentLeaveRequests         ParentLeaveRequest[]
  teacherEarningRules         TeacherEarningRule[]
  teacherEarningBases         TeacherEarningBasis[]
  teacherEarningEntries       TeacherEarningEntry[]
  partnerEarningRules         PartnerEarningRule[]
  partnerEarningBases         PartnerEarningBasis[]
  partnerEarningEntries       PartnerEarningEntry[]
  withdrawals                 Withdrawal[]
  courseProducts              CourseProduct[]
  enrollmentOrders            EnrollmentOrder[]
  groupCampaigns              GroupCampaign[]
  customerServiceQrFile       StoredFile?            @relation("CampusCustomerServiceQr", fields: [customerServiceQrFileId], references: [id], onDelete: Restrict)
}

model User {
  createdHrTeacherRecords       HrTeacherRecord[]               @relation("HrTeacherRecordCreator")
  financeCorrectionRequests     FinanceReceiptCorrection[]      @relation("FinanceCorrectionRequester")
  financeCorrectionReviews      FinanceReceiptCorrection[]      @relation("FinanceCorrectionReviewer")
  financeCorrectionApplications FinanceReceiptCorrection[]      @relation("FinanceCorrectionApplier")
  financeCorrectionEvents       FinanceReceiptCorrectionEvent[]
  financeRefundRequests         FinanceRefundRequest[]          @relation("FinanceRefundRequester")
  financeRefundReviews          FinanceRefundRequest[]          @relation("FinanceRefundReviewer")
  financeRefundEvents           FinanceRefundEvent[]
  financeRefundPayments         FinanceRefundPayment[]
  financeReceipts               FinanceReceipt[]
  financeIssuances              FinancePackageIssuance[]
  id                            String                          @id @default(uuid()) @db.Uuid
  displayName                   String                          @db.VarChar(100)
  staffPhone                    String?                         @unique @db.VarChar(20)
  parentPhone                   String?                         @db.VarChar(20)
  status                        UserStatus                      @default(ACTIVE)
  accountVersion                Int                             @default(1)
  createdAt                     DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime                        @updatedAt @db.Timestamptz(3)
  roles                         UserRole[]
  teacherProfile                TeacherProfile?
  recordedAttendance            AttendanceRecord[]              @relation("AttendanceRecorder")
  lessonLedger                  LessonLedgerEntry[]             @relation("LessonLedgerActor")
  teachingRecords               TeachingRecord[]                @relation("TeachingRecordActor")
  idempotencyRecords            IdempotencyRecord[]             @relation("IdempotencyActor")
  auditLogs                     AuditLog[]                      @relation("AuditActor")
  authIdentities                AuthIdentity[]
  staffBindTokens               StaffBindToken[]
  parentStudentBindings         ParentStudentBinding[]          @relation("ParentStudentBindingUser")
  parentLeaveRequests           ParentLeaveRequest[]            @relation("ParentLeaveRequestUser")
  reviewedParentLeaves          ParentLeaveRequest[]            @relation("ParentLeaveRequestReviewer")
  createdEarningRules           TeacherEarningRule[]            @relation("TeacherEarningRuleCreator")
  createdWithdrawalPolicies     TeacherWithdrawalPolicy[]       @relation("TeacherWithdrawalPolicyCreator")
  reviewedEarningEntries        TeacherEarningEntry[]           @relation("TeacherEarningEntryReviewer")
  createdPartnerEarningRules    PartnerEarningRule[]            @relation("PartnerEarningRuleCreator")
  reviewedPartnerEarningEntries PartnerEarningEntry[]           @relation("PartnerEarningEntryReviewer")
  requestedWithdrawals          Withdrawal[]                    @relation("WithdrawalRequester")
  reviewedWithdrawals           Withdrawal[]                    @relation("WithdrawalReviewer")
  paidWithdrawals               Withdrawal[]                    @relation("WithdrawalPayer")
  createdStoredFiles            StoredFile[]                    @relation("StoredFileCreator")
  createdCourseProducts         CourseProduct[]                 @relation("CourseProductCreator")
  enrollmentOrders              EnrollmentOrder[]               @relation("EnrollmentOrderParent")
  reviewedEnrollmentOrders      EnrollmentOrder[]               @relation("EnrollmentOrderCurrentReviewer")
  submittedPaymentProofs        EnrollmentPaymentProof[]        @relation("EnrollmentPaymentProofSubmitter")
  enrollmentOrderReviews        EnrollmentOrderReview[]         @relation("EnrollmentOrderReviewActor")
  createdGroupCampaigns         GroupCampaign[]                 @relation("GroupCampaignCreator")
  ledGroupTeams                 GroupTeam[]                     @relation("GroupTeamLeader")
  groupMemberships              GroupMember[]                   @relation("GroupMemberParent")

  @@index([parentPhone])
}

model AuthIdentity {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  provider  AuthProvider
  subject   String       @db.VarChar(256)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@index([userId])
}

model StaffBindToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenDigest String    @unique @db.VarChar(64)
  tokenHash   String    @db.VarChar(255)
  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleCode  RoleCode
  campusId  String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  campus    Campus?  @relation(fields: [campusId], references: [id], onDelete: Restrict)

  @@unique([userId, roleCode, campusId])
  @@index([campusId, roleCode])
}

model TeacherProfile {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @unique @db.Uuid
  campusId        String                @db.Uuid
  employeeCode    String                @unique @db.VarChar(50)
  specialties     String[]              @default([])
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  campus          Campus                @relation(fields: [campusId], references: [id], onDelete: Restrict)
  classGroups     ClassGroup[]
  lessonSessions  LessonSession[]
  teachingRecords TeachingRecord[]
  studentFeedback StudentFeedback[]
  earningRules    TeacherEarningRule[]
  earningBases    TeacherEarningBasis[]
  earningEntries  TeacherEarningEntry[]
  withdrawals     Withdrawal[]
  hrRecords       HrTeacherRecord[]

  @@index([campusId])
}

model HrTeacherRecord {
  id               String              @id @default(uuid()) @db.Uuid
  teacherId        String              @db.Uuid
  kind             HrTeacherRecordKind
  title            String              @db.VarChar(200)
  organization     String?             @db.VarChar(200)
  occurredOn       DateTime            @db.Date
  expiresOn        DateTime?           @db.Date
  note             String              @default("") @db.VarChar(1000)
  attachmentFileId String?             @unique @db.Uuid
  version          Int                 @default(1)
  archivedAt       DateTime?           @db.Timestamptz(3)
  createdByUserId  String              @db.Uuid
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  teacher          TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  attachment       StoredFile?         @relation("HrTeacherRecordAttachment", fields: [attachmentFileId], references: [id], onDelete: Restrict)
  createdBy        User                @relation("HrTeacherRecordCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([teacherId, archivedAt, occurredOn, id])
  @@index([kind, occurredOn])
}

model Student {
  financeReceipts     FinanceReceipt[]
  id                  String                 @id @default(uuid()) @db.Uuid
  campusId            String                 @db.Uuid
  displayName         String                 @db.VarChar(100)
  birthDate           DateTime?              @db.Date
  profileAge          Int?
  homeAddress         String?                @db.VarChar(300)
  profileVersion      Int                    @default(1)
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)
  campus              Campus                 @relation(fields: [campusId], references: [id], onDelete: Restrict)
  classMemberships    ClassMember[]
  coursePackages      CoursePackage[]
  attendanceRecords   AttendanceRecord[]
  lessonLedger        LessonLedgerEntry[]
  feedback            StudentFeedback[]
  parentBindings      ParentStudentBinding[]
  parentLeaveRequests ParentLeaveRequest[]
  enrollmentOrders    EnrollmentOrder[]
  groupMemberships    GroupMember[]

  @@index([campusId, displayName])
}

model ClassGroup {
  id                 String           @id @default(uuid()) @db.Uuid
  campusId           String           @db.Uuid
  teacherId          String           @db.Uuid
  name               String           @db.VarChar(200)
  courseName         String           @db.VarChar(200)
  defaultLessonUnits Int              @default(100)
  status             ClassGroupStatus @default(ACTIVE)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  campus             Campus           @relation(fields: [campusId], references: [id], onDelete: Restrict)
  teacher            TeacherProfile   @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  members            ClassMember[]
  lessonSessions     LessonSession[]

  @@unique([campusId, name])
  @@index([teacherId, status])
}

model ClassMember {
  id           String     @id @default(uuid()) @db.Uuid
  campusId     String     @db.Uuid
  classGroupId String     @db.Uuid
  studentId    String     @db.Uuid
  joinedAt     DateTime   @default(now()) @db.Timestamptz(3)
  leftAt       DateTime?  @db.Timestamptz(3)
  campus       Campus     @relation(fields: [campusId], references: [id], onDelete: Restrict)
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([classGroupId, studentId])
  @@index([campusId])
  @@index([studentId])
}

model LessonSession {
  id                  String                @id @default(uuid()) @db.Uuid
  campusId            String                @db.Uuid
  classGroupId        String                @db.Uuid
  teacherId           String                @db.Uuid
  startsAt            DateTime              @db.Timestamptz(3)
  endsAt              DateTime              @db.Timestamptz(3)
  status              LessonSessionStatus   @default(SCHEDULED)
  kind                LessonKind            @default(REGULAR)
  lessonUnits         Int                   @default(100)
  version             Int                   @default(1)
  completedAt         DateTime?             @db.Timestamptz(3)
  reversedAt          DateTime?             @db.Timestamptz(3)
  reversalReason      String?               @db.VarChar(500)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  campus              Campus                @relation(fields: [campusId], references: [id], onDelete: Restrict)
  classGroup          ClassGroup            @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  teacher             TeacherProfile        @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  attendanceRecords   AttendanceRecord[]
  lessonLedger        LessonLedgerEntry[]
  teachingRecord      TeachingRecord?
  feedback            StudentFeedback[]
  parentLeaveRequests ParentLeaveRequest[]
  earningBases        TeacherEarningBasis[]
  partnerEarningBases PartnerEarningBasis[]

  @@index([teacherId, startsAt])
  @@index([campusId])
  @@index([classGroupId, startsAt])
}

model CoursePackage {
  financeIssuance   FinancePackageIssuance?
  id                String                  @id @default(uuid()) @db.Uuid
  campusId          String                  @db.Uuid
  studentId         String                  @db.Uuid
  name              String                  @db.VarChar(200)
  mainBalanceUnits  Int                     @default(0)
  giftBalanceUnits  Int                     @default(0)
  mainReservedUnits Int                     @default(0)
  giftReservedUnits Int                     @default(0)
  paidAmountFen     Int                     @default(0)
  version           Int                     @default(1)
  validFrom         DateTime                @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime?               @db.Timestamptz(3)
  isActive          Boolean                 @default(true)
  sourceOrderId     String?                 @unique @db.Uuid
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)
  campus            Campus                  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  student           Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  lessonLedger      LessonLedgerEntry[]
  sourceOrder       EnrollmentOrder?        @relation("EnrollmentOrderCoursePackage", fields: [sourceOrderId], references: [id], onDelete: Restrict)

  @@index([campusId, studentId])
  @@index([studentId, isActive, expiresAt])
}

model CourseProduct {
  id              String              @id @default(uuid()) @db.Uuid
  campusId        String              @db.Uuid
  name            String              @db.VarChar(200)
  summary         String              @db.VarChar(1000)
  coverFileId     String?             @db.Uuid
  priceFen        Int
  mainUnits       Int
  giftUnits       Int
  validityDays    Int
  status          CourseProductStatus @default(DRAFT)
  version         Int                 @default(1)
  createdByUserId String              @db.Uuid
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  campus          Campus              @relation(fields: [campusId], references: [id], onDelete: Restrict)
  coverFile       StoredFile?         @relation("CourseProductCover", fields: [coverFileId], references: [id], onDelete: Restrict)
  createdBy       User                @relation("CourseProductCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  orders          EnrollmentOrder[]
  groupCampaigns  GroupCampaign[]

  @@index([campusId, status, createdAt])
}

model EnrollmentOrder {
  id                   String                   @id @default(uuid()) @db.Uuid
  orderNo              String                   @unique @db.VarChar(64)
  parentUserId         String                   @db.Uuid
  studentId            String                   @db.Uuid
  campusId             String                   @db.Uuid
  courseProductId      String                   @db.Uuid
  productNameSnapshot  String                   @db.VarChar(200)
  priceFenSnapshot     Int
  mainUnitsSnapshot    Int
  giftUnitsSnapshot    Int
  validityDaysSnapshot Int
  status               EnrollmentOrderStatus    @default(AWAITING_PROOF)
  version              Int                      @default(1)
  reviewedByUserId     String?                  @db.Uuid
  reviewedAt           DateTime?                @db.Timestamptz(3)
  reviewReason         String?                  @db.VarChar(500)
  cancelledAt          DateTime?                @db.Timestamptz(3)
  voidedAt             DateTime?                @db.Timestamptz(3)
  voidReason           String?                  @db.VarChar(500)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)
  parent               User                     @relation("EnrollmentOrderParent", fields: [parentUserId], references: [id], onDelete: Restrict)
  student              Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  campus               Campus                   @relation(fields: [campusId], references: [id], onDelete: Restrict)
  courseProduct        CourseProduct            @relation(fields: [courseProductId], references: [id], onDelete: Restrict)
  currentReviewer      User?                    @relation("EnrollmentOrderCurrentReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  paymentProofs        EnrollmentPaymentProof[]
  reviews              EnrollmentOrderReview[]
  coursePackage        CoursePackage?           @relation("EnrollmentOrderCoursePackage")
  groupMember          GroupMember?
  paymentTransactions  PaymentTransaction[]

  @@index([parentUserId, status, createdAt])
  @@index([campusId, status, createdAt])
  @@index([studentId, createdAt])
}

model EnrollmentPaymentProof {
  id                String                  @id @default(uuid()) @db.Uuid
  orderId           String                  @db.Uuid
  storedFileId      String                  @unique @db.Uuid
  attemptNo         Int
  submittedByUserId String                  @db.Uuid
  submittedAt       DateTime                @default(now()) @db.Timestamptz(3)
  order             EnrollmentOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  storedFile        StoredFile              @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  submittedBy       User                    @relation("EnrollmentPaymentProofSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviews           EnrollmentOrderReview[]

  @@unique([orderId, attemptNo])
  @@index([orderId, submittedAt])
}

model EnrollmentOrderReview {
  id             String                      @id @default(uuid()) @db.Uuid
  orderId        String                      @db.Uuid
  paymentProofId String?                     @db.Uuid
  action         EnrollmentOrderReviewAction
  fromStatus     EnrollmentOrderStatus
  toStatus       EnrollmentOrderStatus
  reason         String?                     @db.VarChar(500)
  actorUserId    String                      @db.Uuid
  createdAt      DateTime                    @default(now()) @db.Timestamptz(3)
  order          EnrollmentOrder             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentProof   EnrollmentPaymentProof?     @relation(fields: [paymentProofId], references: [id], onDelete: Restrict)
  actor          User                        @relation("EnrollmentOrderReviewActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
}

model GroupCampaign {
  id              String                @id @default(uuid()) @db.Uuid
  code            String                @unique @db.VarChar(64)
  campusId        String                @db.Uuid
  courseProductId String                @db.Uuid
  title           String                @db.VarChar(200)
  description     String                @db.VarChar(1000)
  priceFen        Int
  maxPaidMembers  Int                   @default(3)
  startsAt        DateTime              @db.Timestamptz(3)
  endsAt          DateTime              @db.Timestamptz(3)
  status          GroupCampaignStatus   @default(DRAFT)
  version         Int                   @default(1)
  createdByUserId String                @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  campus          Campus                @relation(fields: [campusId], references: [id], onDelete: Restrict)
  courseProduct   CourseProduct         @relation(fields: [courseProductId], references: [id], onDelete: Restrict)
  createdBy       User                  @relation("GroupCampaignCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  teams           GroupTeam[]
  members         GroupMember[]
  posters         GroupCampaignPoster[]

  @@index([campusId, status, startsAt, endsAt])
}

model GroupCampaignPoster {
  id           String        @id @default(uuid()) @db.Uuid
  campaignId   String        @db.Uuid
  storedFileId String        @unique @db.Uuid
  sortOrder    Int
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  campaign     GroupCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  storedFile   StoredFile    @relation(fields: [storedFileId], references: [id], onDelete: Restrict)

  @@unique([campaignId, sortOrder])
  @@index([campaignId])
}

model GroupTeam {
  id              String          @id @default(uuid()) @db.Uuid
  campaignId      String          @db.Uuid
  leaderUserId    String          @db.Uuid
  status          GroupTeamStatus @default(OPEN)
  paidMemberCount Int             @default(0)
  finalTier       Int?
  settledAt       DateTime?       @db.Timestamptz(3)
  version         Int             @default(1)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  campaign        GroupCampaign   @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  leader          User            @relation("GroupTeamLeader", fields: [leaderUserId], references: [id], onDelete: Restrict)
  members         GroupMember[]

  @@index([campaignId, status, createdAt])
}

model GroupMember {
