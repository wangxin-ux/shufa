  reversedBy       PartnerEarningEntry?    @relation("PartnerEarningReversal")

  @@index([campusId, status, createdAt])
  @@index([earningBasisId, entryType])
}

model PartnerRankingCoverage {
  id        String   @id @db.VarChar(40)
  startedAt DateTime @default(now()) @db.Timestamptz(3)
}

model PartnerRankingStudentFact {
  id         BigInt   @id @default(autoincrement())
  studentId  String   @db.Uuid
  campusId   String   @db.Uuid
  isActive   Boolean
  recordedAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  campus     Campus   @relation(fields: [campusId], references: [id], onDelete: Restrict)

  @@index([studentId, recordedAt, id])
  @@index([campusId, recordedAt])
}

model PartnerRankingRevision {
  id                 String              @id @default(uuid()) @db.Uuid
  metric             String              @db.VarChar(30)
  month              String              @db.VarChar(7)
  timezone           String              @default("Asia/Shanghai") @db.VarChar(50)
  asOf               DateTime            @db.Timestamptz(3)
  calculationVersion String              @db.VarChar(40)
  sourceHash         String              @db.VarChar(64)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  rows               PartnerRankingRow[]

  @@unique([metric, month, sourceHash])
  @@index([metric, month, createdAt])
}

model PartnerRankingRow {
  revisionId   String                 @db.Uuid
  campusId     String                 @db.Uuid
  campusName   String                 @db.VarChar(200)
  value        BigInt
  rank         Int
  previousRank Int?
  position     Int
  revision     PartnerRankingRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  campus       Campus                 @relation(fields: [campusId], references: [id], onDelete: Restrict)

  @@id([revisionId, campusId])
  @@unique([revisionId, position])
}

model Withdrawal {
  id                String                  @id @default(uuid()) @db.Uuid
  requestNo         String                  @unique @db.VarChar(64)
  campusId          String                  @db.Uuid
  teacherProfileId  String                  @db.Uuid
  requestedByUserId String                  @db.Uuid
  policyId          String                  @db.Uuid
  amountFen         Int
  status            WithdrawalStatus        @default(SUBMITTED)
  policySnapshot    Json
  reviewedByUserId  String?                 @db.Uuid
  reviewedAt        DateTime?               @db.Timestamptz(3)
  rejectionReason   String?                 @db.VarChar(500)
  payingAt          DateTime?               @db.Timestamptz(3)
  paidByUserId      String?                 @db.Uuid
  paidAt            DateTime?               @db.Timestamptz(3)
  payoutReference   String?                 @db.VarChar(128)
  payoutProofFileId String?                 @db.Uuid
  failedAt          DateTime?               @db.Timestamptz(3)
  failureReason     String?                 @db.VarChar(500)
  version           Int                     @default(1)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)
  campus            Campus                  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  teacher           TeacherProfile          @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  requestedBy       User                    @relation("WithdrawalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  policy            TeacherWithdrawalPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  reviewedBy        User?                   @relation("WithdrawalReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  paidBy            User?                   @relation("WithdrawalPayer", fields: [paidByUserId], references: [id], onDelete: Restrict)
  payoutProof       StoredFile?             @relation(fields: [payoutProofFileId], references: [id], onDelete: Restrict)
  allocations       WithdrawalAllocation[]

  @@index([teacherProfileId, status, createdAt])
  @@index([campusId, status, createdAt])
  @@index([requestedByUserId, createdAt])
}

model WithdrawalAllocation {
  id             String              @id @default(uuid()) @db.Uuid
  withdrawalId   String              @db.Uuid
  earningEntryId String              @db.Uuid
  amountFen      Int
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  withdrawal     Withdrawal          @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  earningEntry   TeacherEarningEntry @relation(fields: [earningEntryId], references: [id], onDelete: Restrict)

  @@unique([withdrawalId, earningEntryId])
  @@index([earningEntryId])
}

model StoredFile {
  partnerDraftCovers PartnerCampaignDraft[] @relation("PartnerDraftCover")
  partnerDraftShares PartnerCampaignDraft[] @relation("PartnerDraftShare")
  campaignVersionCovers CampaignVersion[] @relation("CampaignVersionCover")
  campaignVersionShares CampaignVersion[] @relation("CampaignVersionShare")
  partnerPayoutProof PartnerPayoutProof?
  photoTargetStudentId String? @db.Uuid
  photoTargetStudent Student? @relation("StudentPhotoTarget", fields: [photoTargetStudentId], references: [id], onDelete: Restrict)
  profilePhotoStudent Student? @relation("StudentProfilePhoto")
  hrTeacherRecordAttachment HrTeacherRecord?          @relation("HrTeacherRecordAttachment")
  financeCorrectionProposal FinanceReceiptCorrection? @relation("FinanceCorrectionProposedProof")
  financeRefundPayment      FinanceRefundPayment?
  financeReceipt            FinanceReceipt?
  id                        String                    @id @default(uuid()) @db.Uuid
  purpose                   StoredFilePurpose
  storageKey                String                    @unique @db.VarChar(255)
  originalName              String                    @db.VarChar(255)
  mimeType                  String                    @db.VarChar(100)
  sizeBytes                 Int
  sha256                    String                    @db.VarChar(64)
  createdByUserId           String                    @db.Uuid
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(3)
  createdBy                 User                      @relation("StoredFileCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  withdrawals               Withdrawal[]
  courseProductCovers       CourseProduct[]           @relation("CourseProductCover")
  enrollmentPaymentProof    EnrollmentPaymentProof?
  studentFeedbackImage      StudentFeedbackImage?
  customerServiceCampuses   Campus[]                  @relation("CampusCustomerServiceQr")
  groupCampaignPoster       GroupCampaignPoster?
  partnerApplicationCipher  PartnerApplicationFileCipher?
  partnerApplicationMaterials PartnerApplicationMaterialItem[]

  @@index([createdByUserId, createdAt])
}

