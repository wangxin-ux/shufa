  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)
  requestedBy User @relation("PartnerWithdrawalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("PartnerWithdrawalReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  paidBy User? @relation("PartnerWithdrawalPayer", fields: [paidByUserId], references: [id], onDelete: Restrict)
