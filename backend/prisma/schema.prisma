  payerName String @db.VarChar(100)
  beneficiaryName String @db.VarChar(100)
  accountLastFour String @db.Char(4)
  minimumAmountFen Int
  dailyRequestLimit Int
  configuredByUserId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)
  configuredBy User @relation("PartnerSettlementConfigurer", fields: [configuredByUserId], references: [id], onDelete: Restrict)
}

model PartnerSettlementSource {
  id String @id @default(uuid()) @db.Uuid
  campusId String @db.Uuid
  earningEntryId String @unique @db.Uuid
  amountFen Int
  profileSnapshot Json
  confirmedByUserId String @db.Uuid
  reason String @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)
  earningEntry PartnerEarningEntry @relation(fields: [earningEntryId], references: [id], onDelete: Restrict)
