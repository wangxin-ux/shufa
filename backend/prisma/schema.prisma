generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  PARENT
  PARTNER
  TEACHER
  OPERATOR
  CAMPUS_MANAGER
  SUPER_ADMIN
  HR
  FINANCE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ClassGroupStatus {
  ACTIVE
  ARCHIVED
}

enum LessonSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  REVERSED
  CANCELLED
}

enum LessonKind {
  REGULAR
  MAKEUP
  TRIAL
}

enum AttendanceStatus {
  PRESENT
  LEAVE
  ABSENT
}

enum LessonLedgerEntryType {
  GRANT
  CONSUME
  REVERSAL
  ADJUSTMENT
  REFUND
  CORRECTION
}

enum LessonUnitBucket {
  MAIN
  GIFT
}

enum TeachingRecordStatus {
  COMPLETED
  REVERSED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum ParentLeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuthProvider {
  MOCK
  WECHAT
}

enum TeacherEarningBasisType {
  PER_COMPLETED_SESSION
  PER_LESSON_UNIT
  PER_PRESENT_ATTENDEE
}

enum TeacherEarningBasisStatus {
  PRICED
  UNPRICED
  REVERSED
}

enum TeacherEarningEntryType {
  ACCRUAL
  REVERSAL
}

enum TeacherEarningStatus {
  PENDING_REVIEW
  AVAILABLE
  REJECTED
  REVERSED
}

enum PartnerEarningBasisStatus {
  PRICED
  UNPRICED
  REVERSED
}

enum PartnerEarningEntryType {
  ACCRUAL
  REVERSAL
}

enum PartnerEarningStatus {
  PENDING_REVIEW
  AVAILABLE
  REJECTED
  REVERSED
}

enum ConfigurationStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum WithdrawalStatus {
  SUBMITTED
  APPROVED
  PAYING
  PAID
  CANCELLED
  REJECTED
  FAILED
}

enum StoredFilePurpose {
  HR_TEACHER_RECORD_ATTACHMENT
  FINANCE_RECEIPT_PROOF
  FINANCE_REFUND_PROOF
  PAYOUT_PROOF
  PAYMENT_PROOF
  COURSE_PRODUCT_COVER
  STUDENT_FEEDBACK_IMAGE
  STUDENT_PROFILE_PHOTO
  CUSTOMER_SERVICE_QR
  GROUP_CAMPAIGN_POSTER
  PARTNER_CAMPAIGN_IMAGE
  PARTNER_APPLICATION_MATERIAL
}

enum HrTeacherRecordKind {
  QUALIFICATION
  TRAINING
  GROWTH
}

enum CourseProductStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum EnrollmentOrderStatus {
  AWAITING_PROOF
  AWAITING_PAYMENT
  PENDING_REVIEW
  PAID
  REJECTED
  EFFECTIVE
  REFUNDING
  REFUNDED
  CANCELLED
  VOIDED
}

enum EnrollmentOrderReviewAction {
  APPROVE
  REJECT
  VOID
}

enum GroupCampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum GroupTeamStatus {
  OPEN
  SETTLED
  CANCELLED
}

enum GroupMemberStatus {
  PENDING_PAYMENT
  PAID
  SETTLED
  REFUNDING
  REFUNDED
  CANCELLED
}

enum PaymentTransactionType {
  PAYMENT
  REFUND
}

enum PaymentProvider {
  MOCK
  WECHAT
}

enum PaymentTransactionStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model Campus {
  operatorReadGrants          OperatorCampusReadGrant[]
  partnerSettlementProfile    PartnerSettlementProfile?
  partnerSettlementSources    PartnerSettlementSource[]
  partnerWithdrawals          PartnerWithdrawal[]
  subjects                    CampusSubject[]
  partnerApplicationApproval  PartnerApplicationApproval?
  parentLessonReviews         ParentLessonReview[]
  financeReceipts             FinanceReceipt[]
  id                          String                 @id @default(uuid()) @db.Uuid
  code                        String                 @unique @db.VarChar(50)
  name                        String                 @db.VarChar(200)
  timezone                    String                 @default("Asia/Shanghai") @db.VarChar(50)
  contactPhone                String?                @db.VarChar(30)
  customerServiceName         String?                @db.VarChar(100)
  customerServiceQrFileId     String?                @db.Uuid
  address                     String?                @db.VarChar(300)
  latitude                    Decimal?               @db.Decimal(10, 7)
  longitude                   Decimal?               @db.Decimal(10, 7)
  mapVisible                  Boolean                @default(false)
  lessonWarningThresholdUnits Int                    @default(500)
  version                     Int                    @default(1)
  createdAt                   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime               @updatedAt @db.Timestamptz(3)
  userRoles                   UserRole[]
  teacherProfiles             TeacherProfile[]
  students                    Student[]
  classGroups                 ClassGroup[]
  classMembers                ClassMember[]
  lessonSessions              LessonSession[]
  lessonSeries                LessonSeries[]
  temporaryLessonMembers      LessonTemporaryMember[]
  coursePackages              CoursePackage[]
  attendanceRecords           AttendanceRecord[]
  lessonLedger                LessonLedgerEntry[]
  teachingRecords             TeachingRecord[]
  studentFeedback             StudentFeedback[]
  idempotencyRecords          IdempotencyRecord[]
  auditLogs                   AuditLog[]
  parentBindings              ParentStudentBinding[]
  parentLeaveRequests         ParentLeaveRequest[]
  teacherEarningRules         TeacherEarningRule[]
  teacherEarningBases         TeacherEarningBasis[]
  teacherEarningEntries       TeacherEarningEntry[]
  partnerEarningRules         PartnerEarningRule[]
  partnerEarningBases         PartnerEarningBasis[]
  partnerEarningEntries       PartnerEarningEntry[]
  withdrawals                 Withdrawal[]
  courseProducts              CourseProduct[]
  enrollmentOrders            EnrollmentOrder[]
  groupCampaigns              GroupCampaign[]
  partnerCampaignDrafts       PartnerCampaignDraft[]
  freeCampaigns              Campaign[]
  freeCampaignVersions       CampaignVersion[]
  freeCampaignRegistrations  CampaignRegistration[]
  rankingStudentFacts        PartnerRankingStudentFact[]
  rankingRows                PartnerRankingRow[]
  customerServiceQrFile       StoredFile?            @relation("CampusCustomerServiceQr", fields: [customerServiceQrFileId], references: [id], onDelete: Restrict)
}

model User {
  operatorReadGrants          OperatorCampusReadGrant[]
  partnerTeacherEvaluations  PartnerTeacherEvaluation[]
  partnerSettlementProfiles  PartnerSettlementProfile[] @relation("PartnerSettlementConfigurer")
  partnerSettlementSources   PartnerSettlementSource[] @relation("PartnerSettlementConfirmer")
  partnerWithdrawalRequests  PartnerWithdrawal[] @relation("PartnerWithdrawalRequester")
  partnerWithdrawalReviews   PartnerWithdrawal[] @relation("PartnerWithdrawalReviewer")
  partnerWithdrawalPayments  PartnerWithdrawal[] @relation("PartnerWithdrawalPayer")
  parentLessonReviews           ParentLessonReview[]
  createdHrTeacherRecords       HrTeacherRecord[]               @relation("HrTeacherRecordCreator")
  financeCorrectionRequests     FinanceReceiptCorrection[]      @relation("FinanceCorrectionRequester")
  financeCorrectionReviews      FinanceReceiptCorrection[]      @relation("FinanceCorrectionReviewer")
  financeCorrectionApplications FinanceReceiptCorrection[]      @relation("FinanceCorrectionApplier")
  financeCorrectionEvents       FinanceReceiptCorrectionEvent[]
  financeRefundRequests         FinanceRefundRequest[]          @relation("FinanceRefundRequester")
  financeRefundReviews          FinanceRefundRequest[]          @relation("FinanceRefundReviewer")
  financeRefundEvents           FinanceRefundEvent[]
  financeRefundPayments         FinanceRefundPayment[]
  financeReceipts               FinanceReceipt[]
  financeIssuances              FinancePackageIssuance[]
  id                            String                          @id @default(uuid()) @db.Uuid
  displayName                   String                          @db.VarChar(100)
  staffPhone                    String?                         @unique @db.VarChar(20)
  parentPhone                   String?                         @db.VarChar(20)
  status                        UserStatus                      @default(ACTIVE)
  accountVersion                Int                             @default(1)
  createdAt                     DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime                        @updatedAt @db.Timestamptz(3)
  roles                         UserRole[]
  teacherProfile                TeacherProfile?
  recordedAttendance            AttendanceRecord[]              @relation("AttendanceRecorder")
  addedTemporaryLessonMembers   LessonTemporaryMember[]         @relation("TemporaryLessonMemberAdder")
  removedTemporaryLessonMembers LessonTemporaryMember[]         @relation("TemporaryLessonMemberRemover")
  createdLessonSeries           LessonSeries[]
  lessonLedger                  LessonLedgerEntry[]             @relation("LessonLedgerActor")
  teachingRecords               TeachingRecord[]                @relation("TeachingRecordActor")
  idempotencyRecords            IdempotencyRecord[]             @relation("IdempotencyActor")
  auditLogs                     AuditLog[]                      @relation("AuditActor")
  authIdentities                AuthIdentity[]
  partnerApplicant              PartnerApplicant?
  partnerApplicationBankRecords PartnerApplicationBankRecord[]
  partnerApplicationUploads     PartnerApplicationUpload[]
  partnerApplicationReviews     PartnerApplicationReview[]
  partnerApplicationApproval    PartnerApplicationApproval?
  staffBindTokens               StaffBindToken[]
  parentStudentBindings         ParentStudentBinding[]          @relation("ParentStudentBindingUser")
  parentLeaveRequests           ParentLeaveRequest[]            @relation("ParentLeaveRequestUser")
  reviewedParentLeaves          ParentLeaveRequest[]            @relation("ParentLeaveRequestReviewer")
  createdEarningRules           TeacherEarningRule[]            @relation("TeacherEarningRuleCreator")
  createdWithdrawalPolicies     TeacherWithdrawalPolicy[]       @relation("TeacherWithdrawalPolicyCreator")
  reviewedEarningEntries        TeacherEarningEntry[]           @relation("TeacherEarningEntryReviewer")
  createdPartnerEarningRules    PartnerEarningRule[]            @relation("PartnerEarningRuleCreator")
  reviewedPartnerEarningEntries PartnerEarningEntry[]           @relation("PartnerEarningEntryReviewer")
  requestedWithdrawals          Withdrawal[]                    @relation("WithdrawalRequester")
  reviewedWithdrawals           Withdrawal[]                    @relation("WithdrawalReviewer")
  paidWithdrawals               Withdrawal[]                    @relation("WithdrawalPayer")
  createdStoredFiles            StoredFile[]                    @relation("StoredFileCreator")
  createdCourseProducts         CourseProduct[]                 @relation("CourseProductCreator")
  enrollmentOrders              EnrollmentOrder[]               @relation("EnrollmentOrderParent")
  reviewedEnrollmentOrders      EnrollmentOrder[]               @relation("EnrollmentOrderCurrentReviewer")
  submittedPaymentProofs        EnrollmentPaymentProof[]        @relation("EnrollmentPaymentProofSubmitter")
  enrollmentOrderReviews        EnrollmentOrderReview[]         @relation("EnrollmentOrderReviewActor")
  createdGroupCampaigns         GroupCampaign[]                 @relation("GroupCampaignCreator")
  createdPartnerCampaignDrafts  PartnerCampaignDraft[]
  closedFreeCampaigns           Campaign[] @relation("FreeCampaignCloser")
  submittedFreeCampaignVersions CampaignVersion[] @relation("FreeCampaignSubmitter")
  reviewedFreeCampaignVersions  CampaignVersion[] @relation("FreeCampaignReviewer")
  freeCampaignRegistrations     CampaignRegistration[] @relation("FreeRegistrationParent")
  cancelledFreeRegistrations    CampaignRegistration[] @relation("FreeRegistrationCanceller")
  ledGroupTeams                 GroupTeam[]                     @relation("GroupTeamLeader")
  groupMemberships              GroupMember[]                   @relation("GroupMemberParent")

  @@index([parentPhone])
}

model AuthIdentity {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  provider  AuthProvider
  subject   String       @db.VarChar(256)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@index([userId])
}

enum PartnerApplicationStatus {
  DRAFT
  SUBMITTED
  REJECTED
  APPROVED
}

model PartnerApplicant {
  id        String                    @id @default(uuid()) @db.Uuid
  userId    String                    @unique @db.Uuid
  createdAt DateTime                  @default(now()) @db.Timestamptz(3)
  user      User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions  PartnerApplicantSession[]
  application PartnerApplication?
}

model PartnerApplication {
  id              String                   @id @default(uuid()) @db.Uuid
  applicantId     String                   @unique @db.Uuid
  status          PartnerApplicationStatus @default(DRAFT)
  version         Int                      @default(1)
  institutionName String?                  @db.VarChar(200)
  province        String?                  @db.VarChar(100)
  city            String?                  @db.VarChar(100)
  district        String?                  @db.VarChar(100)
  detailedAddress String?                  @db.VarChar(300)
  contactPhone    String?                  @db.VarChar(30)
  currentBankRecordId String?               @unique @db.Uuid
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(3)
  applicant       PartnerApplicant         @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  currentBankRecord PartnerApplicationBankRecord? @relation("CurrentApplicationBank", fields: [currentBankRecordId], references: [id], onDelete: Restrict)
  bankRecords     PartnerApplicationBankRecord[] @relation("ApplicationBankHistory")
  currentMaterialRecordId String? @unique @db.Uuid
  currentMaterialRecord PartnerApplicationMaterialRecord? @relation("CurrentApplicationMaterials", fields: [currentMaterialRecordId], references: [id], onDelete: Restrict)
  materialRecords PartnerApplicationMaterialRecord[] @relation("ApplicationMaterialHistory")
  materialUploads PartnerApplicationUpload[]
  submissions PartnerApplicationSubmission[]
  editSourceSubmissionId String? @db.Uuid
  editSourceSubmission PartnerApplicationSubmission? @relation("ApplicationEditSource", fields: [editSourceSubmissionId], references: [id], onDelete: Restrict)

  @@index([status, updatedAt])
}

model PartnerApplicationSubmission {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  applicationVersion Int
  sourceVersion Int
  institutionName String @db.VarChar(200)
  province String @db.VarChar(100)
  city String @db.VarChar(100)
  district String @db.VarChar(100)
  detailedAddress String @db.VarChar(300)
  contactPhone String @db.VarChar(30)
  regionCatalogVersion String @db.VarChar(100)
  bankRecordId String @db.Uuid
  materialRecordId String @db.Uuid
  submittedAt DateTime @default(now()) @db.Timestamptz(3)
  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  bankRecord PartnerApplicationBankRecord @relation(fields: [bankRecordId], references: [id], onDelete: Restrict)
  materialRecord PartnerApplicationMaterialRecord @relation(fields: [materialRecordId], references: [id], onDelete: Restrict)
  review PartnerApplicationReview?
  approval PartnerApplicationApproval?
  derivedDrafts PartnerApplication[] @relation("ApplicationEditSource")

  @@unique([applicationId, applicationVersion])
  @@unique([applicationId, sourceVersion])
}

model PartnerApplicationApproval {
  id String @id @default(uuid()) @db.Uuid
  submissionId String @unique @db.Uuid
  userId String @unique @db.Uuid
  campusId String @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  submission PartnerApplicationSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)
}

model PartnerApplicationReview {
  id String @id @default(uuid()) @db.Uuid
  submissionId String @unique @db.Uuid
  reviewerUserId String @db.Uuid
  decision PartnerApplicationStatus
  reason String @db.VarChar(1000)
  sourceVersion Int
  resultingVersion Int
  reviewedAt DateTime @default(now()) @db.Timestamptz(3)
  submission PartnerApplicationSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewer User @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([reviewerUserId, reviewedAt])
}

enum PartnerApplicationMaterialKind {
  BUSINESS_LICENSE
  INSTITUTION_LOGO
  LEGAL_ID_FRONT
  LEGAL_ID_BACK
  STORE_FRONT
  ENVIRONMENT
}

enum PartnerApplicationUploadState {
  RESERVED
  WRITING
  COMPLETED
}

model PartnerApplicationUpload {
  id String @id @default(uuid()) @db.Uuid
  storedFileId String @unique @db.Uuid
  applicationId String @db.Uuid
  ownerUserId String @db.Uuid
  requestKey String @db.Uuid
  expectedVersion Int
  kind PartnerApplicationMaterialKind
  state PartnerApplicationUploadState @default(RESERVED)
  runTag String @db.VarChar(100)
  storageKey String @unique @db.VarChar(255)
  keyId String? @db.VarChar(100)
  nonce String? @db.VarChar(24)
  authenticationTag String? @db.VarChar(32)
  inputDigest String? @db.VarChar(64)
  ciphertextDigest String? @db.VarChar(64)
  mimeType String? @db.VarChar(100)
  sizeBytes Int?
  width Int?
  height Int?
  adoptedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  fileCipher PartnerApplicationFileCipher?
  objects PartnerApplicationUploadObject[]

  @@unique([applicationId, requestKey])
  @@index([ownerUserId, adoptedAt])
}

model PartnerApplicationUploadObject {
  id String @id @default(uuid()) @db.Uuid
  uploadId String @db.Uuid
  storageKey String @unique @db.VarChar(255)
  attempt Int
  retainedAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  upload PartnerApplicationUpload @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@unique([uploadId, attempt])
}

model PartnerApplicationMaterialRecord {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  applicationVersion Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  application PartnerApplication @relation("ApplicationMaterialHistory", fields: [applicationId], references: [id], onDelete: Restrict)
  currentFor PartnerApplication? @relation("CurrentApplicationMaterials")
  items PartnerApplicationMaterialItem[]
  submissions PartnerApplicationSubmission[]

  @@unique([applicationId, applicationVersion])
}

model PartnerApplicationMaterialItem {
  id String @id @default(uuid()) @db.Uuid
  recordId String @db.Uuid
  storedFileId String @db.Uuid
  kind PartnerApplicationMaterialKind
  sortOrder Int
  record PartnerApplicationMaterialRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  file StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)

  @@unique([recordId, sortOrder])
  @@unique([recordId, storedFileId])
}

model PartnerApplicationFileCipher {
  storedFileId String @id @db.Uuid
  uploadId String @unique @db.Uuid
  keyId String @db.VarChar(100)
  nonce String @db.VarChar(24)
  authenticationTag String @db.VarChar(32)
  file StoredFile @relation(fields: [storedFileId], references: [id], onDelete: Restrict)
  upload PartnerApplicationUpload @relation(fields: [uploadId], references: [id], onDelete: Restrict)
}

model PartnerApplicationBankRecord {
  id                 String @id @default(uuid()) @db.Uuid
  applicationId      String @db.Uuid
  ownerUserId        String @db.Uuid
  applicationVersion Int
  keyId              String @db.VarChar(100)
  nonce              String @db.VarChar(24)
  authenticationTag  String @db.VarChar(32)
  ciphertext         String @db.Text
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  application        PartnerApplication @relation("ApplicationBankHistory", fields: [applicationId], references: [id], onDelete: Restrict)
  currentFor         PartnerApplication? @relation("CurrentApplicationBank")
  owner              User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  submissions PartnerApplicationSubmission[]

  @@unique([applicationId, applicationVersion])
  @@index([ownerUserId])
}

model PartnerApplicantSession {
  id          String           @id @default(uuid()) @db.Uuid
  applicantId String           @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime         @db.Timestamptz(3)
  revokedAt   DateTime?        @db.Timestamptz(3)
  applicant   PartnerApplicant @relation(fields: [applicantId], references: [id], onDelete: Restrict)

  @@index([applicantId, createdAt])
}

model StaffBindToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenDigest String    @unique @db.VarChar(64)
  tokenHash   String    @db.VarChar(255)
  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}

enum PartnerCampaignType {
  REGULAR_GROUP
  MULTI_SPEC_GROUP
  FLASH_SALE
  MULTI_SPEC_REGISTRATION_FEE
  FREE_REGISTRATION
}

model PartnerCampaignDraft {
  id                String               @id @default(uuid()) @db.Uuid
  campusId          String               @db.Uuid
  createdByUserId   String               @db.Uuid
  title             String?              @db.VarChar(40)
  campaignType      PartnerCampaignType?
  shareDescription  String?              @db.VarChar(1000)
  contactPhone      String?              @db.VarChar(30)
  activityContent   String?              @db.VarChar(10000)
  registrationForm  Json                 @default("[]") @db.JsonB
  coverImageId      String?              @db.Uuid
  shareImageId      String?              @db.Uuid
  coverImage        StoredFile?          @relation("PartnerDraftCover", fields: [coverImageId], references: [id], onDelete: Restrict)
  shareImage        StoredFile?          @relation("PartnerDraftShare", fields: [shareImageId], references: [id], onDelete: Restrict)
  freeStartsAt      DateTime?            @db.Timestamptz(3)
  freeEndsAt        DateTime?            @db.Timestamptz(3)
  freeCapacityMode  FreeCampaignCapacityMode?
  freeMaxRegistrations Int?
  version           Int                  @default(1)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)
  campus            Campus               @relation(fields: [campusId], references: [id], onDelete: Restrict)
  createdBy         User                 @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  campaign          Campaign?

  @@unique([id, campusId])
  @@index([campusId, updatedAt(sort: Desc), id(sort: Desc)])
}

enum FreeCampaignCapacityMode {
  UNLIMITED
  LIMITED
}

enum CampaignLifecycle {
  OPEN
  CLOSED
}

enum CampaignReviewStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum CampaignRegistrationStatus {
  REGISTERED
  CANCELLED
}

model Campaign {
  id String @id @default(uuid()) @db.Uuid
  draftId String @unique @db.Uuid
  campusId String @db.Uuid
  publishedVersionId String? @db.Uuid
  lifecycle CampaignLifecycle @default(OPEN)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)
  closedByUserId String? @db.Uuid
  closeReason String? @db.VarChar(1000)
  draft PartnerCampaignDraft @relation(fields: [draftId, campusId], references: [id, campusId], onDelete: Restrict)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Restrict)
  publishedVersion CampaignVersion? @relation("FreeCampaignPublication", fields: [publishedVersionId, id, campusId], references: [id, campaignId, campusId], onDelete: Restrict)
  closedBy User? @relation("FreeCampaignCloser", fields: [closedByUserId], references: [id], onDelete: Restrict)
  versions CampaignVersion[] @relation("FreeCampaignHistory")
  registrations CampaignRegistration[]

  @@unique([id, campusId])
  @@unique([draftId, campusId])
  @@index([campusId, createdAt(sort: Desc), id(sort: Desc)])
}

model CampaignVersion {
  id String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  campusId String @db.Uuid
  sequence Int
  sourceDraftVersion Int
  snapshotSchemaVersion Int @default(1)
  title String @db.VarChar(40)
  campaignType PartnerCampaignType @default(FREE_REGISTRATION)
  shareDescription String @db.VarChar(1000)
  contactPhone String? @db.VarChar(30)
  activityContent String? @db.VarChar(10000)
  coverImageId String? @db.Uuid
  shareImageId String? @db.Uuid
  coverImage StoredFile? @relation("CampaignVersionCover", fields: [coverImageId], references: [id], onDelete: Restrict)
  shareImage StoredFile? @relation("CampaignVersionShare", fields: [shareImageId], references: [id], onDelete: Restrict)
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  timezone String @db.VarChar(50)
  capacityMode FreeCampaignCapacityMode
  maxRegistrations Int?
  feeFen Int @default(0)
  benefitMode String @default("NONE") @db.VarChar(20)
  registrationLimit String @default("ONCE_PER_STUDENT") @db.VarChar(30)
  status CampaignReviewStatus @default(SUBMITTED)
  version Int @default(1)
  submittedAt DateTime @default(now()) @db.Timestamptz(3)
