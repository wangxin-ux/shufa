  @@unique([withdrawalId, earningEntryId])
  @@index([earningEntryId])
}

model StoredFile {
  hrTeacherRecordAttachment HrTeacherRecord?          @relation("HrTeacherRecordAttachment")
  financeCorrectionProposal FinanceReceiptCorrection? @relation("FinanceCorrectionProposedProof")
  financeRefundPayment      FinanceRefundPayment?
  financeReceipt            FinanceReceipt?
  id                        String                    @id @default(uuid()) @db.Uuid
  purpose                   StoredFilePurpose
  storageKey                String                    @unique @db.VarChar(255)
  originalName              String                    @db.VarChar(255)
  mimeType                  String                    @db.VarChar(100)
  sizeBytes                 Int
  sha256                    String                    @db.VarChar(64)
  createdByUserId           String                    @db.Uuid
  createdAt                 DateTime                  @default(now()) @db.Timestamptz(3)
  createdBy                 User                      @relation("StoredFileCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  withdrawals               Withdrawal[]
  courseProductCovers       CourseProduct[]           @relation("CourseProductCover")
  enrollmentPaymentProof    EnrollmentPaymentProof?
  studentFeedbackImage      StudentFeedbackImage?
  customerServiceCampuses   Campus[]                  @relation("CampusCustomerServiceQr")
  groupCampaignPoster       GroupCampaignPoster?

  @@index([createdByUserId, createdAt])
}

enum FinanceRefundStatus {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
  CANCEL_REQUESTED
  CANCELLED
  PAYING
  UNCERTAIN
  PAID
}

enum FinanceCorrectionType {
  VOID
  REPLACE
}

enum FinanceCorrectionStatus {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
  APPLIED
}

model FinanceReceiptCorrection {
  ledger               LessonLedgerEntry[]
  id                   String                          @id @default(uuid()) @db.Uuid
  originalIssuanceId   String                          @db.Uuid
  type                 FinanceCorrectionType
  status               FinanceCorrectionStatus         @default(SUBMITTED)
  reason               String                          @db.VarChar(500)
  version              Int                             @default(1)
  originalAmountFen    Int
  sourcePackageVersion Int
  replacementSnapshot  Json?
  proposedProofFileId  String?                         @unique @db.Uuid
  replacementReceiptId String?                         @unique @db.Uuid
  requestedByUserId    String                          @db.Uuid
  reviewedByUserId     String?                         @db.Uuid
  reviewedAt           DateTime?                       @db.Timestamptz(3)
  appliedByUserId      String?                         @db.Uuid
  appliedAt            DateTime?                       @db.Timestamptz(3)
  createdAt            DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                        @updatedAt @db.Timestamptz(3)
  originalIssuance     FinancePackageIssuance          @relation(fields: [originalIssuanceId], references: [id], onDelete: Restrict)
  proposedProof        StoredFile?                     @relation("FinanceCorrectionProposedProof", fields: [proposedProofFileId], references: [id], onDelete: Restrict)
  replacementReceipt   FinanceReceipt?                 @relation("FinanceCorrectionReplacementReceipt", fields: [replacementReceiptId], references: [id], onDelete: Restrict)
  requestedBy          User                            @relation("FinanceCorrectionRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy           User?                           @relation("FinanceCorrectionReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  appliedBy            User?                           @relation("FinanceCorrectionApplier", fields: [appliedByUserId], references: [id], onDelete: Restrict)
  events               FinanceReceiptCorrectionEvent[]

  @@index([originalIssuanceId, status])
  @@index([status, createdAt, id])
}

model FinanceReceiptCorrectionEvent {
  id           String                   @id @default(uuid()) @db.Uuid
  correctionId String                   @db.Uuid
  actorUserId  String                   @db.Uuid
  action       String                   @db.VarChar(20)
  fromStatus   FinanceCorrectionStatus?
  toStatus     FinanceCorrectionStatus
  version      Int
  reason       String                   @db.VarChar(500)
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  correction   FinanceReceiptCorrection @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  actor        User                     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([correctionId, version])
}

model FinanceRefundRequest {
  ledger             LessonLedgerEntry[]
  id                 String                 @id @default(uuid()) @db.Uuid
  issuanceId         String                 @db.Uuid
  mainUnits          Int
  giftUnits          Int
  referenceAmountFen Int
  amountFen          Int
  reason             String                 @db.VarChar(500)
  status             FinanceRefundStatus    @default(SUBMITTED)
  version            Int                    @default(1)
  requestedByUserId  String                 @db.Uuid
  reviewedByUserId   String?                @db.Uuid
  reviewedAt         DateTime?              @db.Timestamptz(3)
  paymentStartedAt   DateTime?              @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  issuance           FinancePackageIssuance @relation(fields: [issuanceId], references: [id], onDelete: Restrict)
  requestedBy        User                   @relation("FinanceRefundRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy         User?                  @relation("FinanceRefundReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  events             FinanceRefundEvent[]
  payment            FinanceRefundPayment?

  @@index([issuanceId, status])
  @@index([status, createdAt, id])
}

model FinanceRefundEvent {
  id          String               @id @default(uuid()) @db.Uuid
  refundId    String               @db.Uuid
  actorUserId String               @db.Uuid
  action      String               @db.VarChar(40)
  fromStatus  FinanceRefundStatus?
  toStatus    FinanceRefundStatus
  version     Int
  reason      String               @db.VarChar(500)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  refund      FinanceRefundRequest @relation(fields: [refundId], references: [id], onDelete: Restrict)
  actor       User                 @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([refundId, version])
}

model FinanceRefundPayment {
  id                String               @id @default(uuid()) @db.Uuid
  refundId          String               @unique @db.Uuid
  amountFen         Int
  paidAt            DateTime             @db.Timestamptz(3)
  proofFileId       String               @unique @db.Uuid
  externalReference String               @unique @db.VarChar(100)
  recordedByUserId  String               @db.Uuid
  recordedAt        DateTime             @default(now()) @db.Timestamptz(3)
  refund            FinanceRefundRequest @relation(fields: [refundId], references: [id], onDelete: Restrict)
  proof             StoredFile           @relation(fields: [proofFileId], references: [id], onDelete: Restrict)
  recordedBy        User                 @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
}
