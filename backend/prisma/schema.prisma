model ParentStudentBinding {
  id           String   @id @default(uuid()) @db.Uuid
  campusId     String   @db.Uuid
  parentUserId String   @db.Uuid
  studentId    String   @db.Uuid
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  campus       Campus   @relation(fields: [campusId], references: [id], onDelete: Restrict)
  parentUser   User     @relation("ParentStudentBindingUser", fields: [parentUserId], references: [id], onDelete: Restrict)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([parentUserId, studentId])
  @@index([parentUserId, isPrimary])
  @@index([campusId, studentId])
}

model ParentLeaveRequest {
  temporaryMemberId String?        @db.Uuid
  temporaryMember LessonTemporaryMember? @relation(fields: [temporaryMemberId, lessonSessionId, studentId, campusId], references: [id, lessonSessionId, studentId, campusId], onDelete: Restrict, onUpdate: Restrict, map: "ParentLeaveRequest_temporaryMember_fkey")
  id              String            @id @default(uuid()) @db.Uuid
  campusId        String            @db.Uuid
  parentUserId    String            @db.Uuid
  studentId       String            @db.Uuid
  lessonSessionId String            @db.Uuid
  reason          String            @db.VarChar(500)
  status          ParentLeaveStatus @default(PENDING)
  reviewerUserId  String?           @db.Uuid
  reviewedAt      DateTime?         @db.Timestamptz(3)
  reviewReason    String?           @db.VarChar(500)
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  campus          Campus            @relation(fields: [campusId], references: [id], onDelete: Restrict)
  parentUser      User              @relation("ParentLeaveRequestUser", fields: [parentUserId], references: [id], onDelete: Restrict)
  reviewer        User?             @relation("ParentLeaveRequestReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  lessonSession   LessonSession     @relation(fields: [lessonSessionId], references: [id], onDelete: Restrict)

  @@unique([parentUserId, studentId, lessonSessionId])
  @@index([parentUserId, createdAt])
  @@index([campusId, studentId, createdAt])
  @@index([lessonSessionId, studentId])
  @@index([reviewerUserId, reviewedAt])
}

model AttendanceRecord {
  id               String           @id @default(uuid()) @db.Uuid
  campusId         String           @db.Uuid
  lessonSessionId  String           @db.Uuid
  studentId        String           @db.Uuid
  status           AttendanceStatus
  // Legacy rows retain their historical meaning; new drafts explicitly set false.
  includedInFinalRoster Boolean     @default(true)
  recordedByUserId String           @db.Uuid
  recordedAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  campus           Campus           @relation(fields: [campusId], references: [id], onDelete: Restrict)
  lessonSession    LessonSession    @relation(fields: [lessonSessionId], references: [id], onDelete: Restrict)
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy       User             @relation("AttendanceRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@unique([lessonSessionId, studentId])
  @@index([campusId, studentId])
}

model TeachingRecord {
  id                  String               @id @default(uuid()) @db.Uuid
  campusId            String               @db.Uuid
  lessonSessionId     String               @unique @db.Uuid
  teacherId           String               @db.Uuid
  status              TeachingRecordStatus @default(COMPLETED)
  attendeeCount       Int
  lessonUnits         Int
  recordedByUserId    String               @db.Uuid
  completedAt         DateTime             @db.Timestamptz(3)
  reversedAt          DateTime?            @db.Timestamptz(3)
  reversalReason      String?              @db.VarChar(500)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  campus              Campus               @relation(fields: [campusId], references: [id], onDelete: Restrict)
  lessonSession       LessonSession        @relation(fields: [lessonSessionId], references: [id], onDelete: Restrict)
  teacher             TeacherProfile       @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  recordedBy          User                 @relation("TeachingRecordActor", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  earningBasis        TeacherEarningBasis?
  partnerEarningBasis PartnerEarningBasis?

  @@index([campusId, teacherId, completedAt])
}

model StudentFeedback {
  id              String                 @id @default(uuid()) @db.Uuid
  campusId        String                 @db.Uuid
  lessonSessionId String                 @db.Uuid
  studentId       String                 @db.Uuid
  teacherId       String                 @db.Uuid
  content         String                 @db.VarChar(1000)
  performanceRating Int?
  teacherRatings  Json?
  version         Int                    @default(1)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  campus          Campus                 @relation(fields: [campusId], references: [id], onDelete: Restrict)
  lessonSession   LessonSession          @relation(fields: [lessonSessionId], references: [id], onDelete: Restrict)
  student         Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher         TeacherProfile         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  images          StudentFeedbackImage[]
  revisions       StudentFeedbackRevision[]

  @@unique([lessonSessionId, studentId])
  @@unique([id, campusId, teacherId])
  @@index([campusId, teacherId, updatedAt])
}

model StudentFeedbackRevision {
  id         String          @id @default(uuid()) @db.Uuid
  feedbackId String          @db.Uuid
  campusId   String          @db.Uuid
  teacherId  String          @db.Uuid
  version    Int
  snapshot   Json
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  feedback   StudentFeedback @relation(fields: [feedbackId, campusId, teacherId], references: [id, campusId, teacherId], onDelete: Restrict, onUpdate: Restrict, map: "StudentFeedbackRevision_feedback_fkey")

  @@unique([feedbackId, version])
  @@index([campusId, teacherId, createdAt])
}

model StudentFeedbackImage {
  id           String          @id @default(uuid()) @db.Uuid
  feedbackId   String          @db.Uuid
  storedFileId String          @unique @db.Uuid
  sortOrder    Int
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  feedback     StudentFeedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict)
  storedFile   StoredFile      @relation(fields: [storedFileId], references: [id], onDelete: Restrict)

  @@unique([feedbackId, sortOrder])
  @@index([feedbackId])
}

model LessonLedgerEntry {
  subjectId           String?                   @db.Uuid
  subjectName         String?                   @db.VarChar(80)
  subject             CampusSubject?            @relation(fields: [subjectId, campusId], references: [id, campusId], onDelete: Restrict, onUpdate: Restrict)
  financeCorrectionId String?                   @db.Uuid
  financeCorrection   FinanceReceiptCorrection? @relation(fields: [financeCorrectionId], references: [id], onDelete: Restrict)
  financeRefundId     String?                   @db.Uuid
  financeRefund       FinanceRefundRequest?     @relation(fields: [financeRefundId], references: [id], onDelete: Restrict)
  id                  String                    @id @default(uuid()) @db.Uuid
  campusId            String                    @db.Uuid
  studentId           String                    @db.Uuid
  coursePackageId     String                    @db.Uuid
  lessonSessionId     String?                   @db.Uuid
  entryType           LessonLedgerEntryType
  bucket              LessonUnitBucket
  deltaUnits          Int
  balanceBeforeUnits  Int
  balanceAfterUnits   Int
  idempotencyKey      String                    @db.VarChar(128)
  reversalOfId        String?                   @unique @db.Uuid
  actorUserId         String                    @db.Uuid
  reason              String?                   @db.VarChar(500)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  campus              Campus                    @relation(fields: [campusId], references: [id], onDelete: Restrict)
  student             Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  coursePackage       CoursePackage             @relation(fields: [coursePackageId], references: [id], onDelete: Restrict)
  lessonSession       LessonSession?            @relation(fields: [lessonSessionId], references: [id], onDelete: Restrict)
  actor               User                      @relation("LessonLedgerActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  reversalOf          LessonLedgerEntry?        @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy          LessonLedgerEntry?        @relation("LedgerReversal")

  @@unique([idempotencyKey, studentId, coursePackageId, bucket])
  @@unique([financeCorrectionId, bucket])
  @@unique([financeRefundId, bucket])
  @@index([campusId, studentId, createdAt])
  @@index([lessonSessionId])
  @@index([campusId, subjectId, createdAt, id])
}

model CampusSubject {
  id         String              @id @default(uuid()) @db.Uuid
  campusId   String              @db.Uuid
  name       String              @db.VarChar(80)
  isActive   Boolean             @default(true)
  version    Int                 @default(1)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)
  campus     Campus              @relation(fields: [campusId], references: [id], onDelete: Restrict)
  classes    ClassGroup[]
  packages   CoursePackage[]
  ledger     LessonLedgerEntry[]

  @@unique([id, campusId])
  @@unique([campusId, name])
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  campusId       String?           @db.Uuid
  actorUserId    String?           @db.Uuid
  key            String            @db.VarChar(128)
  route          String            @db.VarChar(255)
  requestHash    String            @db.VarChar(128)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?
  responseBody   Json?
  expiresAt      DateTime          @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  campus         Campus?           @relation(fields: [campusId], references: [id], onDelete: Restrict)
  actor          User?             @relation("IdempotencyActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([key, route])
  @@index([campusId, expiresAt])
  @@index([actorUserId, createdAt])
}

model FinanceReceipt {
  id                       String                    @id @default(uuid()) @db.Uuid
  campusId                 String                    @db.Uuid
  studentId                String                    @db.Uuid
  amountFen                Int
  receivedOn               DateTime                  @db.Date
  channel                  String                    @db.VarChar(20)
  proofFileId              String                    @unique @db.Uuid
  note                     String                    @default("") @db.VarChar(500)
  createdByUserId          String                    @db.Uuid
  createdAt                DateTime                  @default(now()) @db.Timestamptz(3)
  campus                   Campus                    @relation(fields: [campusId], references: [id], onDelete: Restrict)
  student                  Student                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  proofFile                StoredFile                @relation(fields: [proofFileId], references: [id], onDelete: Restrict)
  createdBy                User                      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  issuance                 FinancePackageIssuance?
  replacementForCorrection FinanceReceiptCorrection? @relation("FinanceCorrectionReplacementReceipt")

  @@index([campusId, receivedOn, id])
  @@index([studentId, createdAt])
}

model FinancePackageIssuance {
  corrections       FinanceReceiptCorrection[]
  refunds           FinanceRefundRequest[]
  id                String                     @id @default(uuid()) @db.Uuid
  receiptId         String                     @unique @db.Uuid
  coursePackageId   String                     @unique @db.Uuid
  originalAmountFen Int
  initialMainUnits  Int
  initialGiftUnits  Int
  name              String                     @db.VarChar(200)
  validFrom         DateTime                   @db.Timestamptz(3)
  expiresAt         DateTime?                  @db.Timestamptz(3)
  issuedByUserId    String                     @db.Uuid
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  receipt           FinanceReceipt             @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  coursePackage     CoursePackage              @relation(fields: [coursePackageId], references: [id], onDelete: Restrict)
  issuedBy          User                       @relation(fields: [issuedByUserId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id           String       @id @default(uuid()) @db.Uuid
  campusId     String?      @db.Uuid
  actorUserId  String?      @db.Uuid
  action       String       @db.VarChar(100)
  resourceType String       @db.VarChar(100)
  resourceId   String?      @db.VarChar(100)
  outcome      AuditOutcome
  details      Json
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: Restrict)
  actor        User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([campusId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
}

model TeacherEarningRule {
  id                        String                  @id @default(uuid()) @db.Uuid
  campusId                  String                  @db.Uuid
  teacherProfileId          String?                 @db.Uuid
  scopeKey                  String                  @db.VarChar(100)
  basisType                 TeacherEarningBasisType
  unitAmountFen             Int
  eligibleLessonKinds       LessonKind[]
  countedAttendanceStatuses AttendanceStatus[]
  settlementDelayDays       Int                     @default(0)
  version                   Int
  status                    ConfigurationStatus     @default(DRAFT)
  effectiveFrom             DateTime                @db.Timestamptz(3)
  effectiveTo               DateTime?               @db.Timestamptz(3)
  createdByUserId           String                  @db.Uuid
  createdAt                 DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                @updatedAt @db.Timestamptz(3)
  campus                    Campus                  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  teacher                   TeacherProfile?         @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  createdBy                 User                    @relation("TeacherEarningRuleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  earningBases              TeacherEarningBasis[]

  @@unique([scopeKey, version])
  @@index([campusId, teacherProfileId, status, effectiveFrom])
}

model TeacherWithdrawalPolicy {
  id                String              @id @default(uuid()) @db.Uuid
  minimumAmountFen  Int
  dailyRequestLimit Int
  version           Int                 @unique
  status            ConfigurationStatus @default(DRAFT)
  effectiveFrom     DateTime            @db.Timestamptz(3)
  effectiveTo       DateTime?           @db.Timestamptz(3)
  createdByUserId   String              @db.Uuid
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  createdBy         User                @relation("TeacherWithdrawalPolicyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  withdrawals       Withdrawal[]

  @@index([status, effectiveFrom])
}

model TeacherEarningBasis {
  id                 String                    @id @default(uuid()) @db.Uuid
  campusId           String                    @db.Uuid
  teacherProfileId   String                    @db.Uuid
  teachingRecordId   String                    @db.Uuid
  lessonSessionId    String                    @db.Uuid
  selectedRuleId     String?                   @db.Uuid
  lessonKind         LessonKind
  lessonUnits        Int
  attendeeCount      Int
  attendanceSnapshot Json
  completedAt        DateTime                  @db.Timestamptz(3)
  status             TeacherEarningBasisStatus
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  campus             Campus                    @relation(fields: [campusId], references: [id], onDelete: Restrict)
  teacher            TeacherProfile            @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  teachingRecord     TeachingRecord            @relation(fields: [teachingRecordId], references: [id], onDelete: Restrict)
  lessonSession      LessonSession             @relation(fields: [lessonSessionId], references: [id], onDelete: Restrict)
  selectedRule       TeacherEarningRule?       @relation(fields: [selectedRuleId], references: [id], onDelete: Restrict)
  entries            TeacherEarningEntry[]

  @@unique([teachingRecordId])
  @@index([teacherProfileId, status, createdAt])
  @@index([campusId, status, createdAt])
  @@index([lessonSessionId])
}

model TeacherEarningEntry {
  id                    String                  @id @default(uuid()) @db.Uuid
  campusId              String                  @db.Uuid
  teacherProfileId      String                  @db.Uuid
  earningBasisId        String                  @db.Uuid
  entryType             TeacherEarningEntryType
  amountFen             Int
  status                TeacherEarningStatus
  ruleSnapshot          Json
  reviewableAt          DateTime                @db.Timestamptz(3)
  reviewedByUserId      String?                 @db.Uuid
  reviewedAt            DateTime?               @db.Timestamptz(3)
  reviewReason          String?                 @db.VarChar(500)
  reversalOfId          String?                 @db.Uuid
  version               Int                     @default(1)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  campus                Campus                  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  teacher               TeacherProfile          @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  earningBasis          TeacherEarningBasis     @relation(fields: [earningBasisId], references: [id], onDelete: Restrict)
  reviewedBy            User?                   @relation("TeacherEarningEntryReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  reversalOf            TeacherEarningEntry?    @relation("TeacherEarningReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy            TeacherEarningEntry?    @relation("TeacherEarningReversal")
  withdrawalAllocations WithdrawalAllocation[]

  @@unique([reversalOfId])
  @@index([teacherProfileId, status, createdAt])
  @@index([campusId, status, createdAt])
  @@index([earningBasisId, entryType])
}

model PartnerEarningRule {
  id                        String                @id @default(uuid()) @db.Uuid
  campusId                  String                @db.Uuid
  scopeKey                  String                @db.VarChar(100)
  unitPriceFen              Int
  shareBasisPoints          Int
  eligibleLessonKinds       LessonKind[]
  countedAttendanceStatuses AttendanceStatus[]
  settlementDelayDays       Int                   @default(0)
  version                   Int
  status                    ConfigurationStatus   @default(DRAFT)
  effectiveFrom             DateTime              @db.Timestamptz(3)
  effectiveTo               DateTime?             @db.Timestamptz(3)
  createdByUserId           String                @db.Uuid
  createdAt                 DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime              @updatedAt @db.Timestamptz(3)
  campus                    Campus                @relation(fields: [campusId], references: [id], onDelete: Restrict)
  createdBy                 User                  @relation("PartnerEarningRuleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  earningBases              PartnerEarningBasis[]

  @@unique([scopeKey, version])
  @@index([campusId, status, effectiveFrom])
}

model PartnerEarningBasis {
  id                   String                    @id @default(uuid()) @db.Uuid
  campusId             String                    @db.Uuid
  teachingRecordId     String                    @unique @db.Uuid
  lessonSessionId      String                    @db.Uuid
  selectedRuleId       String?                   @db.Uuid
  lessonKind           LessonKind
  lessonUnits          Int
  actualAttendeeCount  Int
  countedAttendeeCount Int
  attendanceSnapshot   Json
  completedAt          DateTime                  @db.Timestamptz(3)
  status               PartnerEarningBasisStatus
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)
