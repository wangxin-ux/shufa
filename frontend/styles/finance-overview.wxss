.finance-overview {
  color: var(--super-admin-ink);
  font-family: var(--super-admin-font-body);
  letter-spacing: 0;
}

.overview-filters {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.overview-dates {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
}

.overview-date-separator {
  font-size: 22rpx;
  color: var(--super-admin-muted);
}

.overview-tabs-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.overview-row-head,
.overview-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.overview-row-head {
  justify-content: flex-start;
  flex-wrap: wrap;
}

.overview-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  background: rgba(27, 35, 28, 0.42);
}

.overview-sheet {
  width: 100%;
  padding: 26rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 8rpx 8rpx 0 0;
  background: var(--super-admin-surface);
}

.overview-sheet__scroll {
  max-height: 68vh;
  margin-top: 20rpx;
}

.icon-button {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.78);
  font-size: 38rpx;
  color: var(--super-admin-ink);
}

.icon-button::after {
  border: 0;
}

.overview-note {
  display: block;
  margin: 8rpx 0 22rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--super-admin-muted);
}

@media (max-width: 380px) {
  .overview-filters {
    grid-template-columns: minmax(0, 1fr);
  }

  .overview-dates {
    grid-column: 1;
  }
}
