@import "../../styles/tokens.wxss";
.shell{position:relative;min-height:100vh;overflow:hidden;box-sizing:border-box;background:var(--super-admin-gradient);color:var(--super-admin-ink);font-family:var(--super-admin-font-body)}
.shell--surface{background:var(--super-admin-surface)}
.shell__wave{position:absolute;top:-292rpx;left:-12%;width:124%;height:480rpx;border-radius:0 0 52% 46%;background:#fff;box-shadow:0 7rpx 16rpx rgba(84,59,13,.16)}
.shell__header,.shell__body{position:relative;z-index:1}.shell__header-inner{display:flex;align-items:flex-start;gap:12rpx;min-height:150rpx!important;box-sizing:border-box;padding-left:24rpx}.shell__header-inner--surface{align-items:center;min-height:var(--super-admin-header-height)!important}
.shell__mark{display:flex;flex:none;flex-direction:column;align-items:center;justify-content:center;width:var(--role-page-mark-size);min-width:var(--role-page-mark-size);height:var(--role-page-mark-size);border-radius:50%;background:var(--role-page-mark-background);box-shadow:var(--role-page-mark-shadow)}.shell__mark-icon{width:var(--role-page-mark-icon-size);height:var(--role-page-mark-icon-size);pointer-events:none}.shell__mark-title{max-width:72rpx;margin-top:var(--role-page-mark-title-gap);font-family:var(--super-admin-font-body);font-size:var(--role-page-mark-title-font-size);font-weight:700;line-height:1.2;color:var(--role-page-mark-ink);text-align:center}.shell__mark--plain{width:var(--role-profile-mark-width);min-width:var(--role-profile-mark-width);height:var(--role-profile-mark-height);border-radius:0;background:transparent;box-shadow:none}.shell__mark-icon--plain{width:var(--role-profile-mark-icon-size);height:var(--role-profile-mark-icon-size)}.shell__mark--plain .shell__mark-title{font-size:var(--role-profile-mark-font-size)}
.shell__back{display:flex;align-items:center;justify-content:center;width:var(--role-back-size);height:var(--role-back-size);margin:2rpx 0 0;padding:0;border:0;border-radius:50%;background:var(--role-back-background);box-shadow:var(--role-back-shadow);line-height:1}.shell__back::after{border:0}.shell__back--hover{opacity:.72}.shell__back-icon{margin-top:var(--role-back-icon-offset-y);font-size:var(--role-back-icon-size);line-height:1;color:var(--parent-ink)}
.shell__body{box-sizing:border-box;padding:0 var(--super-admin-page-gap) 42rpx}
