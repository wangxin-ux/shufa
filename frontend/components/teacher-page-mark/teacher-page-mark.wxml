<view class="mark {{plain ? 'mark--plain' : ''}}" aria-role="img" aria-label="{{title}}">
  <image wx:if="{{icon}}" class="mark__icon" style="{{iconSize > 0 ? 'width:' + iconSize + 'rpx;height:' + iconSize + 'rpx;' : ''}}" src="{{icon}}" mode="aspectFit" />
  <text class="mark__title">{{title}}</text>
</view>
