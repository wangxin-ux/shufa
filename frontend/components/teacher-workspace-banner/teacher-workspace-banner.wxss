.workspace-banner {
  position: relative;
  min-height: 246rpx;
  overflow: hidden;
  box-sizing: border-box;
  border-radius: var(--teacher-card-radius);
  background: var(--teacher-orange);
  box-shadow: var(--teacher-shadow);
}

.workspace-banner__copy {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 62%;
  min-height: 246rpx;
  padding: 28rpx 0 28rpx 30rpx;
  box-sizing: border-box;
  color: #ffffff;
}

.workspace-banner__eyebrow {
  display: flex;
  align-items: center;
  max-width: 100%;
  font-size: 21rpx;
  font-weight: 700;
}

.workspace-banner__dot {
  flex: none;
  width: 15rpx;
  height: 15rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #23b574;
}

.workspace-banner__title {
  display: -webkit-box;
  max-width: 100%;
  margin-top: 13rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow-wrap: anywhere;
  font-family: var(--teacher-font-display);
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.1;
}

.workspace-banner--compact .workspace-banner__title {
  font-size: 40rpx;
}

.workspace-banner__detail {
  display: -webkit-box;
  max-width: 100%;
  margin-top: 17rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow-wrap: anywhere;
  font-size: 21rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.9);
}

.workspace-banner__mascot {
  position: absolute;
  right: 2rpx;
  bottom: -115rpx;
  z-index: 1;
  width: 238rpx;
  pointer-events: none;
}
