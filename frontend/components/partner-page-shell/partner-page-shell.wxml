<view class="shell {{surfacePage ? 'shell--surface' : ''}}">
  <view wx:if="{{!surfacePage && !plainGradient}}" class="shell__wave" aria-hidden="true"></view>
  <view class="shell__header {{fixedHeader ? 'shell__header--fixed' : ''}}" style="padding-top: {{headerTopPx}}px;">
    <view
      class="shell__header-inner {{surfacePage ? 'shell__header-inner--surface' : ''}}"
      style="--partner-header-height: {{headerHeightPx}}px; min-height: {{headerHeightPx}}px; padding-right: {{headerRightPx}}px;"
    >
      <view
        class="shell__leading {{fixedHeader ? 'shell__leading--fixed' : ''}}"
        style="top: {{headerTopPx}}px;"
      >
        <button
          wx:if="{{showBack}}"
          class="shell__back"
          aria-label="返回上一页"
          catchtap="onBackTap"
          hover-class="shell__back--hover"
        >
          <text class="shell__back-icon">‹</text>
        </button>
        <view class="shell__mark {{plainMark ? 'shell__mark--plain' : ''}}">
          <view class="shell__mark-disc shell__mark-disc--{{markIconHasDisc ? 'framed' : 'glyph'}} {{plainMark ? 'shell__mark-disc--plain' : ''}}">
            <image
              class="shell__mark-icon shell__mark-icon--{{markIconHasDisc ? 'framed' : 'glyph'}} {{plainMark ? 'shell__mark-icon--plain' : ''}}"
              src="{{markIcon}}"
              mode="aspectFit"
              style="transform: translateY({{markIconOffsetY}}rpx);"
              aria-hidden="true"
            />
          </view>
          <text class="shell__mark-title">{{markTitle}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="shell__body"><slot /></view>
</view>
