.view-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 80rpx 40rpx;
  min-height: 240rpx;
}

.view-state--panel {
  width: 100%;
  min-height: 340rpx;
  margin: 88rpx auto 0;
  padding: 48rpx 36rpx 44rpx;
  border: 2rpx solid rgba(118, 49, 19, 0.14);
  border-radius: 28rpx;
  background: rgba(255, 253, 241, 0.86);
  box-shadow: 0 12rpx 26rpx rgba(120, 64, 14, 0.12);
  backdrop-filter: blur(10rpx);
}

.view-state__status-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 76rpx;
  height: 76rpx;
  border: 2rpx solid rgba(160, 72, 22, 0.16);
  border-radius: 50%;
  background: rgba(255, 211, 80, 0.42);
  font-family: var(--parent-font-nav);
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1;
  color: #9d431b;
}

.view-state__spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 6rpx solid var(--parent-yellow-card);
  border-top-color: var(--parent-orange);
  animation: view-state-spin 0.8s linear infinite;
}

@keyframes view-state-spin {
  to {
    transform: rotate(360deg);
  }
}

.view-state__text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--parent-ink);
}

.view-state--panel.view-state--error .view-state__text {
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
  text-align: center;
  color: #3d261a;
}

.view-state__retry {
  margin-top: 24rpx;
  min-width: 176rpx;
  min-height: 88rpx;
  border-radius: 44rpx;
  background: var(--parent-orange);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 88rpx;
}

.view-state__retry--panel {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 38rpx;
  border: 0;
  background: linear-gradient(180deg, #ffad52 0%, var(--parent-orange) 100%);
  box-shadow: inset 0 3rpx 0 rgba(255, 255, 255, 0.34), 0 8rpx 16rpx rgba(224, 91, 18, 0.2);
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.view-state__retry--panel::after {
  border: 0;
}
