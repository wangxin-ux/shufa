@import "../../../styles/super-admin-workspace.wxss";

.map-editor {
  margin-top: 24rpx;
}

.qr-editor {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
}

.qr-editor__copy {
  align-self: stretch;
}

.qr-editor__title,
.qr-editor__hint {
  display: block;
}

.qr-editor__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--super-admin-ink);
}

.qr-editor__hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--super-admin-muted);
}

.qr-editor__preview {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 240rpx;
  height: 240rpx;
  margin-top: 24rpx;
  padding: 12rpx;
  overflow: hidden;
  border: 2rpx solid rgba(240, 125, 43, 0.2);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.76);
  box-shadow: 0 10rpx 22rpx rgba(82, 59, 32, 0.1);
}

.qr-editor__image {
  width: 100%;
  height: 100%;
}

.qr-editor__placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border: 2rpx dashed rgba(98, 79, 63, 0.24);
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--super-admin-muted);
}

.qr-editor__button {
  width: 240rpx;
  min-height: 72rpx;
  margin-top: 18rpx;
}

.map-editor__head,
.map-editor__switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.map-editor__head > view {
  flex: 1;
  min-width: 0;
}

.map-editor__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--super-admin-ink);
}

.map-editor__address {
  display: block;
  margin-top: 8rpx;
  overflow-wrap: anywhere;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--super-admin-muted);
}

.map-editor__choose {
  flex: none;
  min-height: 68rpx;
  padding: 0 18rpx;
}

.map-editor__switch {
  min-height: 76rpx;
  padding: 0 4rpx;
  border-top: 2rpx solid rgba(240, 125, 43, 0.16);
  font-size: 25rpx;
  font-weight: 700;
}

.map-editor__save {
  width: 100%;
  min-height: 80rpx;
}

@media (max-width: 380px) {
  .map-editor__head {
    align-items: stretch;
    flex-direction: column;
  }

  .map-editor__choose {
    width: 100%;
  }
}
