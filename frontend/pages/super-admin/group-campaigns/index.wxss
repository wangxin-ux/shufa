@import "../../../styles/super-admin-workspace.wxss";.head-button{flex:none;background:rgba(255,255,255,.9);color:var(--super-admin-ink)}.date-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.campaign-row{align-items:flex-start}.campaign-row .actions{margin-top:18rpx}.campaign-row .button{min-height:62rpx;padding:0 18rpx;font-size:22rpx}@media(max-width:380px){.workspace__head{align-items:flex-start}.head-button{max-width:180rpx}.date-grid{grid-template-columns:1fr}}

.campaign-row{display:block}.campaign-row__top{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.poster-manager{width:100%;margin-top:24rpx;padding-top:22rpx;border-top:2rpx solid rgba(52,88,73,.12)}.poster-manager__head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.poster-manager__title,.poster-manager__hint{display:block}.poster-manager__title{font-size:25rpx;font-weight:700;color:var(--super-admin-ink)}.poster-manager__hint{margin-top:4rpx;font-size:19rpx;color:rgba(31,56,46,.56)}button.poster-upload{display:flex;align-items:center;justify-content:center;flex:none;min-height:58rpx;margin:0;padding:0 20rpx;border:0;border-radius:24rpx;background:#f4b942;font-size:21rpx;font-weight:700;line-height:1;color:#263b33}button.poster-upload::after,.poster-item__actions button::after{border:0}.poster-list{width:100%;margin-top:18rpx;white-space:nowrap}.poster-item{display:inline-flex;flex-direction:column;vertical-align:top;width:176rpx;margin-right:14rpx;padding:10rpx;box-sizing:border-box;border-radius:8rpx;background:rgba(255,255,255,.62)}.poster-item__image{display:block;width:156rpx;height:214rpx;border-radius:6rpx;background:rgba(255,255,255,.56)}.poster-item__index{margin-top:8rpx;font-size:19rpx;text-align:center;color:rgba(31,56,46,.68)}.poster-item__actions{display:grid;grid-template-columns:1fr 1fr;gap:6rpx;margin-top:8rpx}.poster-item__actions button{display:flex;align-items:center;justify-content:center;min-width:0;min-height:46rpx;margin:0;padding:0 4rpx;border:0;border-radius:6rpx;background:rgba(39,93,72,.12);font-size:18rpx;line-height:1;color:#274f3f}.poster-item__actions button:last-child{grid-column:1/-1;color:#a24732}.poster-item__actions button[disabled]{opacity:.35}.poster-manager__empty{display:block;margin-top:16rpx;font-size:20rpx;color:rgba(31,56,46,.52)}
