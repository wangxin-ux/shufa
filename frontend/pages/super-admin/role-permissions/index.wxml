<super-admin-page-shell show-back mark-title="权限" mark-icon="/pages/super-admin/assets/icon-brand.png"><view class="workspace"><view class="workspace__head"><view><text class="workspace__title">角色权限</text><text class="workspace__subtitle">后端生效的六角色权限矩阵</text></view></view><view wx:if="{{viewState === 'loading'}}" class="state"><text class="state__title">正在加载权限</text></view><view wx:elif="{{viewState === 'error' || viewState === 'forbidden'}}" class="state"><text class="state__title">无法查看权限</text><text class="state__message">{{errorMessage}}</text><button class="button" bindtap="onRetry">重试</button></view><view wx:else class="list"><view class="row role-row" wx:for="{{roles}}" wx:key="roleCode"><view class="row__main"><text class="row__title">{{item.roleLabel}}</text><text class="row__meta" wx:if="{{item.permissionLabels.length === 0}}">当前未开放客户端业务权限</text><view class="permission-list"><text class="status" wx:for="{{item.permissionLabels}}" wx:key="*this">{{item}}</text></view></view><text class="row__value">{{item.permissions.length}}项</text></view></view></view></super-admin-page-shell>
