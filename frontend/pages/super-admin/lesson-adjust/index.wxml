<super-admin-page-shell show-back mark-title="调整" mark-icon="/pages/super-admin/assets/icon-ledger.png">
  <view class="workspace"><view class="workspace__head"><view><text class="workspace__title">后台课时调整</text><text class="workspace__subtitle">{{studentName || '指定课包'}} · 只追加调整流水</text></view></view>
    <view wx:if="{{viewState === 'success'}}" class="state"><text class="state__title">{{resultLabel}}</text><text class="state__message">原流水未删除，操作已写入审计日志</text><button class="button" bindtap="onBackToLedger">返回课时账本</button></view>
    <view wx:else class="form"><view><text class="form__label">课时类型</text><picker range="{{['主课时','赠送课时']}}" value="{{bucket === 'GIFT' ? 1 : 0}}" bindchange="onBucketChange"><view class="select">{{bucket === 'GIFT' ? '赠送课时' : '主课时'}}</view></picker></view><view><text class="form__label">调整课时</text><input class="field" type="digit" value="{{deltaLessons}}" bindinput="onDeltaInput" placeholder="增加填正数，减少填负数"/></view><view><text class="form__label">调整原因</text><textarea class="textarea" maxlength="500" value="{{reason}}" bindinput="onReasonInput" placeholder="必须填写可审计原因"/></view><view class="notice">系统会锁定课包并检查余额；调整后不能为负。重复提交由幂等标识保护。</view><text wx:if="{{viewState === 'error'}}" class="state__message">{{errorMessage}}</text><button class="button" disabled="{{submitting}}" bindtap="onSubmit">{{submitting ? '提交中' : '确认调整'}}</button></view>
  </view>
</super-admin-page-shell>
