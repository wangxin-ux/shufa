<super-admin-page-shell show-back mark-title="日志" mark-icon="/pages/super-admin/assets/icon-dashboard.png"><view class="workspace"><view class="workspace__head"><view><text class="workspace__title">操作日志</text><text class="workspace__subtitle">全局审计记录，不展示敏感密钥</text></view></view><view class="toolbar"><input class="field" value="{{keyword}}" bindinput="onKeywordInput" placeholder="按操作类型筛选"/><button class="button" bindtap="onSearch">查询</button></view><view wx:if="{{viewState === 'loading'}}" class="state"><text class="state__title">正在加载日志</text></view><view wx:elif="{{viewState === 'empty'}}" class="state"><text class="state__title">暂无日志</text></view><view wx:elif="{{viewState === 'error' || viewState === 'forbidden'}}" class="state"><text class="state__title">无法查看日志</text><text class="state__message">{{errorMessage}}</text><button class="button" bindtap="onRetry">重试</button></view><view wx:else class="list"><view class="row" wx:for="{{logs}}" wx:key="id"><view class="row__main"><text class="row__title">{{item.actionLabel}}</text><text class="row__meta">{{item.actorName}} · {{item.campusName}} · {{item.timeLabel}}</text></view><text class="status {{item.outcome === 'SUCCESS' ? 'status--success' : 'status--danger'}}">{{item.outcomeLabel}}</text></view></view></view></super-admin-page-shell>
