@import "../../../styles/tokens.wxss";
.home{position:relative;min-height:calc(100vh - 150rpx)}.home__head{display:flex;align-items:center;gap:18rpx;min-height:96rpx;padding-top:38rpx}.home__title{font-family:var(--super-admin-font-display);font-size:62rpx;font-weight:700;line-height:1.08;color:#fff}.home__more,.home__footer-more,.page-state__retry{display:flex;align-items:center;justify-content:center;min-height:var(--role-home-more-height);margin:0;padding:0 var(--role-home-more-padding-x);border:var(--role-home-more-border);border-radius:999rpx;background:transparent;font-size:var(--role-home-more-font-size);line-height:var(--role-home-more-height);color:#fff}.home__more::after,.home__footer-more::after,.page-state__retry::after,.campus::after,.home__identity::after,.quick-action::after{border:0}.campus{display:grid;grid-template-columns:210rpx 4rpx minmax(0,1fr);align-items:center;width:100%;min-height:250rpx;margin:10rpx 0 0;padding:0;border:0;background:transparent;color:#fff;text-align:left}.campus__count,.campus__detail{display:flex;flex-direction:column;min-width:0}.campus__count{align-items:center}.campus__value{font-family:var(--super-admin-font-display);font-size:126rpx;font-weight:700;line-height:.9;color:var(--super-admin-danger)}.campus__unit{margin-top:24rpx;font-family:var(--super-admin-font-display);font-size:34rpx;font-weight:700;color:var(--super-admin-danger)}.campus__divider{width:4rpx;height:132rpx;background:rgba(255,255,255,.96)}.campus__detail{padding-left:34rpx}.campus__name{font-family:var(--super-admin-font-display);font-size:48rpx;font-weight:700;line-height:1.15;color:#fff;overflow-wrap:anywhere}.campus__summary{margin-top:12rpx;font-size:24rpx;line-height:1.45;color:rgba(255,255,255,.9)}.home__stage{position:relative;height:800rpx;margin:-74rpx -32rpx 0;overflow:visible}.home__character{position:absolute;top:-10rpx;left:95rpx;width:655rpx;pointer-events:none}.home__identity{position:absolute;right:48rpx;bottom:232rpx;left:48rpx;z-index:3;display:flex;flex-direction:column;align-items:flex-start;margin:0;padding:8rpx 0;border:0;background:transparent;color:var(--super-admin-ink);text-align:left}.home__administrator{font-family:var(--super-admin-font-display);font-size:43rpx;font-weight:700}.home__role{margin-top:5rpx;font-size:22rpx;color:var(--super-admin-muted)}.home__stats{position:absolute;right:var(--role-home-glass-right);bottom:68rpx;left:var(--role-home-glass-left);z-index:2}.home__footer{position:relative;z-index:3;display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;min-height:166rpx;margin-top:-32rpx;padding:0 16rpx}.quick-actions{position:relative;flex:none;display:flex;align-items:flex-start;width:var(--role-home-nav-width);height:var(--role-home-nav-active-size);overflow:visible;background:transparent}.quick-actions::before{position:absolute;top:17rpx;left:0;width:var(--role-home-nav-capsule-width);height:var(--role-home-nav-capsule-height);border-radius:999rpx;background:var(--role-home-nav-background);box-shadow:var(--role-home-nav-shadow);content:'';pointer-events:none}.quick-action{position:relative;z-index:1;flex:none;display:flex;flex-direction:column;align-items:center;justify-content:center;width:var(--role-home-nav-item-width);min-width:var(--role-home-nav-item-width);min-height:var(--super-admin-touch-min);margin:23rpx 0 0;padding:4rpx;box-sizing:border-box;border:0;border-radius:0;background:transparent;line-height:1.2}.quick-action:first-child{margin-left:4rpx}.quick-action--active{width:var(--role-home-nav-active-size);min-width:var(--role-home-nav-active-size);height:var(--role-home-nav-active-size);min-height:var(--role-home-nav-active-size);margin:0 0 0 -13rpx;border-radius:50%;background:var(--role-home-nav-active-background);box-shadow:var(--role-home-nav-active-shadow)}.quick-action__icon{width:38rpx;height:38rpx;pointer-events:none}.quick-action__label{max-width:100%;margin-top:4rpx;overflow:hidden;font-size:16rpx;color:var(--role-home-nav-ink);text-align:center;text-overflow:ellipsis;white-space:nowrap}.quick-action--active .quick-action__icon{width:54rpx;height:56rpx}.quick-action--active .quick-action__label{font-size:16rpx;font-weight:600;color:var(--role-home-nav-ink)}.home__footer-more{flex:none;align-self:flex-start}.page-state{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;min-height:600rpx;padding:70rpx 18rpx}.page-state__title{font-family:var(--super-admin-font-display);font-size:48rpx;font-weight:700;color:#fff}.page-state__message{margin-top:18rpx;font-size:26rpx;color:rgba(255,255,255,.84)}.page-state__retry{margin-top:28rpx}.button--hover,.quick-action:active{opacity:.74}
.home__identity{bottom:218rpx}
