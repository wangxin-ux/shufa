<super-admin-page-shell mark-title="首页" mark-icon="/pages/super-admin/assets/home-mark-glyph.png">
  <view class="home home--{{viewState}}">
    <view wx:if="{{viewState === 'loading'}}" class="page-state"><text class="page-state__title">正在加载全局数据</text></view>
    <view wx:elif="{{viewState === 'forbidden'}}" class="page-state"><text class="page-state__title">无访问权限</text><text class="page-state__message">{{errorMessage}}</text></view>
    <view wx:elif="{{viewState === 'error'}}" class="page-state"><text class="page-state__title">总端数据加载失败</text><text class="page-state__message">{{errorMessage}}</text><button class="page-state__retry" bindtap="onRetry">重试</button></view>
    <view wx:elif="{{viewState === 'ready' || viewState === 'empty'}}" class="home__content home__content--{{viewState}}">
      <view class="home__head"><text class="home__title">校区概览</text><button class="home__more" data-key="more" bindtap="onActionTap">查看更多</button></view>
      <button class="campus" data-key="campuses" bindtap="onActionTap" hover-class="button--hover">
        <view class="campus__count"><text class="campus__value">{{campusCount}}</text><text class="campus__unit">所校区</text></view>
        <view class="campus__divider"></view>
        <view class="campus__detail"><text class="campus__name">{{featuredCampusName}}</text><text class="campus__summary">{{featuredSummary}}</text></view>
      </button>
      <view class="home__stage">
        <image class="home__character" src="/pages/super-admin/assets/home-character.png" mode="widthFix" aria-hidden="true" />
        <button class="home__identity" data-key="profile" bindtap="onActionTap"><text class="home__administrator">{{administratorName}}</text></button>
        <super-admin-stat-strip class="home__stats" items="{{stats}}" />
      </view>
      <view class="home__footer">
        <view class="quick-actions">
          <button wx:for="{{actions}}" wx:key="key" class="quick-action {{item.key === 'dashboard' ? 'quick-action--active' : ''}}" data-key="{{item.key}}" bindtap="onActionTap"><image class="quick-action__icon" src="{{item.icon}}" mode="aspectFit" /><text class="quick-action__label">{{item.label}}</text></button>
        </view>
        <button class="home__footer-more" data-key="more" bindtap="onActionTap">查看更多</button>
      </view>
    </view>
  </view>
</super-admin-page-shell>
