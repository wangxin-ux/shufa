<super-admin-page-shell show-back mark-title="提现" mark-icon="/pages/super-admin/assets/icon-dashboard.png"><view class="workspace"><view class="workspace__head"><view><text class="workspace__title">人工提现处理</text><text class="workspace__subtitle">审核与打款均保留状态和凭证</text></view></view><view class="form"><textarea class="textarea" value="{{reason}}" bindinput="onReasonInput" placeholder="驳回或打款失败时填写原因"/><input class="field" value="{{payoutReference}}" bindinput="onReferenceInput" placeholder="人工打款流水号"/><button class="button button--ghost" bindtap="onChooseProof">{{proofName || '上传打款凭证（JPG/PNG/PDF）'}}</button></view><view class="notice">系统不自动转账；“完成”仅登记已经发生的线下人工打款。</view><view wx:if="{{viewState === 'loading'}}" class="state"><text class="state__title">正在加载提现申请</text></view><view wx:elif="{{viewState === 'empty'}}" class="state"><text class="state__title">暂无提现申请</text></view><view wx:elif="{{viewState === 'error' || viewState === 'forbidden'}}" class="state"><text class="state__title">加载失败</text><text class="state__message">{{errorMessage}}</text><button class="button" bindtap="onRetry">重试</button></view><view wx:else class="list"><view class="row" wx:for="{{withdrawals}}" wx:key="id"><view class="row__main"><text class="row__title">{{item.teacherName}} · {{item.amountLabel}}</text><text class="row__meta">{{item.requestNo}} · {{item.timeLabel}}</text><text wx:if="{{item.rejectionReason || item.failureReason}}" class="row__meta">{{item.rejectionReason || item.failureReason}}</text><view class="actions"><button wx:if="{{item.status === 'SUBMITTED'}}" class="button" data-id="{{item.id}}" data-version="{{item.version}}" data-action="approve" bindtap="onAction">批准</button><button wx:if="{{item.status === 'SUBMITTED'}}" class="button button--danger" data-id="{{item.id}}" data-version="{{item.version}}" data-action="reject" bindtap="onAction">驳回</button><button wx:if="{{item.status === 'APPROVED'}}" class="button" data-id="{{item.id}}" data-version="{{item.version}}" data-action="mark-paying" bindtap="onAction">开始打款</button><button wx:if="{{item.status === 'PAYING'}}" class="button" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="onMarkPaid">凭证完成</button><button wx:if="{{item.status === 'PAYING'}}" class="button button--danger" data-id="{{item.id}}" data-version="{{item.version}}" data-action="mark-failed" bindtap="onAction">打款失败</button></view></view><text class="status {{item.status === 'PAID' ? 'status--success' : item.status === 'REJECTED' || item.status === 'FAILED' ? 'status--danger' : ''}}">{{item.statusLabel}}</text></view></view></view></super-admin-page-shell>
