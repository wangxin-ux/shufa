@import "../../../styles/super-admin-workspace.wxss";
.review { padding-bottom: 80rpx; }
.review__title { display: block; margin: 18rpx 0 28rpx; font-size: 36rpx; font-weight: 700; }
.review__search { flex: 1; min-width: 0; }
.toolbar picker { flex: none; max-width: 170rpx; }
.toolbar .button { flex: none; margin: 0; padding: 0 18rpx; }
.review__message { display: block; padding: 16rpx 0; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.review__row { display: block; width: 100%; margin: 12rpx 0; padding: 22rpx; border-radius: 8rpx; background: rgba(255,255,255,0.88); text-align: left; }
.review__row text, .review__facts text { display: block; font-size: 24rpx; line-height: 1.65; overflow-wrap: anywhere; }
.review__row .review__name, .review__facts .review__name { font-size: 30rpx; font-weight: 700; }
.review__facts { padding: 20rpx 0; border-bottom: 1rpx solid rgba(0,0,0,0.15); }
.review__section { padding: 22rpx 0; }
.review__label { display: block; margin-bottom: 14rpx; font-size: 26rpx; font-weight: 700; }
.review__file, .review__back { margin: 8rpx 0; padding: 12rpx 18rpx; border-radius: 6rpx; font-size: 24rpx; text-align: left; background: rgba(255,255,255,0.7); }
.review__reject { margin-top: 18rpx; background: #a52720; }
