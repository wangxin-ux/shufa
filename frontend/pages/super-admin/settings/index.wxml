<super-admin-page-shell show-back mark-title="设置" mark-icon="/pages/super-admin/assets/icon-brand.png"><view class="workspace"><view class="workspace__head"><view><text class="workspace__title">全局设置</text><text class="workspace__subtitle">只读展示当前第一阶段边界，不显示密钥</text></view></view><view wx:if="{{viewState === 'loading'}}" class="state"><text class="state__title">正在读取设置</text></view><view wx:elif="{{viewState === 'error' || viewState === 'forbidden'}}" class="state"><text class="state__title">无法读取设置</text><text class="state__message">{{errorMessage}}</text><button class="button" bindtap="onRetry">重试</button></view><view wx:else class="list"><view class="row"><view class="row__main"><text class="row__title">报表时区</text></view><text class="row__value">中国标准时间</text></view><view class="row"><view class="row__main"><text class="row__title">支付模式</text></view><text class="row__value">{{settings.paymentMode}}</text></view><view class="row"><view class="row__main"><text class="row__title">提现模式</text></view><text class="row__value">{{settings.payoutMode}}</text></view><view class="row"><view class="row__main"><text class="row__title">文件存储</text></view><text class="row__value">{{settings.fileStorageMode}}</text></view><view class="row"><view class="row__main"><text class="row__title">真实支付</text><text class="row__meta">未取得甲方正式参数前保持关闭</text></view><text class="status status--danger">关闭</text></view><view class="row"><view class="row__main"><text class="row__title">自动提现与自动分账</text><text class="row__meta">第一阶段禁止开启</text></view><text class="status status--danger">关闭</text></view></view></view></super-admin-page-shell>
