<super-admin-page-shell show-back mark-title="策略" mark-icon="/pages/super-admin/assets/icon-dashboard.png"><view class="workspace"><view class="workspace__head"><view><text class="workspace__title">提现策略</text><text class="workspace__subtitle">版本化最低金额与申请频率</text></view></view><view class="form"><view><text class="form__label">最低提现金额（元）</text><input class="field" type="digit" value="{{minimumYuan}}" bindinput="onMinimumInput"/></view><view><text class="form__label">每日申请次数</text><input class="field" type="number" value="{{dailyLimit}}" bindinput="onLimitInput"/></view><button class="button" disabled="{{submitting}}" bindtap="onCreate">创建策略草稿</button></view><view class="notice">提现仍为申请、审核、人工打款、上传凭证、完成，不接自动转账。</view><view wx:if="{{viewState === 'loading'}}" class="state"><text class="state__title">正在加载策略</text></view><view wx:elif="{{viewState === 'error'}}" class="state"><text class="state__title">加载失败</text><text class="state__message">{{errorMessage}}</text><button class="button" bindtap="onRetry">重试</button></view><view wx:else class="list"><view class="row" wx:for="{{policies}}" wx:key="id"><view class="row__main"><text class="row__title">最低{{item.amountLabel}}</text><text class="row__meta">每日{{item.dailyRequestLimit}}次 · 版本{{item.version}}</text><view class="actions"><button wx:if="{{item.status === 'DRAFT'}}" class="button" data-id="{{item.id}}" data-version="{{item.version}}" data-action="activate" bindtap="onTransition">启用</button><button wx:if="{{item.status === 'ACTIVE'}}" class="button button--ghost" data-id="{{item.id}}" data-version="{{item.version}}" data-action="retire" bindtap="onTransition">退役</button></view></view><text class="status">{{item.statusLabel}}</text></view></view></view></super-admin-page-shell>
