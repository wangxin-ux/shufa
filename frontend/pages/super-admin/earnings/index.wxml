<super-admin-page-shell show-back mark-title="收益" mark-icon="/pages/super-admin/assets/icon-dashboard.png"><view class="workspace"><view class="workspace__head"><view><text class="workspace__title">教师收益审核</text><text class="workspace__subtitle">内部预计课时费，不代表法定工资</text></view></view><textarea class="textarea" value="{{reason}}" bindinput="onReasonInput" placeholder="驳回时必须填写原因"/>
<view wx:if="{{viewState === 'loading'}}" class="state"><text class="state__title">正在加载收益</text></view><view wx:elif="{{viewState === 'empty'}}" class="state"><text class="state__title">暂无收益记录</text></view><view wx:elif="{{viewState === 'error' || viewState === 'forbidden'}}" class="state"><text class="state__title">加载失败</text><text class="state__message">{{errorMessage}}</text><button class="button" bindtap="onRetry">重试</button></view><view wx:else class="list"><view class="row" wx:for="{{entries}}" wx:key="id"><view class="row__main"><text class="row__title">{{item.teacherName}} · {{item.amountLabel}}</text><text class="row__meta">{{item.timeLabel}} · {{item.statusLabel}}</text><text wx:if="{{item.reviewReason}}" class="row__meta">原因：{{item.reviewReason}}</text><view wx:if="{{item.status === 'PENDING_REVIEW'}}" class="actions"><button class="button" disabled="{{submittingId === item.id}}" data-id="{{item.id}}" data-version="{{item.version}}" data-action="approve" bindtap="onReview">通过</button><button class="button button--danger" disabled="{{submittingId === item.id}}" data-id="{{item.id}}" data-version="{{item.version}}" data-action="reject" bindtap="onReview">驳回</button></view></view><text class="status {{item.status === 'AVAILABLE' ? 'status--success' : item.status === 'REJECTED' ? 'status--danger' : ''}}">{{item.statusLabel}}</text></view></view></view></super-admin-page-shell>
