<super-admin-page-shell show-back mark-title="订单" mark-icon="/pages/super-admin/assets/icon-ledger.png"><view class="workspace"><view class="workspace__head"><view><text class="workspace__title">拼团订单</text><text class="workspace__subtitle">支付、成团、课包发放与退款状态</text></view></view>
  <view class="toolbar filters"><view class="filter-item"><text class="filter-label">校区筛选</text><picker range="{{campuses}}" range-key="name" value="{{campusIndex}}" bindchange="onCampusChange"><view class="select">{{campuses[campusIndex].name}}</view></picker></view><view class="filter-item"><text class="filter-label">状态筛选</text><picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange"><view class="select">{{statusOptions[statusIndex].label}}</view></picker></view></view>
  <view class="form refund-form"><text class="form__label">退款原因</text><input class="field" value="{{refundReason}}" maxlength="500" bindinput="onReasonInput" /></view>
  <view wx:if="{{viewState === 'loading'}}" class="state"><text class="state__title">正在加载拼团订单</text></view><view wx:elif="{{viewState === 'empty'}}" class="state"><text class="state__title">暂无拼团订单</text><text class="state__message">可切换校区或状态筛选</text></view><view wx:elif="{{viewState === 'error' || viewState === 'forbidden'}}" class="state"><text class="state__title">{{viewState === 'forbidden' ? '无访问权限' : '加载失败'}}</text><text class="state__message">{{errorMessage}}</text><button class="button" bindtap="onRetry">重试</button></view>
  <view wx:else class="list"><view class="row order-row" wx:for="{{orders}}" wx:key="id"><view class="row__main"><view class="order-row__head"><text class="row__title">{{item.studentName}} · {{item.campaignTitle}}</text><text class="status {{item.memberStatus === 'SETTLED' ? 'status--success' : item.memberStatus === 'REFUNDED' ? 'status--danger' : ''}}">{{item.memberStatusLabel}}</text></view><text class="row__meta">{{item.campusName}} · 订单 {{item.orderNo}}</text><view class="facts"><text>支付状态：{{item.paymentStatusLabel}}</text><text>拼团人数：{{item.paidMemberCount}} / 3</text><text>课包权益：{{item.packageLabel}}</text><text>金额：{{item.priceLabel}}</text></view><text class="row__meta">创建时间 {{item.createdAtLabel}}</text><button wx:if="{{item.canRefund}}" class="button button--danger refund-button" disabled="{{submittingId === item.id}}" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="onRefund">退款</button></view></view><button wx:if="{{hasMore}}" class="button load-more" loading="{{loadingMore}}" bindtap="onLoadMore">加载更多</button></view>
</view></super-admin-page-shell>
