@import "../../../styles/tokens.wxss";

.lesson-account {
  position: relative;
  min-height: calc(100vh - 120rpx);
  padding: 24rpx 0 120rpx;
  box-sizing: border-box;
}

.lesson-account::before {
  position: absolute;
  top: 490rpx;
  right: -180rpx;
  bottom: -120rpx;
  left: -180rpx;
  z-index: 0;
  border-radius: 50% 50% 0 0 / 80rpx 80rpx 0 0;
  background: #ffffff;
  content: '';
}

.lesson-account__title {
  position: relative;
  z-index: 2;
  display: block;
  margin: 0 0 36rpx 14rpx;
  font-family: var(--super-admin-font-display);
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.08;
  color: #fe8419;
}

.lesson-account__hero {
  position: relative;
  z-index: 2;
  width: 653rpx;
  min-height: 320rpx;
  margin-left: 14rpx;
  padding: 44rpx 42% 30rpx 38rpx;
  box-sizing: border-box;
  overflow: visible;
  border-radius: 32rpx;
  background: #fe8419;
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.lesson-account__hero-copy {
  position: relative;
  z-index: 2;
}

.lesson-account__hero-label,
.lesson-account__hero-meta {
  display: block;
  color: #ffffff;
}

.lesson-account__hero-label {
  font-size: 24rpx;
  line-height: 1.2;
}

.lesson-account__hero-number {
  display: flex;
  margin-top: 14rpx;
  align-items: flex-end;
  color: #111111;
}

.lesson-account__hero-count {
  max-width: 250rpx;
  overflow: hidden;
  font-family: var(--super-admin-font-display);
  font-size: 112rpx;
  font-weight: 700;
  line-height: 0.95;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-account__hero-unit {
  margin: 0 0 8rpx 6rpx;
  font-family: var(--super-admin-font-display);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.lesson-account__hero-meta {
  width: 300rpx;
  margin-top: 24rpx;
  font-size: 20rpx;
  line-height: 1.45;
}

.lesson-account__hero-character {
  position: absolute;
  right: -18rpx;
  bottom: -2rpx;
  z-index: 1;
  width: 400rpx;
  pointer-events: none;
}

.lesson-account__bucket-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 92rpx;
  width: 653rpx;
  margin: 44rpx 0 0 14rpx;
}

.lesson-account__bucket-card {
  min-width: 0;
  min-height: 190rpx;
  padding: 22rpx 28rpx 18rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #ffd75e;
  box-shadow: 0 12rpx 22rpx rgba(24, 18, 14, 0.18);
}

.lesson-account__bucket-label,
.lesson-account__bucket-meta {
  display: block;
}

.lesson-account__bucket-label {
  overflow: hidden;
  font-size: 21rpx;
  color: var(--super-admin-ink);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-account__bucket-number {
  display: flex;
  min-width: 0;
  margin-top: 8rpx;
  align-items: flex-end;
  font-family: var(--super-admin-font-display);
  font-size: 76rpx;
  font-weight: 700;
  line-height: 0.95;
  color: #111111;
}

.lesson-account__bucket-number > text:first-child {
  max-width: 145rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-account__bucket-unit {
  margin: 0 0 5rpx 5rpx;
  font-size: 28rpx;
  line-height: 1;
}

.lesson-account__bucket-meta {
  margin-top: 14rpx;
  font-size: 19rpx;
  color: rgba(32, 29, 23, 0.7);
}

.lesson-account__bucket-plus {
  position: absolute;
  top: 64rpx;
  left: 50%;
  width: 72rpx;
  transform: translateX(-50%);
  font-family: var(--super-admin-font-display);
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1;
  color: #e5484d;
  text-align: center;
}

.lesson-account__flow-stage {
  position: relative;
  z-index: 2;
  min-height: 760rpx;
  margin-top: 54rpx;
}

.lesson-account__flow-title {
  position: relative;
  z-index: 2;
  display: block;
  margin-left: 14rpx;
  font-family: var(--super-admin-font-display);
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.08;
  color: #fe8419;
}

.ledger-flow-character {
  position: absolute;
  top: 30rpx;
  left: -32rpx;
  z-index: 0;
  width: 445rpx;
  pointer-events: none;
}

.lesson-account__flow-panel {
  position: relative;
  z-index: 1;
  width: 653rpx;
  min-height: 390rpx;
  margin: 38rpx 0 0 14rpx;
  padding: 24rpx 32rpx 18rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 215, 94, 0.84);
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.lesson-account__filters {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
  min-height: 54rpx;
  margin-bottom: 8rpx;
}

.lesson-account__filter {
  display: flex;
  min-width: 76rpx;
  height: 54rpx;
  margin: 0;
  padding: 0 14rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(32, 29, 23, 0.2);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.38);
  font-size: 21rpx;
  line-height: 1;
  color: var(--super-admin-ink);
}

.lesson-account__filter--active {
  border-color: #fe8419;
  background: #fe8419;
  color: #ffffff;
}

.lesson-account__filter::after,
.lesson-account__adjust::after,
.state__retry::after {
  border: 0;
}

.lesson-account__row {
  display: flex;
  min-height: 154rpx;
  padding: 22rpx 0;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
  border-bottom: 3rpx solid rgba(255, 255, 255, 0.94);
}

.lesson-account__row:last-child {
  border-bottom: 0;
}

.lesson-account__row-main {
  min-width: 0;
  flex: 1;
}

.lesson-account__row-heading {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 18rpx;
}

.lesson-account__row-bullet {
  width: 22rpx;
  height: 22rpx;
  flex: none;
  border-radius: 50%;
  background: #2fbd82;
}

.lesson-account__row-title {
  min-width: 0;
  overflow: hidden;
  font-family: var(--super-admin-font-display);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.15;
  color: var(--super-admin-ink);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-account__row-meta {
  display: block;
  max-width: 100%;
  margin: 6rpx 0 0 40rpx;
  overflow: hidden;
  font-size: 19rpx;
  line-height: 1.35;
  color: rgba(32, 29, 23, 0.7);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-account__row-side {
  display: flex;
  width: 122rpx;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
}

.lesson-account__row-value {
  font-family: var(--super-admin-font-display);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  color: #fe8419;
}

.lesson-account__row-balance {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: rgba(32, 29, 23, 0.7);
  white-space: nowrap;
}

.lesson-account__adjust {
  display: flex;
  width: 112rpx;
  height: 56rpx;
  margin: 14rpx 0 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 16rpx;
  background: #fe8419;
  font-size: 22rpx;
  line-height: 1;
  color: #ffffff;
}

.lesson-account__empty,
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.lesson-account__empty {
  position: relative;
  z-index: 2;
  min-height: 270rpx;
}

.lesson-account__empty-title,
.state__title {
  font-family: var(--super-admin-font-display);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--super-admin-ink);
}

.lesson-account__empty-message,
.state__message {
  max-width: 520rpx;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--super-admin-muted);
}

.state {
  position: relative;
  z-index: 2;
  min-height: 520rpx;
}

.state__retry {
  display: flex;
  min-height: 72rpx;
  margin: 24rpx 0 0;
  padding: 0 30rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 8rpx;
  background: #fe8419;
  font-size: 23rpx;
  color: #ffffff;
}
