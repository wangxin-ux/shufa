.campaign-page {
  min-height: calc(100vh - 150rpx);
  padding: 38rpx 0 100rpx;
  box-sizing: border-box;
}

.campaign-head__eyebrow,
.campaign-head__title,
.campaign-head__subtitle,
.campaign-card__course,
.campaign-card__title,
.campaign-card__description,
.campaign-card__price-caption {
  display: block;
}

.campaign-head__eyebrow {
  font-size: 21rpx;
  font-weight: 700;
  color: #9c470d;
}

.campaign-head__title {
  margin-top: 8rpx;
  font-family: var(--teacher-font-display);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--teacher-ink);
}

.campaign-head__subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--teacher-muted);
}

.campaign-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 30rpx;
}

.campaign-card {
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 16rpx;
  background: #fffdf8;
  box-shadow: 0 16rpx 32rpx rgba(77, 48, 20, 0.16);
  transition: opacity 120ms ease, transform 120ms ease;
}

.campaign-card--pressed {
  opacity: 0.88;
  transform: scale(0.99);
}

.campaign-card__visual {
  position: relative;
  height: 420rpx;
  overflow: hidden;
  background: #f4c72f;
}

.campaign-card__cover {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
}

.campaign-card__fallback {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  padding: 36rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, #ffd75e, #fe8419);
  color: #4f1c0d;
}

.campaign-card__fallback-course {
  font-size: 24rpx;
  font-weight: 700;
}

.campaign-card__fallback-title {
  margin-top: 10rpx;
  font-family: var(--teacher-font-display);
  font-size: 52rpx;
  font-weight: 700;
}

.campaign-card__status {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  display: flex;
  align-items: center;
  padding: 12rpx 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.48);
  border-radius: 28rpx;
  background: rgba(36, 30, 25, 0.72);
  box-shadow: 0 6rpx 16rpx rgba(36, 23, 12, 0.18);
  backdrop-filter: blur(12rpx);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
  color: #ffffff;
}

.campaign-card__status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: var(--teacher-yellow);
  box-shadow: 0 0 0 5rpx rgba(255, 215, 94, 0.2);
}

.campaign-card__body {
  padding: 28rpx 30rpx 30rpx;
}

.campaign-card__top,
.campaign-card__footer,
.campaign-card__time-row,
.campaign-card__price-block {
  display: flex;
  align-items: center;
}

.campaign-card__top,
.campaign-card__footer {
  justify-content: space-between;
  gap: 20rpx;
}

.campaign-card__course {
  min-width: 0;
  overflow: hidden;
  font-size: 21rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #9c470d;
}

.campaign-card__poster-count {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 215, 94, 0.5);
  font-size: 21rpx;
  color: #60411f;
}

.campaign-card__title {
  margin-top: 18rpx;
  overflow-wrap: anywhere;
  font-family: var(--teacher-font-display);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--teacher-ink);
}

.campaign-card__description {
  margin-top: 10rpx;
  overflow-wrap: anywhere;
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--teacher-muted);
}

.campaign-card__footer {
  margin-top: 24rpx;
}

.campaign-card__price-block {
  align-items: baseline;
  gap: 10rpx;
}

.campaign-card__price-caption {
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(42, 35, 30, 0.58);
}

.campaign-card__price {
  flex: none;
  font-family: var(--teacher-font-display);
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1;
  color: #e85c1a;
}

.campaign-card__action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 196rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: linear-gradient(180deg, #ffad52 0%, #ff7d22 100%);
  box-shadow: inset 0 3rpx 0 rgba(255, 255, 255, 0.34), 0 8rpx 16rpx rgba(224, 91, 18, 0.2);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  color: #ffffff;
}

.campaign-card__action-arrow {
  margin-left: 8rpx;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

.campaign-card__time-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(42, 35, 30, 0.08);
}

.campaign-card__time-dot {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: var(--teacher-orange);
}

.campaign-card__deadline {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 21rpx;
  color: rgba(42, 35, 30, 0.54);
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 420rpx;
  margin-top: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 253, 248, 0.84);
}

.page-state__title {
  font-family: var(--teacher-font-display);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--teacher-ink);
}

.page-state__message {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--teacher-muted);
}

.state-button,
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--teacher-touch-min);
  margin: 24rpx 0 0;
  padding: 0 30rpx;
  border: 0;
  border-radius: 8rpx;
  background: var(--teacher-orange);
  font-size: 24rpx;
  color: #ffffff;
}

.load-more {
  align-self: center;
  min-width: 220rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #ffad52 0%, #ff7d22 100%);
  box-shadow: inset 0 3rpx 0 rgba(255, 255, 255, 0.34), 0 8rpx 16rpx rgba(224, 91, 18, 0.18);
}

button::after {
  border: 0;
}

@media (max-width: 350px) {
  .campaign-card__visual {
    height: 390rpx;
  }

  .campaign-card__action {
    min-width: 174rpx;
    padding: 0 18rpx;
  }
}
