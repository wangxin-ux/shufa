/*
 * 教师端课时账户页（PSD a3「课时账户 / 课时流水 / 教师贡献度排名」）视觉依据：
 * docs/verification/2026-11-17-teacher-operator-visual-alignment.md、docs/ui/teacher-ui-source.md §8；
 * 几何与字号以 `素材/UI更新家长+合作方+教师端+运营端(1).pdf` 第 20 屏为终稿（该屏与 PSD 导出图逐像素一致）。
 * 量测（1125px 画板 → rpx = px × 0.6667）：黄卡 #F6D468（= --teacher-yellow-soft）、
 * 橙卡 #FE8318→#FF7B10、卡内文字 #2C453F、绿点 #23B574、主橙 #FE8419；
 * 卡宽 653rpx、圆角 32/16rpx、提现圆钮 117rpx（两行「立即/提现」）、区块标题 54rpx。
 * 屏幕结构按 PSD：屏标题 + 内部预计说明 → 橙色账户卡 → 课时流水（筛选面板）→ 教师贡献度排名（picker + 查看更多）。
 */

.earnings-page {
  padding-top: 64rpx;
  padding-bottom: 72rpx;
}

.page-head {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
  min-height: 0;
}

.page-head__title {
  font-family: var(--teacher-font-display);
  font-size: 64rpx;
  line-height: 1.2;
  color: var(--teacher-orange);
}

.page-head__hint {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 24rpx;
  color: rgba(44, 69, 63, 0.78);
}

/* ---------- 橙色累计收益卡 ---------- */

.account-card {
  position: relative;
  margin-top: 12rpx;
  min-height: 363rpx;
  height: 363rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #fe8318 0%, #ff7b10 100%);
  box-shadow: 0 12rpx 26rpx rgba(66, 48, 15, 0.2);
  color: #ffffff;
}

.account-card__character {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 434rpx;
  pointer-events: none;
}

.account-card__head,
.account-card__figure,
.account-card__metrics,
.account-card__status {
  position: relative;
  z-index: 1;
}

.account-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 40rpx;
}

.account-card__label {
  font-size: 16rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.94);
}

.account-card__figure {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 40rpx;
  padding-bottom: 0;
}

.account-card__figure-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
  width: 100%;
}

.account-card__amount {
  max-width: 100%;
  overflow-wrap: anywhere;
  font-family: var(--teacher-font-display);
  font-size: 128rpx;
  font-weight: 400;
  line-height: 1.02;
  white-space: nowrap;
  color: #000000;
}

.account-card__amount--compact { font-size: 96rpx; }
.account-card__amount--long { font-size: 72rpx; }

.account-card__amount--compact,
.account-card__amount--long {
  align-self: flex-start;
  padding: 4rpx 8rpx;
  border-radius: 10rpx;
  background: #fe8318;
}

.account-card__amount-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.account-card__metrics {
  position: absolute;
  left: 32rpx;
  bottom: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  width: 250rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

.account-card__metric {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
  padding: 0;
}

.account-card__metric+.account-card__metric {
  border-left: 0;
}

.account-card__metric-label,
.account-card__metric-value {
  max-width: 100%;
  overflow-wrap: anywhere;
}

.account-card__metric-label {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.8);
}

.account-card__metric-value {
  margin-top: 0;
  font-family: var(--teacher-font-display);
  font-size: 16rpx;
  font-weight: 400;
  line-height: 1.15;
}

.account-card__status {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 22rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #ff9136;
}

.account-card__status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 0 10rpx;
}

.account-card__status-item+.account-card__status-item {
  border-left: 1rpx solid rgba(255, 255, 255, 0.2);
}

.account-card__status-label,
.account-card__status-value {
  max-width: 100%;
  overflow-wrap: anywhere;
  text-align: center;
}

.account-card__status-label {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.78);
}

.account-card__status-value {
  margin-top: 4rpx;
  font-family: var(--teacher-font-display);
  font-size: 24rpx;
  font-weight: 700;
}

/* ---------- 区块标题 ---------- */

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 88rpx;
}

.section-title {
  min-width: 0;
  overflow-wrap: anywhere;
  font-family: var(--teacher-font-display);
  font-size: 72rpx;
  font-weight: 400;
  line-height: 1.2;
  color: var(--teacher-orange);
}

.section-link {
  flex: none;
  min-height: 72rpx;
  margin: 0;
  padding: 0 4rpx;
  background: transparent;
  font-size: 22rpx;
  line-height: 1.2;
  color: rgba(44, 69, 63, 0.86);
}

.ledger-section {
  margin-top: 34rpx;
}

.rank-section {
  margin-top: 20rpx;
}

.account-details {
  margin-top: 44rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff1d6;
}

.account-details__title {
  font-family: var(--teacher-font-display);
  font-size: 34rpx;
  color: var(--teacher-orange);
}

.account-details .account-card__status {
  margin: 20rpx 0;
}

.rank-section .section-head {
  min-height: 78rpx;
}

/* ---------- 课时流水卡 ---------- */

.ledger-card {
  margin-top: 22rpx;
  padding: 22rpx 32rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--teacher-yellow-soft);
  box-shadow: 0 8rpx 18rpx rgba(95, 65, 18, 0.2);
}

.ledger-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
}

.ledger-row+.ledger-row {
  border-top: 3rpx solid #ffffff;
}

.ledger-row__dot {
  flex: none;
  width: 19rpx;
  height: 19rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: #23b574;
}

.ledger-row__dot--withdrawal {
  background: #fe8419;
}

.ledger-row__main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.ledger-row__title {
  font-family: var(--teacher-font-display);
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1.2;
  color: #2c453f;
  overflow-wrap: anywhere;
}

.ledger-row__meta,
.ledger-row__note,
.ledger-row__reason {
  max-width: 100%;
  overflow-wrap: anywhere;
}

.ledger-row__meta {
  margin-top: 8rpx;
  font-size: 16rpx;
  color: rgba(44, 69, 63, 0.76);
}

.ledger-row__note {
  margin-top: 6rpx;
  font-size: 16rpx;
  color: rgba(44, 69, 63, 0.58);
}

.ledger-row__reason {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--teacher-danger);
}

.amount-badge {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 108rpx;
  max-width: 40%;
  min-height: 54rpx;
  padding: 6rpx 14rpx;
  box-sizing: border-box;
  border-radius: 11rpx;
  background: var(--teacher-orange);
  font-family: var(--teacher-font-display);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #ffffff;
  text-align: center;
  overflow-wrap: anywhere;
}

.cancel-command {
  min-width: 152rpx;
  min-height: 72rpx;
  margin: 14rpx 0 0;
  padding: 0 20rpx;
  background: rgba(201, 63, 72, 0.1);
  font-size: 22rpx;
  color: var(--teacher-danger);
}

/* ---------- 教师贡献度排名 ---------- */

.rank-section__period {
  display: block;
  margin: 0 0 2rpx;
  font-family: var(--teacher-font-display);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--teacher-orange);
}

.rank-card {
  margin-top: 4rpx;
  padding: 18rpx 32rpx 10rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--teacher-yellow-soft);
  box-shadow: 0 8rpx 18rpx rgba(95, 65, 18, 0.2);
}

.rank-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.rank-card__caption {
  min-height: 64rpx;
  margin: 0;
  padding: 0 4rpx;
  background: transparent;
  font-size: 24rpx;
  line-height: 1.2;
  color: rgba(44, 69, 63, 0.78);
  text-align: left;
}

.rank-row {
  display: grid;
  grid-template-columns: 19rpx 56rpx minmax(0, 1fr) 116rpx;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 10rpx 0;
  box-sizing: border-box;
}

.rank-row--self {
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.42);
}

.rank-row__dot {
  width: 19rpx;
  height: 19rpx;
  border-radius: 50%;
  background: #23b574;
}

.rank-row__place {
  font-family: var(--teacher-font-display);
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  color: #2c453f;
}

.rank-row__name {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 34rpx;
  color: #2c453f;
}

.rank-row__change {
  justify-self: end;
  max-width: 116rpx;
  padding: 5rpx 12rpx;
  box-sizing: border-box;
  border-radius: 7rpx;
  background: var(--teacher-orange);
  font-family: var(--teacher-font-display);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #ffffff;
  text-align: center;
  overflow-wrap: anywhere;
}

.rank-card__more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin: 6rpx 0 0;
  padding: 0;
  background: transparent;
  font-size: 22rpx;
  line-height: 1.2;
  color: rgba(44, 69, 63, 0.82);
}

.rank-section__more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: var(--teacher-touch-min);
  margin: 10rpx 0 0;
  padding: 0;
  border-radius: 16rpx;
  background: var(--teacher-yellow-soft);
  font-size: 22rpx;
  color: rgba(44, 69, 63, 0.86);
}

/* ---------- 筛选面板 ---------- */

.filter-layer {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.filter-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(24, 18, 14, 0.46);
}

.filter-sheet {
  position: relative;
  z-index: 1;
  width: 100%;
  padding: 30rpx var(--teacher-page-gap) calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 16rpx 16rpx 0 0;
  background: var(--teacher-surface);
}

.filter-sheet__title {
  display: block;
  margin-bottom: 20rpx;
  font-family: var(--teacher-font-display);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--teacher-ink);
}

/* ---------- 通用控件 ---------- */

.segment__item,
.withdraw-command,
.page-command,
.cancel-command,
.section-link,
.rank-card__more,
.rank-section__more,
.dialog-command {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 0;
  border-radius: 14rpx;
  line-height: 1.2;
  text-align: center;
}

.segment {
  display: grid;
  flex: 1;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  min-width: 0;
  padding: 6rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.7);
}

.segment__item {
  min-width: 0;
  min-height: 80rpx;
  margin: 0;
  padding: 0 16rpx;
  background: transparent;
  font-size: 22rpx;
  color: rgba(44, 69, 63, 0.66);
}

.segment__item--active {
  background: var(--teacher-surface);
  box-shadow: 0 5rpx 12rpx rgba(66, 48, 15, 0.14);
  font-weight: 700;
  color: var(--teacher-ink);
}

.filter-sheet .segment {
  margin-bottom: 22rpx;
}

.withdraw-command {
  min-height: var(--teacher-touch-min);
  margin: 0;
  padding: 0 22rpx;
  background: var(--teacher-ink);
  font-size: 23rpx;
  font-weight: 700;
  color: #ffffff;
}

.account-card__withdraw {
  position: absolute;
  right: 12rpx;
  bottom: 18rpx;
  z-index: 3;
  flex: none;
  flex-direction: column;
  width: 117rpx;
  height: 117rpx;
  padding: 0;
  border-radius: 50%;
  background: var(--teacher-orange);
  box-shadow: inset 0 0 14rpx rgba(255, 255, 255, 0.43);
  font-family: var(--teacher-font-display);
  font-size: 37rpx;
  font-weight: 400;
  line-height: 1.06;
  color: #000000;
}

.page-state,
.list-empty {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 220rpx;
  margin-top: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.78);
}

.page-state__title,
.list-empty__title {
  font-family: var(--teacher-font-display);
  font-size: 38rpx;
  font-weight: 700;
}

.page-state__message,
.list-empty__message {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: var(--teacher-muted);
}

.page-command {
  min-width: 190rpx;
  min-height: var(--teacher-touch-min);
  margin: 22rpx 0 0;
  padding: 0 28rpx;
  background: var(--teacher-orange);
  font-size: 23rpx;
  color: #ffffff;
}

.load-more {
  align-self: center;
  margin: 20rpx auto 8rpx;
}

.list-error {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--teacher-danger);
}

.withdrawal-recovery {
  margin-top: 18rpx;
  color: var(--teacher-danger);
  font-size: 23rpx;
  overflow-wrap: anywhere;
}

.withdrawal-recovery__command {
  margin-top: 12rpx;
}

/* ---------- 提现弹窗 ---------- */

.modal-layer {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(24, 18, 14, 0.46);
}

.withdrawal-dialog {
  position: relative;
  z-index: 1;
  width: 100%;
  max-height: 80vh;
  padding: 34rpx var(--teacher-page-gap) calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  border-radius: 16rpx 16rpx 0 0;
  background: var(--teacher-surface);
}

.withdrawal-dialog__title {
  display: block;
  font-family: var(--teacher-font-display);
  font-size: 38rpx;
  font-weight: 700;
}

.withdrawal-dialog__note {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--teacher-muted);
}

.withdrawal-dialog__rule {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(36, 59, 54, 0.06);
}

.withdrawal-dialog__rule-line {
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--teacher-muted);
  overflow-wrap: anywhere;
}

.amount-field {
  display: flex;
  align-items: center;
  min-height: 106rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--teacher-line);
  border-radius: 16rpx;
  background: #ffffff;
}

.amount-field__currency {
  flex: none;
  font-family: var(--teacher-font-display);
  font-size: 38rpx;
  font-weight: 700;
}

.amount-field__input {
  flex: 1;
  min-width: 0;
  height: 100rpx;
  margin-left: 14rpx;
  font-family: var(--teacher-font-display);
  font-size: 40rpx;
}

.withdrawal-dialog__error {
  display: block;
  min-height: 32rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--teacher-danger);
}

.withdrawal-dialog__commands {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 26rpx;
}

.dialog-command {
  flex: 1;
  min-height: var(--teacher-touch-min);
  margin: 0;
  padding: 0 22rpx;
  font-size: 24rpx;
}

.dialog-command--secondary {
  background: rgba(36, 59, 54, 0.08);
  color: var(--teacher-ink);
}

.dialog-command--primary {
  background: var(--teacher-orange);
  font-weight: 700;
  color: #ffffff;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.52;
}

.control--hover {
  opacity: 0.72;
}

@media (min-width: 430px) {

  .account-card,
  .ledger-card,
  .rank-card,
  .list-error,
  .page-state,
  .list-empty {
    max-width: 760rpx;
    margin-right: auto;
    margin-left: auto;
  }

  .filter-sheet,
  .withdrawal-dialog {
    max-width: 760rpx;
    margin: 0 auto;
  }
}

.account-tools-button { display:flex; align-items:center; justify-content:center; width:88rpx; min-height:88rpx; padding:0; margin:0; background:transparent; color:#243b36; font-size:44rpx; line-height:1; }
.account-tools-button::after { border:0; }
.rank-section { position:relative; }
.rank-section__character { position:absolute; top:-40rpx; right:-80rpx; width:430rpx; pointer-events:none; }
.rank-section > .section-head, .rank-section > picker, .rank-card { position:relative; z-index:1; }
.rank-card { background:rgba(246,212,105,.86); border-radius:24rpx; }
.rank-card__caption { min-height:36rpx; font-size:16rpx; }
.rank-row { grid-template-columns:19rpx minmax(0,1fr) 108rpx; gap:30rpx; min-height:48rpx; padding:0; }
.rank-row__name { font-family:var(--teacher-font-display); font-size:34rpx; font-weight:400; }
.rank-row__change { width:108rpx; box-sizing:border-box; font-size:24rpx; font-weight:400; }
.rank-card__more { min-height:88rpx; margin:-10rpx 0 -20rpx; font-size:16rpx; color:#fff; }

.rank-card { min-height:356rpx; padding-bottom:74rpx; }
.rank-card--expanded { padding-bottom:10rpx; }
.rank-preview-more { position:absolute; left:32rpx; bottom:0; width:calc(100% - 64rpx); margin:0; }
.rank-card__caption--interactive { min-height:88rpx; }
.rank-own-detail { display:block; padding:10rpx 0; font-size:22rpx; color:#2c453f; }
