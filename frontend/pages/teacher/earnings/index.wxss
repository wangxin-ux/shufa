.earnings-page {
  padding-top: 28rpx;
  padding-bottom: 72rpx;
}

.earnings-page__overview {
  display: block;
}

.summary-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 26rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: var(--teacher-orange);
  box-shadow: var(--teacher-shadow);
  color: #ffffff;
}

.summary-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  min-height: 138rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.summary-item:nth-child(2n) {
  border-left: 2rpx solid rgba(255, 255, 255, 0.38);
}

.summary-item:nth-child(n + 3) {
  border-top: 2rpx solid rgba(255, 255, 255, 0.38);
}

.summary-item__label,
.summary-item__value {
  max-width: 100%;
  overflow-wrap: anywhere;
}

.summary-item__label {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.82);
}

.summary-item__value {
  margin-top: 9rpx;
  font-family: var(--teacher-font-display);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.1;
}

.status-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 6rpx 16rpx rgba(95, 65, 18, 0.09);
}

.status-strip__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 88rpx;
  padding: 14rpx 8rpx;
  box-sizing: border-box;
}

.status-strip__item + .status-strip__item {
  border-left: 1rpx solid rgba(111, 78, 27, 0.12);
}

.status-strip__label,
.status-strip__value {
  max-width: 100%;
  overflow-wrap: anywhere;
  text-align: center;
}

.status-strip__label {
  font-size: 20rpx;
  color: var(--teacher-muted);
}

.status-strip__value {
  margin-top: 4rpx;
  font-family: var(--teacher-font-display);
  font-size: 25rpx;
  font-weight: 700;
  color: var(--teacher-ink);
}

.rule-panel {
  margin-top: 20rpx;
  padding: 26rpx 28rpx;
  border-left: 8rpx solid var(--teacher-orange);
  border-radius: 16rpx;
  background: var(--teacher-surface);
  box-shadow: var(--teacher-shadow);
}

.section-heading,
.rule-panel__main,
.financial-row__head,
.financial-row__meta,
.earnings-toolbar,
.withdrawal-dialog__commands {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-heading__title {
  font-family: var(--teacher-font-display);
  font-size: 30rpx;
  font-weight: 700;
}

.section-heading__tag {
  flex: none;
  padding: 7rpx 13rpx;
  border-radius: 12rpx;
  background: rgba(254, 132, 25, 0.13);
  font-size: 20rpx;
  color: #9c4300;
}

.rule-panel__main {
  align-items: baseline;
  margin-top: 20rpx;
}

.rule-panel__basis,
.rule-panel__amount {
  min-width: 0;
  overflow-wrap: anywhere;
}

.rule-panel__basis {
  font-size: 27rpx;
  color: var(--teacher-ink);
}

.rule-panel__amount {
  flex: none;
  font-family: var(--teacher-font-display);
  font-size: 38rpx;
  font-weight: 700;
  color: var(--teacher-orange);
}

.rule-panel__meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--teacher-muted);
}

.earnings-toolbar {
  align-items: stretch;
  margin-top: 28rpx;
}

.segment {
  display: grid;
  flex: 1;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  min-width: 0;
  padding: 6rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.68);
}

.segment__item,
.withdraw-command,
.page-command,
.cancel-command,
.dialog-command {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--teacher-touch-min);
  box-sizing: border-box;
  border: 0;
  border-radius: 14rpx;
  line-height: 1.2;
  text-align: center;
}

.segment__item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  margin: 0;
  padding: 0 14rpx;
  background: transparent;
  font-size: 23rpx;
  color: var(--teacher-muted);
}

.segment__item--active {
  background: var(--teacher-surface);
  box-shadow: 0 5rpx 12rpx rgba(66, 48, 15, 0.11);
  font-weight: 700;
  color: var(--teacher-ink);
}

.withdraw-command {
  flex: none;
  min-width: 174rpx;
  margin: 0;
  padding: 0 22rpx;
  background: var(--teacher-ink);
  font-size: 23rpx;
  font-weight: 700;
  color: #ffffff;
}

.financial-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.financial-row {
  padding: 24rpx 26rpx;
  border-left: 8rpx solid var(--teacher-orange);
  border-radius: 16rpx;
  background: var(--teacher-surface);
  box-shadow: var(--teacher-shadow);
}

.financial-row__head {
  align-items: flex-start;
}

.financial-row__identity {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.financial-row__course,
.financial-row__kind,
.financial-row__amount,
.financial-row__basis,
.financial-row__reason {
  max-width: 100%;
  overflow-wrap: anywhere;
}

.financial-row__course {
  font-family: var(--teacher-font-display);
  font-size: 31rpx;
  font-weight: 700;
}

.financial-row__kind {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--teacher-muted);
}

.financial-row__amount {
  flex: none;
  max-width: 42%;
  font-family: var(--teacher-font-display);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--teacher-orange);
  text-align: right;
}

.financial-row__meta {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--teacher-line);
  font-size: 21rpx;
  color: var(--teacher-muted);
}

.status-chip {
  flex: none;
  padding: 7rpx 13rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.status-chip--success {
  background: rgba(35, 135, 96, 0.12);
  color: var(--teacher-success);
}

.status-chip--warning {
  background: rgba(254, 132, 25, 0.14);
  color: #9c4300;
}

.status-chip--muted {
  background: rgba(36, 59, 54, 0.09);
  color: var(--teacher-muted);
}

.status-chip--danger {
  background: rgba(201, 63, 72, 0.12);
  color: var(--teacher-danger);
}

.financial-row__basis,
.financial-row__reason {
  display: block;
  margin-top: 13rpx;
  font-size: 22rpx;
  color: var(--teacher-muted);
}

.financial-row__reason,
.list-error,
.withdrawal-dialog__error {
  color: var(--teacher-danger);
}

.cancel-command {
  min-width: 152rpx;
  margin: 18rpx 0 0 auto;
  padding: 0 20rpx;
  background: rgba(201, 63, 72, 0.08);
  font-size: 22rpx;
  color: var(--teacher-danger);
}

.page-state,
.list-empty {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 320rpx;
  margin-top: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
}

.page-state__title,
.list-empty__title {
  font-family: var(--teacher-font-display);
  font-size: 38rpx;
  font-weight: 700;
}

.page-state__message,
.list-empty__message {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: var(--teacher-muted);
}

.page-command {
  min-width: 190rpx;
  margin: 24rpx 0 0;
  padding: 0 28rpx;
  background: var(--teacher-orange);
  font-size: 23rpx;
  color: #ffffff;
}

.load-more {
  align-self: center;
}

.list-error {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
}

.modal-layer {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(24, 18, 14, 0.46);
}

.withdrawal-dialog {
  position: relative;
  z-index: 1;
  width: 100%;
  max-height: 80vh;
  padding: 34rpx var(--teacher-page-gap) calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  border-radius: 16rpx 16rpx 0 0;
  background: var(--teacher-surface);
}

.withdrawal-dialog__title {
  display: block;
  font-family: var(--teacher-font-display);
  font-size: 38rpx;
  font-weight: 700;
}

.withdrawal-dialog__note {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--teacher-muted);
}

.amount-field {
  display: flex;
  align-items: center;
  min-height: 106rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--teacher-line);
  border-radius: 16rpx;
  background: #ffffff;
}

.amount-field__currency {
  flex: none;
  font-family: var(--teacher-font-display);
  font-size: 38rpx;
  font-weight: 700;
}

.amount-field__input {
  flex: 1;
  min-width: 0;
  height: 100rpx;
  margin-left: 14rpx;
  font-family: var(--teacher-font-display);
  font-size: 40rpx;
}

.withdrawal-dialog__error {
  display: block;
  min-height: 32rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
}

.withdrawal-dialog__commands {
  margin-top: 26rpx;
}

.dialog-command {
  flex: 1;
  margin: 0;
  padding: 0 22rpx;
  font-size: 24rpx;
}

.dialog-command--secondary {
  background: rgba(36, 59, 54, 0.08);
  color: var(--teacher-ink);
}

.dialog-command--primary {
  background: var(--teacher-orange);
  font-weight: 700;
  color: #ffffff;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.52;
}

.control--hover {
  opacity: 0.72;
}

@media (min-width: 430px) {
  .summary-panel,
  .rule-panel,
  .earnings-toolbar,
  .financial-list,
  .list-error {
    max-width: 760rpx;
    margin-right: auto;
    margin-left: auto;
  }
}
