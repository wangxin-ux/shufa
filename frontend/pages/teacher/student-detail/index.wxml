<teacher-page-shell
  markTitle="学员详情"
  markIcon="/pages/teacher/assets/icon-students.png"
  tone="yellow"
  showBack="{{true}}"
>
  <view class="student-detail">
    <view wx:if="{{viewState === 'loading'}}" class="page-state">
      <text class="page-state__title">正在加载学员详情</text>
    </view>
    <view wx:elif="{{viewState === 'forbidden'}}" class="page-state">
      <text class="page-state__title">无访问权限</text>
      <text class="page-state__message">{{errorMessage}}</text>
    </view>
    <view wx:elif="{{viewState === 'error'}}" class="page-state">
      <text class="page-state__title">学员详情加载失败</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-state__retry" bindtap="onRetry" hover-class="control--hover">重试</button>
    </view>
    <view wx:elif="{{viewState === 'empty'}}" class="page-state">
      <text class="page-state__title">暂无学员详情</text>
    </view>

    <block wx:elif="{{viewState === 'ready'}}">
      <view class="student-hero">
        <text class="student-hero__eyebrow">负责学员</text>
        <text class="student-hero__name">{{detail.displayName}}</text>
        <text class="student-hero__class">{{detail.classLabel}}</text>
      </view>

      <view class="section-head">
        <text class="section-head__title">下一次课程</text>
      </view>
      <view class="next-lesson">
        <view>
          <text class="next-lesson__title">{{detail.nextLessonTitle}}</text>
          <text class="next-lesson__class">{{detail.nextLessonClassLabel}}</text>
        </view>
        <text class="next-lesson__time">{{detail.nextLessonTime}}</text>
      </view>

      <view class="section-head">
        <text class="section-head__title">近期出勤</text>
        <text class="section-head__meta">到课率 {{detail.attendanceRateLabel}}</text>
      </view>
      <view class="attendance-summary">
        <text>{{detail.attendanceSummary}}</text>
      </view>
      <view wx:if="{{detail.recentAttendance.length}}" class="detail-list">
        <view wx:for="{{detail.recentAttendance}}" wx:key="id" class="detail-row">
          <view class="detail-row__body">
            <text class="detail-row__title">{{item.courseName}}</text>
            <text class="detail-row__meta">{{item.timeLabel}}</text>
          </view>
          <text class="detail-row__status detail-row__status--{{item.statusTone}}">{{item.statusLabel}}</text>
        </view>
      </view>
      <text wx:else class="empty-line">暂无近期出勤记录</text>

      <view class="section-head">
        <text class="section-head__title">最近反馈</text>
      </view>
      <view class="feedback-card">
        <text class="feedback-card__content">{{detail.latestFeedbackContent}}</text>
        <text class="feedback-card__meta">{{detail.latestFeedbackMeta}}</text>
      </view>

      <view class="section-head">
        <text class="section-head__title">负责班级</text>
        <text class="section-head__meta">{{detail.classes.length}} 个</text>
      </view>
      <view wx:if="{{detail.classes.length}}" class="detail-list">
        <view wx:for="{{detail.classes}}" wx:key="id" class="detail-row">
          <view class="detail-row__body">
            <text class="detail-row__title">{{item.className}}</text>
            <text class="detail-row__meta">{{item.courseName}}</text>
          </view>
        </view>
      </view>
      <text wx:else class="empty-line">暂无负责班级</text>
    </block>
  </view>
</teacher-page-shell>
