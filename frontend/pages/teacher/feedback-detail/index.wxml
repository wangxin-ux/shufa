<teacher-page-shell
  markTitle="反馈"
  markIcon="/pages/teacher/assets/icon-student-record.png"
  tone="yellow"
  showBack="{{true}}"
>
  <view class="feedback-detail-page">
    <view wx:if="{{viewState === 'loading'}}" class="page-state">
      <text class="page-state__title">正在加载反馈详情</text>
    </view>
    <view wx:elif="{{viewState === 'empty'}}" class="page-state">
      <text class="page-state__title">请选择需要填写反馈的课次</text>
    </view>
    <view wx:elif="{{viewState === 'forbidden'}}" class="page-state">
      <text class="page-state__title">无访问权限</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-command" bindtap="onLogin">重新登录</button>
    </view>
    <view wx:elif="{{viewState === 'error'}}" class="page-state">
      <text class="page-state__title">反馈详情加载失败</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-command" bindtap="onRetry" hover-class="control--hover">重试</button>
    </view>

    <block wx:else>
      <teacher-workspace-banner
        class="feedback-detail-page__overview"
        eyebrow="{{statusLabel}}"
        title="{{courseName}}"
        detail="{{detailLabel}}"
        compact="{{true}}"
      />

      <view class="feedback-summary">
        <text class="feedback-summary__title">逐学员课堂反馈</text>
        <text class="feedback-summary__progress">{{progressLabel}}</text>
      </view>

      <view wx:if="{{refreshError}}" class="mutation-state">
        <text>{{refreshError}}</text>
        <button class="page-command" bindtap="onRetry">重试刷新</button>
      </view>

      <view wx:if="{{imageError}}" class="mutation-state">
        <text>{{imageError}}</text>
        <button class="page-command" disabled="{{refreshing || feedbackSubmittingId || feedbackUploadingId}}" bindtap="onRetryImages">重新加载图片</button>
      </view>

      <view wx:if="{{mutationMessage}}" class="mutation-state">
        <text>{{mutationMessage}}</text>
      </view>

      <view class="feedback-students">
        <view class="feedback-card" wx:for="{{students}}" wx:key="id">
          <view class="feedback-card__head">
            <image wx:if="{{item.photo}}" class="feedback-card__photo" src="{{item.photo.accessUrl}}" mode="aspectFill" />
            <text class="feedback-card__name">{{item.displayName}}</text>
            <text class="feedback-card__attendance">{{item.attendanceLabel}}</text>
          </view>
          <view wx:if="{{item.parentReview}}" class="family-review">
            <text class="family-review__title">家长评价{{item.parentReview.valid ? '' : ' · 课次已撤销，评价无效'}}</text>
            <view wx:for="{{item.parentReviewRows}}" wx:for-item="row" wx:key="label" class="family-review__row">
              <text>{{row.label}}</text><text>{{row.ratingLabel}}</text>
            </view>
            <text wx:if="{{item.parentReview.note}}" class="family-review__note">{{item.parentReview.note}}</text>
          </view>

          <text wx:if="{{item.feedbackAuthorName}}" class="feedback-author">反馈教师 · {{item.feedbackAuthorName}}</text>
          <view class="teacher-ratings">
            <view class="performance-rating" wx:for="{{item.teacherRatingRows}}" wx:for-item="rating" wx:key="field">
              <text>{{rating.label}}</text>
              <picker
                wx:if="{{!item.readOnly}}"
                range="{{teacherRatingOptions}}"
                value="{{rating.pickerIndex}}"
                data-id="{{item.id}}"
                data-field="{{rating.field}}"
                disabled="{{feedbackSubmittingId || feedbackUploadingId || item.ratingConflict || feedbackReloadingId === item.id}}"
                bindchange="onTeacherRatingChange"
                aria-label="{{rating.label}} {{rating.ratingLabel}}"
              >
                <view class="performance-rating__choice">{{rating.ratingLabel}} ›</view>
              </picker>
              <text wx:else>{{rating.ratingLabel}}</text>
            </view>
          </view>
          <text wx:if="{{item.performanceRating !== null}}" class="feedback-legacy">历史单项评分 · {{item.performanceRatingLabel}}</text>
          <view wx:if="{{item.ratingConflict}}" class="mutation-state">
            <text>反馈已更新。重新加载会放弃该学员当前草稿。</text>
            <button class="page-command" data-id="{{item.id}}" disabled="{{refreshing || feedbackSubmittingId || feedbackUploadingId}}" bindtap="onReloadFeedback">重新加载该学员反馈</button>
          </view>
          <block wx:if="{{!item.readOnly}}">
            <textarea
              class="feedback-card__input"
              value="{{item.feedbackDraft}}"
              maxlength="1000"
              disabled="{{feedbackSubmittingId || feedbackUploadingId || feedbackReloadingId === item.id}}"
              data-id="{{item.id}}"
              placeholder="填写本节课的学习表现与建议"
              bindinput="onFeedbackInput"
            />
            <view wx:if="{{item.feedbackImages.length}}" class="feedback-card__images">
              <view class="feedback-image" wx:for="{{item.feedbackImages}}" wx:for-item="image" wx:key="id">
                <image
                  class="feedback-image__thumb"
                  src="{{draftImageUrls[image.id] || image.accessUrl}}"
                  mode="aspectFill"
                  data-id="{{item.id}}"
                  data-url="{{draftImageUrls[image.id] || image.accessUrl}}"
                  data-image-id="{{image.id}}"
                  binderror="onFeedbackImageError"
                  bindtap="onPreviewImages"
                />
                <button
                  class="feedback-image__remove"
                  disabled="{{feedbackSubmittingId || feedbackUploadingId || feedbackReloadingId === item.id}}"
                  data-id="{{item.id}}"
                  data-image-id="{{image.id}}"
                  bindtap="onRemoveImage"
                  aria-label="移除图片"
                >×</button>
              </view>
            </view>
            <button
              wx:if="{{item.feedbackImages.length < 3}}"
              class="feedback-card__add-image"
              data-id="{{item.id}}"
              disabled="{{feedbackSubmittingId || feedbackUploadingId || refreshing || item.ratingConflict}}"
              bindtap="onChooseImages"
              hover-class="control--hover"
            >{{feedbackUploadingId === item.id ? '上传中' : '+ 添加图片'}}（{{item.feedbackImages.length}}/3）</button>
            <button
              class="feedback-card__save"
              data-id="{{item.id}}"
              disabled="{{feedbackSubmittingId || feedbackUploadingId || refreshing || item.ratingConflict}}"
              bindtap="onSaveFeedback"
              hover-class="control--hover"
            >{{feedbackSubmittingId === item.id ? '保存中' : item.hasFeedback ? '更新反馈' : '保存反馈'}}</button>
          </block>
          <view wx:else class="feedback-card__readonly">
            <text>{{item.feedback || '暂无反馈'}}</text>
            <view wx:if="{{item.feedbackImages.length}}" class="feedback-card__images feedback-card__images--readonly">
              <image
                wx:for="{{item.feedbackImages}}"
                wx:for-item="image"
                wx:key="id"
                class="feedback-image__thumb"
                src="{{image.accessUrl}}"
                mode="aspectFill"
                data-id="{{item.id}}"
                data-url="{{image.accessUrl}}"
                data-image-id="{{image.id}}"
                binderror="onFeedbackImageError"
                bindtap="onPreviewImages"
              />
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
</teacher-page-shell>
