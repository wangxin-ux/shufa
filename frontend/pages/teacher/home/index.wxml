<teacher-page-shell
  markTitle="首页"
  markIcon="/pages/teacher/assets/icon-confirm.png"
  tone="home"
>
  <view class="home">
    <view wx:if="{{viewState === 'loading'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">正在加载课表</text>
    </view>

    <view wx:elif="{{viewState === 'forbidden'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">无访问权限</text>
      <text class="page-state__message">{{errorMessage}}</text>
    </view>

    <view wx:elif="{{viewState === 'error'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">课表加载失败</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-state__retry" bindtap="onRetry" hover-class="button--hover">重试</button>
    </view>

    <block wx:else>
      <view class="home__schedule-head">
        <text class="home__title">今日课表</text>
        <button
          class="home__more"
          data-key="more"
          bindtap="onActionTap"
          hover-class="button--hover"
        >查看更多</button>
      </view>

      <view
        wx:if="{{nextLesson}}"
        class="lesson-card"
        data-key="schedule"
        bindtap="onActionTap"
        hover-class="lesson-card--hover"
        role="button"
        aria-label="进入今日课表"
      >
        <view class="lesson-card__clock">
          <text class="lesson-card__time">{{nextLesson.time}}</text>
          <text class="lesson-card__weekday">{{nextLesson.weekday}}</text>
        </view>
        <view class="lesson-card__divider" aria-hidden="true"></view>
        <view class="lesson-card__detail">
          <text class="lesson-card__campus">{{nextLesson.campusName}}</text>
          <text class="lesson-card__course">{{nextLesson.courseName}}</text>
          <view class="lesson-card__status-line">
            <text
              wx:if="{{nextLesson.statusPrefix}}"
              class="lesson-card__status-prefix"
            >{{nextLesson.statusPrefix}}</text>
            <text class="lesson-card__status lesson-card__status--{{nextLesson.statusTone}}">{{nextLesson.statusLabel}}</text>
          </view>
        </view>
      </view>

      <view
        wx:if="{{viewState === 'empty'}}"
        class="lesson-empty"
        data-key="schedule"
        bindtap="onActionTap"
        hover-class="lesson-card--hover"
        role="button"
        aria-live="polite"
        aria-label="进入今日课表"
      >
        <text class="lesson-empty__title">{{emptyMessage}}</text>
        <text class="lesson-empty__message">可在课表中查看后续安排</text>
      </view>

      <view class="home__stage">
        <image
          class="home__mascot"
          src="/assets/teacher/home-mascot.png"
          mode="widthFix"
          aria-hidden="true"
        />
        <button
          class="home__profile-hit"
          bindtap="onProfileTap"
          hover-class="home__identity--hover"
          aria-label="进入我的页面"
        ></button>
        <button
          class="home__identity"
          bindtap="onProfileTap"
          hover-class="home__identity--hover"
          aria-label="进入我的页面"
        >
          <text class="home__teacher-name">{{teacher.displayName}}</text>
          <text class="home__teacher-subject">{{teacher.subjectLabel}}</text>
        </button>
        <teacher-stat-strip class="home__stats" items="{{stats}}" />
      </view>

      <view class="home__footer-actions">
        <view class="quick-actions">
          <button
            wx:for="{{actions}}"
            wx:key="key"
            class="quick-action {{item.key === 'schedule' ? 'quick-action--active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onActionTap"
            hover-class="quick-action--hover"
          >
            <image class="quick-action__icon" src="{{item.icon}}" mode="aspectFit" />
            <text class="quick-action__label">{{item.label}}</text>
          </button>
        </view>
        <button
          class="home__footer-more"
          data-key="more"
          bindtap="onActionTap"
          hover-class="button--hover"
        >查看更多</button>
      </view>
    </block>
  </view>
</teacher-page-shell>
