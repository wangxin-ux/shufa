.home {
  position: relative;
  min-height: calc(100vh - 140rpx);
  padding-top: 116rpx;
  padding-bottom: 36rpx;
  box-sizing: border-box;
}

.home__schedule-head {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
  margin-left: 8rpx;
}

.home__title {
  min-width: 0;
  overflow-wrap: anywhere;
  font-family: var(--teacher-font-display);
  font-size: 62rpx;
  font-weight: 700;
  line-height: 1.08;
  color: #ffffff;
}

.home__more,
.home__footer-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--role-home-more-height);
  margin: 0;
  padding: 0 var(--role-home-more-padding-x);
  box-sizing: border-box;
  border: var(--role-home-more-border);
  border-radius: 999rpx;
  background: transparent;
  font-size: var(--role-home-more-font-size);
  line-height: var(--role-home-more-height);
  color: #ffffff;
}

.page-state__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--teacher-touch-min);
  margin: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
  border: 3rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 44rpx;
  background: transparent;
  font-size: 25rpx;
  color: #ffffff;
}

.home__more::after,
.home__footer-more::after,
.page-state__retry::after,
.home__identity::after,
.quick-action::after {
  border: 0;
}

.lesson-card {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 231rpx 4rpx minmax(0, 1fr);
  align-items: center;
  min-height: 250rpx;
  margin-top: 34rpx;
}

.lesson-card--hover {
  opacity: 0.82;
}

.lesson-card__clock,
.lesson-card__detail {
  display: flex;
  flex-direction: column;
  min-width: 0;
  transform: translateY(-25rpx);
}

.lesson-card__clock {
  align-items: center;
}

.lesson-card__time {
  max-width: 100%;
  font-family: var(--teacher-font-display);
  font-size: 73rpx;
  font-weight: 700;
  line-height: 1;
  color: #960900;
  white-space: nowrap;
}

.lesson-card__weekday {
  max-width: 100%;
  margin-top: 18rpx;
  overflow: hidden;
  font-family: var(--teacher-font-display);
  font-size: 29rpx;
  font-weight: 700;
  color: #960900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-card__divider {
  align-self: start;
  width: 4rpx;
  height: 127rpx;
  margin-top: 37rpx;
  background: #ffffff;
}

.lesson-card__detail {
  justify-content: center;
  padding-left: 32rpx;
}

.lesson-card__campus,
.lesson-card__course,
.lesson-card__status-line {
  max-width: 100%;
  overflow-wrap: anywhere;
}

.lesson-card__campus {
  font-size: 29rpx;
  line-height: 1.3;
  color: rgba(255, 255, 255, 0.92);
}

.lesson-card__course {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-family: var(--teacher-font-display);
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.05;
  color: #ffffff;
}

.lesson-card__status-line {
  display: flex;
  align-items: baseline;
  margin-top: 0;
  font-family: var(--teacher-font-display);
  font-size: 29rpx;
  font-weight: 700;
  transform: translateY(0);
  white-space: nowrap;
}

.lesson-card__status-prefix,
.lesson-card__status {
  flex: none;
}

.lesson-card__status-prefix {
  color: #e31500;
}

.lesson-card__status--success {
  color: #1eaa45;
}

.lesson-card__status--warning {
  color: #a04400;
}

.lesson-card__status--muted {
  color: rgba(36, 59, 54, 0.68);
}

.lesson-card__status--danger {
  color: var(--teacher-danger);
}

.lesson-empty {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 250rpx;
  margin-top: 34rpx;
  padding: 0 28rpx;
  border-left: 4rpx solid rgba(255, 255, 255, 0.9);
}

.lesson-empty__title {
  font-family: var(--teacher-font-display);
  font-size: 46rpx;
  font-weight: 700;
  color: #ffffff;
}

.lesson-empty__message {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.78);
}

.home__stage {
  position: relative;
  height: 800rpx;
  margin: -74rpx -32rpx 0;
  overflow: visible;
}

.home__mascot {
  position: absolute;
  top: -26rpx;
  right: -24rpx;
  z-index: 0;
  width: 690rpx;
  pointer-events: none;
}

.home__profile-hit {
  position: absolute;
  top: 0;
  right: -24rpx;
  z-index: 1;
  width: 690rpx;
  height: 690rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

.home__profile-hit::after {
  border: 0;
}

.home__identity {
  position: absolute;
  right: 50rpx;
  bottom: 232rpx;
  left: 50rpx;
  z-index: 3;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 22rpx;
  max-width: none;
  min-height: var(--teacher-touch-min);
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.home__identity--hover,
.button--hover,
.quick-action--hover {
  opacity: 0.72;
}

.home__teacher-name,
.home__teacher-subject {
  min-width: 0;
  overflow-wrap: anywhere;
  color: #111111;
}

.home__teacher-name {
  display: block;
  flex: none;
  max-width: 58%;
  overflow: hidden;
  font-family: var(--teacher-font-display);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home__teacher-subject {
  display: block;
  min-width: 0;
  margin: 0;
  overflow: hidden;
  font-family: var(--teacher-font-display);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home__stats {
  position: absolute;
  right: var(--role-home-glass-right);
  bottom: 68rpx;
  left: var(--role-home-glass-left);
  z-index: 2;
}

.home__footer-actions {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 166rpx;
  margin-top: -32rpx;
  padding: 0 16rpx;
}

.quick-actions {
  position: relative;
  flex: none;
  display: flex;
  align-items: flex-start;
  width: var(--role-home-nav-width);
  height: var(--role-home-nav-active-size);
  overflow: visible;
  background: transparent;
}

.quick-actions::before {
  position: absolute;
  top: 17rpx;
  left: 0;
  width: var(--role-home-nav-capsule-width);
  height: var(--role-home-nav-capsule-height);
  border-radius: 999rpx;
  background: var(--role-home-nav-background);
  box-shadow: var(--role-home-nav-shadow);
  content: '';
  pointer-events: none;
}

.quick-action {
  position: relative;
  z-index: 1;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: var(--role-home-nav-item-width);
  min-width: var(--role-home-nav-item-width);
  min-height: var(--teacher-touch-min);
  margin: 23rpx 0 0;
  padding: 4rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.2;
}

.quick-action:first-child {
  margin-left: 4rpx;
}

.quick-action--active {
  width: var(--role-home-nav-active-size);
  min-width: var(--role-home-nav-active-size);
  height: var(--role-home-nav-active-size);
  min-height: var(--role-home-nav-active-size);
  margin: 0 0 0 -13rpx;
  border-radius: 50%;
  background: var(--role-home-nav-active-background);
  box-shadow: var(--role-home-nav-active-shadow);
}

.quick-action__icon {
  width: 38rpx;
  height: 38rpx;
}

.quick-action__label {
  max-width: 100%;
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 16rpx;
  color: var(--role-home-nav-ink);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-action--active .quick-action__icon {
  width: 54rpx;
  height: 56rpx;
}

.quick-action--active .quick-action__label {
  font-size: 16rpx;
  font-weight: 600;
  color: var(--role-home-nav-ink);
}

.home__footer-more {
  flex: none;
  align-self: flex-start;
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 520rpx;
  padding: 40rpx 20rpx;
}

.page-state__title {
  font-family: var(--teacher-font-display);
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

.page-state__message {
  max-width: 100%;
  margin-top: 18rpx;
  overflow-wrap: anywhere;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
}

.page-state__retry {
  margin-top: 28rpx;
}

@media (min-width: 420px) {
  .home__mascot {
    right: 0;
  }
}
