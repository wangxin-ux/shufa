/*
 * 教师端「我的」页视觉依据：`素材/UI更新/教师端/画板 1 拷贝.png` =
 * `素材/UI更新家长+合作方+教师端+运营端(1).pdf` 第 23 屏（两者同源，几何差 ≤2rpx）。
 * 量测（1125px 画板 → rpx = px × 0.6667）：
 *   导航白区到 442rpx；橙色身份卡 x 55.3..705.3 / y 461.3..723.3（650.7×263rpx）；
 *   金色菜单卡 x 55.3..705.3 / y 780.0..1055.3（650.7×276rpx），
 *   三行右侧橙圆钮 x 570.0..676.0（106.7×52.7rpx），行节距 83.3rpx；
 *   卡片圆角 32rpx、外边距 55rpx、金色 = rgb(255,215,94) 见 .profile-actions。
 * 姓名与科目位于左侧，右侧复用原稿完整人物，没有独立圆头像。
 */

.profile {
  position: relative;
  min-height: 0;
  padding-top: 84rpx;
  padding-bottom: 0;
  box-sizing: border-box;
}

.profile::after {
  position: absolute;
  right: -160rpx;
  top: calc(100vh - 350rpx);
  bottom: auto;
  left: -160rpx;
  z-index: 0;
  height: 560rpx;
  border-radius: 50% 50% 0 0;
  background: linear-gradient(180deg, #e6b431 0%, #e3ab1d 100%);
  content: '';
}

.profile__hero {
  position: relative;
  z-index: 2;
  height: 456rpx;
}

.profile__identity-card {
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: auto;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  width: 653rpx;
  min-height: 263rpx;
  padding: 28rpx 316rpx 28rpx 36rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 32rpx;
  background: var(--teacher-orange);
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.profile__identity-text {
  display: flex;
  width: 100%;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.profile__card-mascot {
  position: absolute;
  right: -32rpx;
  bottom: 0;
  z-index: 2;
  width: 462rpx;
}

.profile__card-mascot,
.profile__footer-mascot {
  pointer-events: none;
}

.profile__name,
.profile__subject,
.profile__student-count {
  position: relative;
  z-index: 3;
  max-width: 100%;
  overflow-wrap: anywhere;
  color: #ffffff;
}

.profile__name {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-family: var(--teacher-font-display);
  font-size: 95rpx;
  font-weight: 400;
  line-height: 1.05;
}

.profile__name--compact {
  font-size: 52rpx;
}

.profile__meta {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 16rpx;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin-top: 14rpx;
}

.profile__subject-row {
  display: flex;
  align-items: flex-start;
  flex: 0 1 auto;
  min-width: 0;
}

.profile__subject-label {
  flex: none;
  width: 56rpx;
  margin-top: 2rpx;
  padding: 3rpx 0;
  border: 2rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 10rpx;
  font-family: var(--teacher-font-display);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.15;
  text-align: center;
  color: rgba(255, 255, 255, 0.9);
}

.profile__subject-list {
  display: flex;
  flex: 0 1 auto;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  margin-left: 0;
}

.profile__subject {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-wrap: anywhere;
  font-family: var(--teacher-font-display);
  font-size: 63rpx;
  font-weight: 400;
  line-height: 1.18;
  white-space: normal;
}

.profile__student-count {
  flex: none;
  width: auto;
  padding-left: 0;
  box-sizing: border-box;
  font-family: var(--teacher-font-display);
  font-size: 63rpx;
  font-weight: 400;
  line-height: 1.2;
  color: #ffffff;
  white-space: nowrap;
}

.profile__meta .profile__student-count--compact {
  font-size: 38rpx;
}

.profile__meta--compact .profile__subject,
.profile__meta--compact .profile__student-count {
  font-size: 44rpx;
}

.profile__actions-stage {
  position: relative;
  z-index: 1;
  min-height: 800rpx;
  margin-top: 54rpx;
}

.profile__footer-mascot {
  position: absolute;
  top: 100rpx;
  left: -32rpx;
  z-index: 0;
  width: 573rpx;
  opacity: 1;
}

.profile-actions {
  position: relative;
  z-index: 2;
  width: 653rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 215, 94, 0.84);
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

/*
 * 设计稿金卡只画了 3 行、卡高 276rpx、行节距 83.3rpx；本项目有 6 个入口，
 * 行高按设计的 52.7rpx 圆钮与 83.3rpx 节距保留，卡高随行数自适应（不做内部滚动）。
 */
.profile-actions teacher-action-row {
  --teacher-action-background: transparent;
  --teacher-action-border: rgba(255, 255, 255, 0.94);
  --teacher-action-bullet: #2fbd82;
  --teacher-action-label-font: var(--teacher-font-display);
  --teacher-action-label-size: 34rpx;
}

.profile-actions teacher-action-row:last-child {
  border-bottom: 0;
}

.profile-session {
  position: relative;
  z-index: 3;
  width: 653rpx;
  max-width: 100%;
  margin: 28rpx 0 120rpx 0;
}

.page-state {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 520rpx;
  padding: 40rpx 20rpx;
}

.page-state__title {
  font-family: var(--teacher-font-display);
  font-size: 48rpx;
  font-weight: 700;
}

.page-state__message {
  max-width: 100%;
  margin-top: 18rpx;
  overflow-wrap: anywhere;
  font-size: 26rpx;
  color: var(--teacher-muted);
}

.page-state__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--teacher-touch-min);
  margin: 28rpx 0 0;
  padding: 0 34rpx;
  border: 0;
  border-radius: 16rpx;
  background: var(--teacher-orange);
  font-size: 26rpx;
  color: #ffffff;
}

.page-state__retry::after {
  border: 0;
}

.button--hover {
  opacity: 0.72;
}

.profile-tools-button { display:flex; align-items:center; justify-content:center; width:88rpx; min-height:88rpx; margin:0; padding:0; background:transparent; color:#243b36; font-size:44rpx; line-height:1; }
.profile-tools-button::after, .profile-tools-heading button::after { border:0; }
.profile-tools-layer { position:fixed; inset:0; z-index:100; display:flex; align-items:flex-end; }
.profile-tools-backdrop { position:absolute; inset:0; background:rgba(0,0,0,.28); }
.profile-tools-sheet { position:relative; width:100%; max-height:75vh; overflow-y:auto; padding:24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing:border-box; border-radius:28rpx 28rpx 0 0; background:#fff; }
.profile-tools-heading { display:flex; justify-content:space-between; align-items:center; font-size:32rpx; margin-bottom:16rpx; }
.profile-tools-heading button { width:88rpx; min-height:88rpx; margin:0; padding:0; background:transparent; font-size:44rpx; }
.profile-extra-action { display:flex; justify-content:space-between; align-items:center; min-height:88rpx; margin:0; padding:0 16rpx; border-radius:0; border-bottom:1rpx solid #eee; background:transparent; font-size:28rpx; }
.profile-extra-action::after { border:0; }

.profile__name--compact { max-width:300rpx; }
