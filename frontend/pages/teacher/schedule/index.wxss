.schedule-page {
  /* PSD 首卡顶边落在波浪下方 36px 处，去掉右上工具条后由内距补回同一位置。 */
  padding-top: 56rpx;
  padding-bottom: 60rpx;
}

.lesson-row__toggle::after,
.schedule-refresh__retry::after,
.page-state__retry::after,
.load-more::after {
  border: 0;
}

.schedule-refresh {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--teacher-ink);
}

.schedule-refresh__retry {
  flex: none;
  min-height: var(--teacher-touch-min);
  margin: 0;
  padding: 10rpx 24rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 16rpx;
  background: var(--teacher-orange);
  font-size: 26rpx;
  color: #ffffff;
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 380rpx;
  margin-top: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: var(--teacher-card-radius);
  background: rgba(255, 255, 255, 0.72);
}

.page-state__title {
  font-family: var(--teacher-font-display);
  font-size: 42rpx;
  font-weight: 400;
}

.page-state__message {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: var(--teacher-muted);
}

.page-state__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--teacher-touch-min);
  margin: 26rpx 0 0;
  padding: 0 34rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 16rpx;
  background: var(--teacher-orange);
  font-size: 25rpx;
  color: #ffffff;
}

.lesson-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}

.lesson-row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  background: transparent;
  line-height: 1.25;
  text-align: left;
}

.lesson-row__toggle {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 32rpx 30rpx 24rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 38rpx;
  background: var(--teacher-orange);
  box-shadow: 0 4rpx 14rpx rgba(0, 32, 54, 0.30);
  line-height: 1.25;
  text-align: left;
}

.lesson-row--today .lesson-row__toggle {
  background: #2dc02d;
}

.lesson-row--hover {
  filter: brightness(1.08);
}

.lesson-row__main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  /* PSD 折叠卡实测 112px，配合 32/24rpx 内距取 109rpx。 */
  min-height: 109rpx;
}

.lesson-row__time {
  flex: none;
  display: flex;
  align-items: center;
}

.lesson-row__time-value {
  font-family: var(--teacher-font-display);
  font-size: 95rpx;
  font-weight: 400;
  line-height: 1.05;
  letter-spacing: 2rpx;
  color: #ffffff;
  /* 显示字体比 PSD 手写体宽约 12%，横向压缩 0.9 还原时间与校名之间的留白。 */
  transform: none;
  transform-origin: 0 50%;
}

.lesson-row__ident {
  display: flex;
  flex-direction: column;
  min-width: 0;
  max-width: 430rpx;
  margin-left: auto;
  text-align: right;
}

.lesson-row__campus,
.lesson-row__class {
  max-width: 100%;
  overflow-wrap: anywhere;
  font-family: var(--teacher-font-display);
  font-size: 37rpx;
  font-weight: 400;
  line-height: 48rpx;
  color: #ffffff;
}

.lesson-row__class {
  font-size: 37rpx;
  line-height: 48rpx;
}

.lesson-detail {
  position: relative;
  margin-top: 24rpx;
  padding: 18rpx 30rpx 18rpx 34rpx;
  box-sizing: border-box;
  border-radius: 38rpx;
  background: var(--teacher-orange);
  box-shadow: 0 4rpx 14rpx rgba(0, 32, 54, 0.30);
}

.lesson-detail__counts {
  display: flex;
  flex-direction: column;
  font-size: 35rpx;
  font-weight: 700;
  line-height: 50rpx;
  color: #ffffff;
}

.lesson-detail__counts text {
  min-width: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
}

.lesson-detail__warning {
  align-self: flex-start;
  padding: 0 10rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  min-width: 220rpx;
  min-height: var(--teacher-touch-min);
  margin: 36rpx 0 0;
  padding: 0 34rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 32rpx;
  color: #ffffff;
}

.control--hover {
  opacity: 0.72;
}
