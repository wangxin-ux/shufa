.schedule-page {
  padding-top: 28rpx;
  padding-bottom: 60rpx;
}

.schedule-overview {
  display: block;
}

.schedule-filter {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
}

.schedule-filter picker {
  flex: 1;
}

.schedule-filter__date,
.schedule-filter__clear,
.status-filter__item,
.page-state__retry,
.load-more {
  min-height: var(--teacher-touch-min);
  box-sizing: border-box;
}

.schedule-filter__date {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border: 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 14rpx rgba(66, 48, 15, 0.1);
  font-size: 27rpx;
}

.schedule-filter__date-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
}

.schedule-filter__clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--teacher-touch-min);
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--teacher-surface);
  box-shadow: 0 6rpx 14rpx rgba(66, 48, 15, 0.1);
  font-size: 42rpx;
  color: var(--teacher-orange);
}

.schedule-filter__clear::after,
.status-filter__item::after,
.lesson-row::after,
.page-state__retry::after,
.load-more::after {
  border: 0;
}

.status-filter {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.status-filter__inner {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 24rpx;
}

.status-filter__item {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.68);
  font-size: 25rpx;
  color: var(--teacher-muted);
}

.status-filter__item--active {
  background: var(--teacher-ink);
  font-weight: 700;
  color: #ffffff;
}

.lesson-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 32rpx;
}

.lesson-row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  min-height: 250rpx;
  margin: 0;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  border: 0;
  border-left: 8rpx solid var(--teacher-orange);
  border-radius: 16rpx;
  background: var(--teacher-surface);
  box-shadow: var(--teacher-shadow);
  line-height: 1.25;
  text-align: left;
}

.lesson-row--hover {
  background: rgba(255, 215, 94, 0.18);
}

.lesson-row--disabled {
  opacity: 0.62;
}

.lesson-row__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.lesson-row__date,
.lesson-row__course,
.lesson-row__class,
.lesson-row__campus {
  max-width: 100%;
  overflow-wrap: anywhere;
}

.lesson-row__date {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--teacher-muted);
}

.status-chip {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.status-chip--success {
  background: rgba(35, 135, 96, 0.12);
  color: var(--teacher-success);
}

.status-chip--warning {
  background: rgba(254, 132, 25, 0.14);
  color: #a04400;
}

.status-chip--muted {
  background: rgba(36, 59, 54, 0.09);
  color: var(--teacher-muted);
}

.status-chip--danger {
  background: rgba(201, 63, 72, 0.12);
  color: var(--teacher-danger);
}

.lesson-row__course {
  margin-top: 15rpx;
  font-family: var(--teacher-font-display);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--teacher-ink);
}

.lesson-row__class {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--teacher-ink);
}

.lesson-row__time {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  min-height: 64rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(254, 132, 25, 0.2);
  border-radius: 14rpx;
  background: rgba(255, 215, 94, 0.22);
  font-size: 23rpx;
  color: var(--teacher-muted);
}

.lesson-row__time-icon {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  margin-right: 10rpx;
}

.lesson-row__time-value {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--teacher-ink);
}

.lesson-row__campus {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--teacher-muted);
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 380rpx;
  margin-top: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: var(--teacher-card-radius);
  background: rgba(255, 255, 255, 0.72);
}

.page-state__title {
  font-family: var(--teacher-font-display);
  font-size: 42rpx;
  font-weight: 700;
}

.page-state__message {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: var(--teacher-muted);
}

.page-state__retry,
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 26rpx 0 0;
  padding: 0 34rpx;
  border: 0;
  border-radius: 16rpx;
  background: var(--teacher-orange);
  font-size: 25rpx;
  color: #ffffff;
}

.load-more {
  align-self: center;
  min-width: 220rpx;
}

.control--hover {
  opacity: 0.72;
}
