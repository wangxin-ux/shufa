<teacher-page-shell
  markTitle="课表"
  markIcon="/pages/teacher/assets/page-mark-pdf.png" markIconSize="44"
  tone="yellow"
  showBack="{{true}}"
>
  <view class="schedule-page">

    <view wx:if="{{refreshError}}" class="schedule-refresh" role="alert">
      <text>{{refreshError}}</text>
      <button class="schedule-refresh__retry" bindtap="onRetry" hover-class="control--hover">重试</button>
    </view>
    <view wx:if="{{viewState === 'loading'}}" class="page-state">
      <text class="page-state__title">正在加载课表</text>
    </view>
    <view wx:elif="{{viewState === 'forbidden'}}" class="page-state">
      <text class="page-state__title">无访问权限</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-state__retry" bindtap="onLogin" hover-class="control--hover">重新登录</button>
    </view>
    <view wx:elif="{{viewState === 'error'}}" class="page-state">
      <text class="page-state__title">课表加载失败</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-state__retry" bindtap="onRetry" hover-class="control--hover">重试</button>
    </view>
    <view wx:elif="{{viewState === 'empty'}}" class="page-state">
      <text class="page-state__title">当前筛选下暂无课次</text>
      <text class="page-state__message">可调整日期或状态后重新查看</text>
    </view>

    <view wx:else class="lesson-list">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="lesson-row {{item.isToday ? 'lesson-row--today' : ''}}"
      >
        <button
          class="lesson-row__toggle"
          data-id="{{item.id}}"
          bindtap="onToggleLesson"
          aria-expanded="{{expandedId === item.id}}"
          hover-class="lesson-row--hover"
        >
          <view class="lesson-row__main">
            <view class="lesson-row__time">
              <text class="lesson-row__time-value">{{item.startLabel}}</text>
            </view>
            <view class="lesson-row__ident">
              <text class="lesson-row__campus">{{item.campusName}}</text>
              <text class="lesson-row__class">{{item.className}}</text>
            </view>
          </view>
        </button>
        <view
          wx:if="{{expandedId === item.id}}"
          class="lesson-detail"
          data-id="{{item.id}}"
          aria-label="进入教学"
          bindtap="onLessonTap"
        >
          <view class="lesson-detail__counts">
            <text>{{item.rosterSummary.expectedLabel}}</text>
            <text>{{item.rosterSummary.leaveLabel}}</text>
            <text class="{{item.rosterSummary.hasWarning ? 'lesson-detail__warning' : ''}}">{{item.rosterSummary.warningLabel}}</text>
          </view>
        </view>
      </view>

      <button
        wx:if="{{hasMore}}"
        class="load-more"
        disabled="{{loadingMore}}"
        bindtap="onLoadMore"
        hover-class="control--hover"
      >{{loadingMore ? '加载中' : '查看更多'}}</button>
    </view>
  </view>
</teacher-page-shell>
