<teacher-page-shell
  markTitle="学员"
  markIcon="/pages/teacher/assets/page-mark-pdf.png" markIconSize="44"
  tone="yellow"
  showBack="{{true}}"
>
  <view class="students-page">
    <view class="student-utility"><button bindtap="onToggleSearch" aria-expanded="{{searchOpen}}">{{searchOpen ? '收起筛选' : '筛选'}}</button></view>
    <view wx:if="{{searchOpen}}" class="student-search">
      <image class="student-search__icon" src="/pages/teacher/assets/icon-student-record.png" mode="aspectFit" />
      <input
        class="student-search__input"
        value="{{searchValue}}"
        placeholder="搜索学员姓名"
        confirm-type="search"
        bindinput="onSearchInput"
      />
    </view>

    <view wx:if="{{viewState === 'loading'}}" class="page-state">
      <text class="page-state__title">正在加载学员</text>
    </view>
    <view wx:elif="{{viewState === 'forbidden'}}" class="page-state">
      <text class="page-state__title">无访问权限</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-state__retry" bindtap="onLogin">重新登录</button>
    </view>
    <view wx:elif="{{viewState === 'error'}}" class="page-state">
      <text class="page-state__title">学员加载失败</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-state__retry" bindtap="onRetry" hover-class="control--hover">重试</button>
    </view>
    <view wx:elif="{{viewState === 'empty'}}" class="page-state">
      <text class="page-state__title">暂无匹配学员</text>
      <text class="page-state__message">可清空或调整姓名关键词</text>
    </view>

    <view wx:else class="student-list">
      <view wx:if="{{refreshError || loadMoreError}}" class="page-state__message">
        <text>{{refreshError || loadMoreError}}</text>
        <button class="page-state__retry" bindtap="onRetry">重试</button>
      </view>
      <view wx:for="{{items}}" wx:key="id" class="student-row-group">
        <button class="student-row" data-id="{{item.id}}" bindtap="onStudentToggle" aria-expanded="{{expandedId === item.id}}" hover-class="student-row--hover">
          <text class="student-row__name {{item.displayName.length > 3 ? 'student-row__name--compact' : ''}}">{{item.displayName}}</text>
          <view class="student-row__facts"><text class="student-row__class">{{item.classLabel}}</text><text class="student-row__next">{{expandedId === item.id && archive ? '剩余 ' + archive.remainingTotalLabel : '查看课时 ›'}}</text></view>
        </button>
        <view wx:if="{{expandedId === item.id}}" class="student-preview">
          <text wx:if="{{archiveState === 'loading'}}" class="student-preview__message">正在加载档案</text>
          <view wx:elif="{{archiveState === 'error'}}" class="student-preview__message"><text>{{archiveError}}</text><button bindtap="onRetryPreview">重试</button></view>
          <block wx:elif="{{archive}}">
            <view class="student-preview__main"><image wx:if="{{archive.photoUrl && !archivePhotoFailed}}" class="student-preview__photo" src="{{archive.photoUrl}}" mode="aspectFill" binderror="onPreviewPhotoError" /><view wx:else class="student-preview__photo student-preview__photo--empty">暂无照片</view>
              <view class="student-preview__facts"><text>报名 {{archive.originalMainLabel}} {{archive.receivedLabel}}</text><text>剩余 {{archive.remainingTotalLabel}}</text><text>出勤率 {{archive.attendanceRateLabel}}</text><button class="student-preview__more" data-id="{{item.id}}" bindtap="onStudentTap">点击查看更多</button></view></view>
            <view wx:if="{{searchOpen}}"><text class="student-preview__meta">{{archive.balanceAsOfLabel}} · {{item.nextLessonShortLabel}}</text><text class="student-preview__meta">最近反馈 {{item.latestFeedbackLabel}}</text></view>
          </block>
        </view>
      </view>

      <button
        wx:if="{{hasMore}}"
        class="load-more"
        disabled="{{loadingMore}}"
        bindtap="onLoadMore"
        hover-class="control--hover"
      >{{loadingMore ? '加载中' : '加载更多'}}</button>
    </view>
  </view>
</teacher-page-shell>
