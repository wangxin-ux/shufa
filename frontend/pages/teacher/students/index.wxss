.students-page {
  padding-top: 28rpx;
  padding-bottom: 60rpx;
}

.students-page__overview {
  display: block;
}

.student-search {
  display: flex;
  align-items: center;
  min-height: var(--teacher-touch-min);
  padding: 0 24rpx;
  box-sizing: border-box;
  margin-top: 28rpx;
  border: 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 14rpx rgba(66, 48, 15, 0.1);
}

.student-search__icon {
  flex: none;
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
}

.student-search__input {
  flex: 1;
  min-width: 0;
  height: var(--teacher-touch-min);
  font-size: 27rpx;
}

.student-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 30rpx;
}

.student-row {
  display: block;
  width: 100%;
  margin: 0;
  min-height: 246rpx;
  padding: 27rpx 28rpx;
  box-sizing: border-box;
  border: 0;
  border-left: 8rpx solid var(--teacher-orange);
  border-radius: 16rpx;
  background: var(--teacher-surface);
  box-shadow: var(--teacher-shadow);
  line-height: 1.25;
  text-align: left;
  color: var(--teacher-ink);
}

.student-row::after {
  border: 0;
}

.student-row--hover {
  background: rgba(255, 215, 94, 0.22);
}

.student-row__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.student-row__name {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  font-family: var(--teacher-font-display);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
}

.student-row__count {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(35, 135, 96, 0.12);
  font-size: 20rpx;
  color: var(--teacher-success);
}

.student-row__classes {
  display: block;
  max-width: 100%;
  margin-top: 13rpx;
  overflow-wrap: anywhere;
  font-size: 24rpx;
  color: var(--teacher-muted);
}

.student-row__meta {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 25rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--teacher-line);
}

.student-row__meta-item {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.student-row__meta-label {
  font-size: 20rpx;
  color: var(--teacher-muted);
}

.student-row__meta-value {
  max-width: 100%;
  margin-top: 7rpx;
  overflow-wrap: anywhere;
  font-size: 23rpx;
  color: var(--teacher-ink);
}

.student-row__link {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  text-align: right;
  color: var(--teacher-orange);
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 380rpx;
  margin-top: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: var(--teacher-card-radius);
  background: rgba(255, 255, 255, 0.72);
}

.page-state__title {
  font-family: var(--teacher-font-display);
  font-size: 42rpx;
  font-weight: 700;
}

.page-state__message {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: var(--teacher-muted);
}

.page-state__retry,
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--teacher-touch-min);
  margin: 26rpx 0 0;
  padding: 0 34rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 16rpx;
  background: var(--teacher-orange);
  font-size: 25rpx;
  color: #ffffff;
}

.page-state__retry::after,
.load-more::after {
  border: 0;
}

.load-more {
  align-self: center;
  min-width: 220rpx;
}

.control--hover {
  opacity: 0.72;
}

@media (max-width: 380px) {
  .student-row__meta {
    grid-template-columns: minmax(0, 1fr);
  }
}
