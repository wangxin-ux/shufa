.students-page {
  position: relative;
  padding-top: 34rpx;
  padding-bottom: 60rpx;
}

.student-search {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 4rpx 12rpx rgba(120, 84, 20, 0.12);
}

.student-search__icon {
  flex: none;
  width: 38rpx;
  height: 38rpx;
  margin-right: 14rpx;
}

.student-search__input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  font-size: 26rpx;
}

.student-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 30rpx;
}

.student-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 164rpx;
  width: 100%;
  margin: 0;
  padding: 24rpx 32rpx 20rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 32rpx;
  background: var(--teacher-orange);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.3);
  line-height: 1.2;
  text-align: left;
  color: #ffffff;
}

.student-utility { position:absolute; top:0; right:0; }
.student-utility button { min-width:88rpx; min-height:44rpx; margin:0; padding:0; background:transparent; font-size:18rpx; line-height:44rpx; color:var(--teacher-muted); }
.student-utility button::after { border:0; }
.student-row .student-row__name--compact { font-size:64rpx; }
.student-preview { margin-top:26rpx; padding:24rpx 30rpx; border-radius:32rpx; background:var(--teacher-orange); box-shadow:var(--teacher-shadow); color:#fff; }
.student-preview__main { display:flex; align-items:flex-start; gap:20rpx; }
.student-preview__photo { flex:none; width:197rpx; height:263rpx; background:rgba(255,255,255,.25); }
.student-preview__photo--empty { display:flex; align-items:center; justify-content:center; font-size:20rpx; }
.student-preview__facts { flex:1; min-width:0; min-height:263rpx; display:flex; flex-direction:column; font-family:var(--teacher-font-display); font-size:32rpx; line-height:1.3; overflow-wrap:anywhere; }
.student-preview__meta { display:block; margin-top:10rpx; font-size:16rpx; line-height:1.4; }
.student-preview__message { display:block; padding:24rpx 0; font-size:26rpx; }
.student-preview__more { width:100%; min-height:88rpx; margin:auto 0 -8rpx; padding:0; background:transparent; font-family:var(--teacher-font-display); font-size:34rpx; color:#fff; }
.student-preview__more::after { border:0; }

.student-row::after {
  border: 0;
}

.student-row--hover {
  background: #ee7a11;
}

.student-row__main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.student-row__name {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  font-family: var(--teacher-font-display);
  font-size: 95rpx;
  font-weight: 400;
  line-height: 1.06;
  color: #ffffff;
}

.student-row__facts {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  max-width: 52%;
}

.student-row__class {
  max-width: 100%;
  overflow-wrap: anywhere;
  font-size: 30rpx;
  line-height: 1.4;
  text-align: right;
  color: #ffffff;
}

.student-row__next {
  max-width: 100%;
  overflow-wrap: anywhere;
  font-size: 26rpx;
  line-height: 1.4;
  text-align: right;
  color: rgba(255, 255, 255, 0.94);
}

.student-row__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 6rpx;
}

.student-row__feedback {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.86);
}

.student-row__link {
  flex: none;
  font-size: 16rpx;
  font-weight: 700;
  color: #ffffff;
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 380rpx;
  margin-top: 28rpx;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: var(--teacher-card-radius);
  background: rgba(255, 255, 255, 0.72);
}

.page-state__title {
  font-family: var(--teacher-font-display);
  font-size: 42rpx;
  font-weight: 400;
}

.page-state__message {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: var(--teacher-muted);
}

.page-state__retry,
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--teacher-touch-min);
  margin: 26rpx 0 0;
  padding: 0 34rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 16rpx;
  background: var(--teacher-orange);
  font-size: 25rpx;
  color: #ffffff;
}

.page-state__retry::after,
.load-more::after {
  border: 0;
}

.load-more {
  align-self: center;
  min-width: 220rpx;
  background: #ffffff;
  color: var(--teacher-orange);
  font-weight: 700;
}

.control--hover {
  opacity: 0.72;
}
