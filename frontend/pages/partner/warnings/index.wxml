<partner-page-shell
  markTitle="预警"
  markIcon="/pages/partner/assets/icon-warnings.png"
  showBack="{{true}}"
>
  <view class="partner-workspace warnings-page">
    <view class="partner-heading">
      <text class="partner-heading__title">课时预警</text>
      <text class="partner-heading__count">{{total}}人</text>
    </view>
    <text class="warning-note">预警标准由校区管理员设置</text>
    <view class="partner-search">
      <image class="partner-search__icon" src="/pages/partner/assets/icon-warnings.png" mode="aspectFit" />
      <input class="partner-search__input" value="{{query}}" placeholder="搜索学员姓名" maxlength="100" confirm-type="search" bindinput="onSearchInput" />
    </view>

    <view wx:if="{{viewState === 'loading'}}" class="partner-state"><text class="partner-state__title">正在加载课时预警</text></view>
    <view wx:elif="{{viewState === 'forbidden'}}" class="partner-state"><text class="partner-state__title">无访问权限</text><text class="partner-state__message">{{errorMessage}}</text></view>
    <view wx:elif="{{viewState === 'error'}}" class="partner-state"><text class="partner-state__title">课时预警加载失败</text><text class="partner-state__message">{{errorMessage}}</text><button class="partner-command" bindtap="onRetry">重试</button></view>
    <view wx:elif="{{viewState === 'empty'}}" class="partner-state"><text class="partner-state__title">暂无低课时学员</text><text class="partner-state__message">当前筛选范围内没有达到预警条件的学员</text></view>

    <view wx:else class="partner-list">
      <view wx:for="{{items}}" wx:key="studentId" class="partner-card warning-card">
        <view class="partner-card__head">
          <view class="partner-card__identity"><text class="partner-card__title">{{item.studentName}}</text><text class="partner-card__subtitle">{{item.classLabel}}</text><text wx:if="{{item.reservationLabel}}" class="partner-card__subtitle">{{item.reservationLabel}}</text></view>
          <text class="partner-card__status">{{item.urgencyLabel}}</text>
        </view>
        <view class="partner-card__meta">
          <view class="partner-metric"><text class="partner-metric__value">{{item.mainBalanceLabel}}</text><text class="partner-metric__label">主课时</text></view>
          <view class="partner-metric"><text class="partner-metric__value">{{item.giftBalanceLabel}}</text><text class="partner-metric__label">赠送课时</text></view>
          <view class="partner-metric partner-metric--accent"><text class="partner-metric__value">{{item.totalBalanceLabel}}</text><text class="partner-metric__label">合计课时</text></view>
        </view>
        <text class="partner-card__line">预警阈值 {{item.thresholdLabel}} 节</text>
      </view>
      <button wx:if="{{hasMore}}" class="partner-command partner-command--load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="onLoadMore">{{loadingMore ? '加载中' : '加载更多'}}</button>
    </view>
  </view>
</partner-page-shell>
