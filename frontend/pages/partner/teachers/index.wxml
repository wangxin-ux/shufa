<partner-approved-role-badge id="partner-identity-badge" blocked="{{viewState === 'forbidden'}}" />
<partner-page-shell
  markTitle="教师"
  markIcon="/pages/partner/assets/icon-teachers.png"
  showBack="{{true}}"
  waveImage="/pages/partner/assets/teachers-top-wave.png"
>
  <view class="partner-workspace teachers-page">
    <view class="partner-search teachers-search">
      <image class="partner-search__icon" src="/pages/partner/assets/icon-teachers.png" mode="aspectFit" aria-hidden="true" />
      <input class="partner-search__input" value="{{query}}" placeholder="搜索教师姓名" aria-label="搜索教师姓名" maxlength="100" confirm-type="search" bindinput="onSearchInput" />
      <button wx:if="{{query}}" class="teachers-search__clear" bindtap="onClearSearch" aria-label="清空教师姓名搜索" hover-class="partner-control--hover">×</button>
      <text class="teachers-search__count">{{total}}人</text>
    </view>

    <view wx:if="{{refreshError}}" class="teachers-refresh-error"><text class="partner-state__message">{{refreshError}}</text><button class="partner-command" bindtap="onRetry">重试刷新</button></view>
    <view wx:if="{{viewState === 'loading'}}" class="partner-state"><text class="partner-state__title">正在加载教师信息</text></view>
    <view wx:elif="{{viewState === 'forbidden'}}" class="partner-state"><text class="partner-state__title">无访问权限</text><text class="partner-state__message">{{errorMessage}}</text><button class="partner-command" bindtap="onLogin">重新登录</button></view>
    <view wx:elif="{{viewState === 'error'}}" class="partner-state"><text class="partner-state__title">教师信息加载失败</text><text class="partner-state__message">{{errorMessage}}</text><button class="partner-command" bindtap="onRetry">重试</button></view>
    <view wx:elif="{{viewState === 'empty'}}" class="partner-state"><text class="partner-state__title">暂无匹配教师</text><text class="partner-state__message">可清空或调整姓名关键词</text></view>

    <view wx:else class="partner-list">
      <view wx:for="{{items}}" wx:key="id" class="teacher-row">
        <button class="teacher-card__toggle" data-id="{{item.id}}" bindtap="onTeacherToggle" hover-class="partner-control--hover" aria-label="{{expandedId === item.id ? '收起' : '展开'}}{{item.displayName}}的教师信息" aria-expanded="{{expandedId === item.id}}">
          <text class="teacher-card__name" style="font-size: {{item.nameFontSize}}rpx;">{{item.displayName}}</text>
          <view class="teacher-card__identity">
            <text class="teacher-card__class-caption">所带班级</text>
            <text class="teacher-card__classes">{{item.classLabel}}</text>
          </view>
          <text class="teacher-card__chevron {{expandedId === item.id ? 'teacher-card__chevron--expanded' : ''}}" aria-hidden="true">⌄</text>
        </button>
        <view wx:if="{{expandedId === item.id}}" class="teacher-card__details">
          <teacher-performance id="teacher-performance-{{item.id}}" teacher-id="{{item.id}}" blocked="{{viewState === 'forbidden'}}" bind:forbidden="onPerformanceForbidden" />
          <view class="teacher-card__support">
            <view class="partner-card__head"><text class="partner-card__subtitle">{{item.employeeCodeLabel}}</text><text class="partner-card__status">在职</text></view>
            <text class="partner-card__line">擅长课程：{{item.specialtyLabel}}</text>
            <view class="teacher-card__metrics">
              <view class="teacher-card__metric"><text class="teacher-card__value">{{item.activeStudentCountLabel}}</text><text class="teacher-card__label">在读学员</text></view>
              <view class="teacher-card__metric"><text class="teacher-card__value">{{item.monthCompletedLessonCountLabel}}</text><text class="teacher-card__label">本月完成课次</text></view>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{paginationError}}" class="teachers-pagination-error"><text class="partner-state__message">{{paginationError}}</text><button class="partner-command" bindtap="onRetryMore">重试加载</button></view>
      <button wx:elif="{{hasMore}}" class="partner-command partner-command--load-more" loading="{{loadingMore}}" disabled="{{loadingMore || refreshError}}" bindtap="onLoadMore">{{loadingMore ? '加载中' : '加载更多'}}</button>
    </view>
  </view>
</partner-page-shell>
