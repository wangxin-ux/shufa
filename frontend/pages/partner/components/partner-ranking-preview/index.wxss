.ranking-preview {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  padding: 0;
  color: var(--partner-ink, #201d17);
  font-family: var(--partner-font-body, "Microsoft YaHei", sans-serif);
  letter-spacing: 0;
}

.ranking-preview__content {
  flex: 1;
  height: 0;
  min-height: 0;
  border-radius: 16rpx;
  background: #f6d468;
}

.ranking-preview__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ranking-preview__title {
  min-width: 0;
  font-family: var(--partner-font-display, "PartnerPdfDisplay", sans-serif);
  font-size: 64rpx;
  font-weight: 400;
  color: #ff7b10;
  line-height: 1.4;
}

.ranking-preview__all {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  gap: 12rpx;
  min-width: 104rpx;
  min-height: 56rpx;
  padding: 8rpx 12rpx;
  margin: 0;
  border-radius: 0;
  background: transparent;
  color: #5d3824;
  font-size: 24rpx;
}

.ranking-preview__all::after,
.ranking-preview__metric::after,
.ranking-preview__retry::after {
  border: 0;
}

.ranking-preview__metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border-bottom: 2rpx solid rgba(32, 29, 23, 0.16);
}

.ranking-preview__metric {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 64rpx;
  padding: 8rpx 4rpx;
  margin: 0;
  border-radius: 0;
  background: transparent;
  color: #595043;
  font-size: 24rpx;
  line-height: 1.4;
  white-space: normal;
  overflow-wrap: anywhere;
}

.ranking-preview__metric--active {
  box-shadow: inset 0 -4rpx var(--partner-orange, #ff7447);
  color: #8c301b;
}

.ranking-preview__status {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  padding: 8rpx 12rpx 0;
  font-size: 20rpx;
  line-height: 1.5;
}

.ranking-preview__meta {
  display: block;
  margin: 4rpx 12rpx;
  color: #595043;
  font-size: 20rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.ranking-preview__own {
  margin: 8rpx 0;
  padding-top: 6rpx;
  border-left: 4rpx solid var(--partner-orange, #ff7447);
  background: rgba(255, 255, 255, 0.55);
}

.ranking-preview__own > .ranking-preview__own-label {
  padding-left: 12rpx;
}

.ranking-preview__row {
  display: grid;
  grid-template-columns: 50rpx minmax(0, 1fr) 140rpx;
  align-items: center;
  gap: 10rpx;
  min-height: 64rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(32, 29, 23, 0.14);
  font-size: 24rpx;
  line-height: 1.5;
}

.ranking-preview__row--own {
  background: rgba(255, 255, 255, 0.55);
}

.ranking-preview__rank,
.ranking-preview__name,
.ranking-preview__delta {
  min-width: 0;
  overflow-wrap: anywhere;
}

.ranking-preview__rank {
  text-align: center;
}

.ranking-preview__delta {
  color: #595043;
  text-align: right;
  font-size: 22rpx;
}

.ranking-preview__delta--known {
  justify-self: end;
  min-width: 108.67rpx;
  max-width: 100%;
  min-height: 39.33rpx;
  padding: 4rpx 8rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #fe8419;
  color: #ffffff;
  font-size: 24.87rpx;
  text-align: center;
}

.ranking-preview__own-label {
  display: block;
  color: #77441d;
  font-size: 20rpx;
}

.ranking-preview__state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 12rpx;
  color: #595043;
  font-size: 24rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.ranking-preview__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  min-width: 160rpx;
  margin: 12rpx 0 0;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.65);
  color: #8c301b;
  font-size: 24rpx;
}
