.registration-form { min-width: 0; color: #201d17; font-size: 28rpx; line-height: 1.5; letter-spacing: 0; }
.registration-form__question { min-width: 0; padding: 24rpx 16rpx; border-bottom: 2rpx solid #edce68; background: #fff5cd; }
.registration-form__heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; margin-bottom: 18rpx; }
.registration-form__number { flex: 1; min-width: 0; padding-top: 14rpx; font-size: 28rpx; overflow-wrap: anywhere; }
.registration-form__tools { display: flex; flex: none; gap: 8rpx; }
.registration-form__tool { display: flex; align-items: center; justify-content: center; flex: none; width: 72rpx; height: 72rpx; min-height: 72rpx; margin: 0; padding: 0; box-sizing: border-box; border: 1rpx solid #f86114; border-radius: 8rpx; background: #fff; color: #a23c0c; font-size: 32rpx; line-height: 1; }
.registration-form__label { display: block; margin: 16rpx 0 10rpx; font-size: 26rpx; line-height: 1.5; }
.registration-form__input { display: block; width: 100%; min-width: 0; height: 88rpx; padding: 0 16rpx; box-sizing: border-box; border-radius: 8rpx; background: #fff; color: #201d17; font-size: 28rpx; line-height: 1.5; }
.registration-form__settings { display: grid; grid-template-columns: minmax(0, 1fr) 130rpx; align-items: start; gap: 16rpx; }
.registration-form__type { min-width: 0; }
.registration-form__picker { display: block; min-width: 0; }
.registration-form__control { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; height: 88rpx; padding: 0 16rpx; box-sizing: border-box; border-radius: 8rpx; background: #fff; font-size: 28rpx; line-height: 1.5; }
.registration-form__kind-label { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.registration-form__chevron { flex: none; }
.registration-form__required-control { width: 130rpx; }
.registration-form__switch { display: flex; align-items: center; height: 88rpx; }
.registration-form__options { margin-top: 16rpx; }
.registration-form__option-row { display: grid; grid-template-columns: minmax(0, 1fr) 72rpx; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.registration-form__add-option { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; margin: 16rpx 0 0; padding: 0; border-radius: 8rpx; background: #fff; color: #a23c0c; font-size: 32rpx; line-height: 1; }
.registration-form__add { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 20rpx 0 0; padding: 0 16rpx; box-sizing: border-box; border-radius: 8rpx; background: #f86114; color: #fff; font-size: 36rpx; line-height: 1.5; }
.registration-form__default { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 0; padding: 16rpx; box-sizing: border-box; border-radius: 8rpx; background: #fff; color: #a23c0c; font-size: 28rpx; line-height: 1.5; white-space: normal; }
.registration-form__title { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 600; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-all; }
.registration-form__required { flex: none; color: #a23c0c; font-size: 30rpx; }
.registration-form__hint { display: block; margin-bottom: 16rpx; font-size: 24rpx; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-all; }
.registration-form__choices { display: flex; flex-direction: column; gap: 12rpx; }
.registration-form__choice { display: flex; align-items: flex-start; gap: 12rpx; min-height: 72rpx; padding: 12rpx 0; box-sizing: border-box; }
.registration-form__option-label { flex: 1; min-width: 0; font-size: 28rpx; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-all; }
.registration-form__placeholder { color: #68625b; }
.registration-form__empty { display: block; padding: 20rpx 0; color: #68625b; font-size: 26rpx; }
