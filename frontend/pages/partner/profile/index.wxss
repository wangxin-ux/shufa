@import "../../../styles/partner-workspace.wxss";
@import "../styles/pdf-typography.wxss";

.profile-refresh-error {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 0;
  margin: 0 14rpx 16rpx;
  font-size: 22rpx;
  color: var(--partner-ink);
}

.profile-refresh-error text {
  min-width: 0;
  overflow-wrap: anywhere;
}

.profile-refresh-error .partner-command {
  flex: none;
  margin: 0;
}

.profile-page {
  position: relative;
  height: var(--profile-body-height);
  min-height: 0;
  padding: 62rpx 0 0;
  box-sizing: border-box;
  overflow: visible;
}

.profile-page--refresh-error,
.profile-page--more {
  height: auto;
  min-height: var(--profile-body-height);
  padding-bottom: max(42rpx, env(safe-area-inset-bottom));
}

.profile-page__footer {
  position: absolute;
  /* Cover the fractional pixel lost when the page body height is rounded down. */
  bottom: calc(-42rpx - 1px);
  left: calc(50% - 375rpx);
  z-index: 0;
  width: 750rpx;
  height: 240rpx;
  pointer-events: none;
}

.profile-page > .partner-state {
  position: relative;
  z-index: 1;
}

.profile-hero {
  position: relative;
  top: 8rpx;
  z-index: 2;
  height: 468rpx;
}

.profile-hero--refresh-error {
  margin-top: 120rpx;
}

.profile-card {
  position: absolute;
  bottom: 0;
  left: 22rpx;
  z-index: 1;
  width: 653rpx;
  max-width: 100%;
  min-height: 265rpx;
  padding: 62rpx 34rpx 34rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #fe8419;
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.profile-card__summary {
  position: absolute;
  right: 48rpx;
  bottom: 50rpx;
  left: 48rpx;
  z-index: 3;
}

.profile-card__summary--compact {
  right: auto;
  width: 210rpx;
}

.profile-card__name,
.profile-card__count {
  position: relative;
  z-index: 3;
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  color: #111111;
}

.profile-card__name {
  font-family: var(--partner-font-display);
  font-size: 54rpx;
  font-weight: 400;
  line-height: 1.18;
  max-height: 128rpx;
  overflow: auto;
}

.profile-card__count {
  margin-top: 14rpx;
  font-family: var(--partner-font-display);
  font-size: 48rpx;
  font-weight: 400;
}

.profile-hero__character {
  position: absolute;
  right: -32rpx;
  bottom: 0;
  z-index: 2;
  width: 470rpx;
  pointer-events: none;
}

.profile-details {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2rpx;
  width: 653rpx;
  max-width: 100%;
  margin: 36rpx 0 0 14rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(32, 29, 23, 0.1);
  box-shadow: 0 10rpx 20rpx rgba(24, 18, 14, 0.12);
}

.profile-detail {
  min-width: 0;
  min-height: 118rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.94);
}

.profile-detail__label,
.profile-detail__value {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
}

.profile-detail__label {
  font-size: 19rpx;
  color: var(--partner-muted);
}

.profile-detail__value {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.35;
  color: var(--partner-ink);
}

.profile-actions-stage {
  position: relative;
  z-index: 2;
  height: calc(100% - 522rpx);
  min-height: 0;
  margin-top: 54rpx;
  /* Align the menu without moving the approved lower artwork. */
  padding-top: 10rpx;
  box-sizing: border-box;
}

.profile-actions-stage__character {
  position: absolute;
  top: 110rpx;
  left: -32rpx;
  z-index: 0;
  width: 620rpx;
  pointer-events: none;
}

.profile-actions {
  position: relative;
  z-index: 2;
  width: 653rpx;
  max-width: 100%;
  margin-left: 22rpx;
  padding: 14rpx 0 20rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 215, 94, 0.84);
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.profile-action {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 16rpx 22rpx;
  box-sizing: border-box;
  border: 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 0;
  background: transparent;
  line-height: 1.2;
  text-align: left;
}

.profile-action:last-child {
  border-bottom: 0;
}

.profile-action::after {
  border: 0;
}

.profile-action__bullet {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  margin-right: 30rpx;
  border-radius: 50%;
  background: #2fbd82;
}

.profile-action__label {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-family: var(--partner-font-display);
  font-size: 33rpx;
  font-weight: 400;
  color: #243b36;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-action__command {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  min-height: 56rpx;
  margin-left: 14rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #fe8419;
  font-size: 23rpx;
  color: #ffffff;
}

.profile-actions > .profile-action {
  position: relative;
  min-height: 84rpx;
  padding: 14rpx 28rpx 14rpx 36rpx;
  border-bottom: 0;
}

.profile-actions > .profile-action::before {
  position: absolute;
  right: 28rpx;
  bottom: 0;
  left: 36rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.94);
  content: '';
  pointer-events: none;
}

.profile-actions > .profile-action:last-child::before {
  content: none;
}

.profile-actions .profile-action__bullet {
  width: 20rpx;
  height: 20rpx;
  margin-right: 42rpx;
}

.profile-actions .profile-action__command {
  min-width: 110rpx;
  min-height: 54rpx;
}

.profile-session {
  position: relative;
  z-index: 3;
  width: 653rpx;
  max-width: 100%;
  margin: 28rpx 0 0 14rpx;
}

.profile-control--hover {
  opacity: 0.72;
}

.profile-tools {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 140rpx;
  margin: 20rpx 14rpx 0;
}

.profile-more-toggle {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 144rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.94);
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--partner-ink);
}

.profile-more-toggle::after,
.profile-application::after {
  border: 0;
}

.profile-application {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1;
}

.profile-application__icon {
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.profile-more {
  position: relative;
  z-index: 4;
  width: calc(100% - 28rpx);
  height: max(240rpx, calc(var(--profile-body-height) - 1116rpx));
  margin: 24rpx 14rpx 0;
  background: rgba(255, 255, 255, 0.98);
}

.profile-page--refresh-error .profile-actions-stage,
.profile-page--more .profile-actions-stage {
  height: auto;
}

.profile-more .profile-details,
.profile-more .profile-session,
.profile-more .profile-secondary-actions {
  width: 100%;
  margin-left: 0;
}

.profile-more .profile-session {
  padding-bottom: 24rpx;
}

.profile-secondary-actions {
  width: 653rpx;
  max-width: 100%;
  margin: 16rpx 0 0 14rpx;
  background: rgba(255, 255, 255, 0.96);
}

.profile-secondary-actions .profile-action {
  min-height: 76rpx;
  border-bottom-color: rgba(32, 29, 23, 0.12);
}

.profile-secondary-actions .profile-action__label {
  font-size: 26rpx;
}

.profile-action__arrow {
  font-size: 36rpx;
  color: var(--partner-muted);
}
