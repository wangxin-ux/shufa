@import "../../../styles/partner-workspace.wxss";

.profile-page {
  position: relative;
  min-height: 100vh;
  padding: 62rpx 0 130rpx;
  box-sizing: border-box;
  overflow: visible;
}

.profile-page::after {
  position: absolute;
  top: calc(100vh - 260rpx);
  right: -32rpx;
  left: -32rpx;
  z-index: 0;
  height: 560rpx;
  border-radius: 48% 52% 0 0;
  background: var(--partner-yellow-top);
  content: '';
  pointer-events: none;
}

.profile-hero {
  position: relative;
  z-index: 2;
  height: 468rpx;
}

.profile-card {
  position: absolute;
  right: 14rpx;
  bottom: 0;
  left: 14rpx;
  z-index: 1;
  min-height: 270rpx;
  padding: 62rpx 34rpx 34rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #fe8419;
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.profile-card__name,
.profile-card__campus,
.profile-card__role {
  position: relative;
  z-index: 3;
  display: block;
  width: 365rpx;
  max-width: 58%;
  overflow-wrap: anywhere;
  color: #ffffff;
}

.profile-card__name {
  font-family: var(--partner-font-display);
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1.08;
}

.profile-card__campus {
  margin-top: 14rpx;
  font-family: var(--partner-font-display);
  font-size: 30rpx;
  font-weight: 700;
}

.profile-card__role {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.profile-hero__character {
  position: absolute;
  right: -32rpx;
  bottom: 0;
  z-index: 2;
  width: 470rpx;
  pointer-events: none;
}

.profile-details {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2rpx;
  width: 653rpx;
  max-width: 100%;
  margin: 36rpx 0 0 14rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(32, 29, 23, 0.1);
  box-shadow: 0 10rpx 20rpx rgba(24, 18, 14, 0.12);
}

.profile-detail {
  min-width: 0;
  min-height: 118rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.94);
}

.profile-detail__label,
.profile-detail__value {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
}

.profile-detail__label {
  font-size: 19rpx;
  color: var(--partner-muted);
}

.profile-detail__value {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.35;
  color: var(--partner-ink);
}

.profile-actions-stage {
  position: relative;
  z-index: 2;
  min-height: 830rpx;
  margin-top: 54rpx;
}

.profile-actions-stage__character {
  position: absolute;
  top: 110rpx;
  left: -32rpx;
  z-index: 0;
  width: 620rpx;
  pointer-events: none;
}

.profile-actions {
  position: relative;
  z-index: 2;
  width: 653rpx;
  max-width: 100%;
  margin-left: 14rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 215, 94, 0.84);
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.profile-action {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 16rpx 22rpx;
  box-sizing: border-box;
  border: 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 0;
  background: transparent;
  line-height: 1.2;
  text-align: left;
}

.profile-action:last-child {
  border-bottom: 0;
}

.profile-action::after {
  border: 0;
}

.profile-action__bullet {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  margin-right: 30rpx;
  border-radius: 50%;
  background: #2fbd82;
}

.profile-action__label {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-family: var(--partner-font-display);
  font-size: 33rpx;
  font-weight: 700;
  color: #243b36;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-action__command {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  min-height: 56rpx;
  margin-left: 14rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #fe8419;
  font-size: 23rpx;
  color: #ffffff;
}

.profile-session {
  position: relative;
  z-index: 3;
  width: 653rpx;
  max-width: 100%;
  margin: 28rpx 0 0 14rpx;
}

.profile-control--hover {
  opacity: 0.72;
}

@media (max-width: 380px) {
  .profile-card__name,
  .profile-card__campus,
  .profile-card__role {
    max-width: 54%;
  }

  .profile-card__name {
    font-size: 62rpx;
  }
}
