<partner-approved-role-badge id="partner-identity-badge" blocked="{{viewState === 'forbidden'}}" />
<partner-page-shell
  markTitle="我的"
  markIcon="/pages/partner/assets/profile-mark-glyph.png"
  showBack="{{true}}"
  surfacePage="{{true}}"
  plainMark="{{true}}"
>
  <view class="profile-page {{refreshError ? 'profile-page--refresh-error' : ''}} {{moreExpanded ? 'profile-page--more' : ''}}" style="--profile-body-height: {{profileBodyHeightPx}}px;">
    <image class="profile-page__footer" src="/pages/partner/assets/campaign-footer.png" mode="scaleToFill" aria-hidden="true" />
    <view wx:if="{{refreshError}}" class="profile-refresh-error"><text>{{refreshError}}</text><button class="partner-command" bindtap="onRetry">重试</button></view>
    <view wx:if="{{viewState === 'loading'}}" class="partner-state"><text class="partner-state__title">正在加载合作方资料</text></view>
    <view wx:elif="{{viewState === 'forbidden'}}" class="partner-state"><text class="partner-state__title">暂不可访问</text><text class="partner-state__message">{{errorMessage}}</text><button class="partner-command" bindtap="onLogin">重新登录</button></view>
    <view wx:elif="{{viewState === 'error'}}" class="partner-state"><text class="partner-state__title">合作方资料加载失败</text><text class="partner-state__message">{{errorMessage}}</text><button class="partner-command" bindtap="onRetry">重试</button></view>
    <view wx:elif="{{viewState === 'empty'}}" class="partner-state"><text class="partner-state__title">暂无合作方资料</text><text class="partner-state__message">请联系管理员核对账号与校区绑定</text></view>

    <block wx:else>
      <view class="profile-hero {{refreshError ? 'profile-hero--refresh-error' : ''}}">
        <view class="profile-card"></view>
        <image class="profile-hero__character" src="/pages/partner/assets/profile-top-character.png" mode="widthFix" aria-hidden="true" />
        <view class="profile-card__summary {{campusNameCompact ? 'profile-card__summary--compact' : ''}}"><scroll-view class="profile-card__name" scroll-y="{{true}}" style="font-size: {{campusNameFontSizeRpx}}rpx; height: {{campusNameHeightRpx}}rpx;"><text>{{campusName}}</text></scroll-view><text class="profile-card__count">{{activeStudentCountLabel}}</text></view>
      </view>

      <view class="profile-actions-stage">
        <image class="profile-actions-stage__character" src="/pages/partner/assets/profile-lower-character.png" mode="widthFix" aria-hidden="true" />
        <view class="profile-actions">
          <button wx:for="{{primaryActions}}" wx:key="key" class="profile-action" data-key="{{item.key}}" bindtap="onActionTap" hover-class="profile-control--hover"><view class="profile-action__bullet" aria-hidden="true"></view><text class="profile-action__label">{{item.label}}</text><text class="profile-action__command">查看</text></button>
        </view>
        <view class="profile-tools">
          <button class="profile-more-toggle" bindtap="onMoreToggle" aria-expanded="{{moreExpanded}}" aria-label="{{moreExpanded ? '收起更多与校区资料' : '展开更多与校区资料'}}" hover-class="profile-control--hover"><text>{{moreExpanded ? '收起' : '更多'}}</text><text aria-hidden="true">{{moreExpanded ? '−' : '＋'}}</text></button>
          <button id="profile-application" class="profile-application" data-key="application" bindtap="onActionTap" hover-class="profile-control--hover" aria-label="申请入驻"><image class="profile-application__icon" src="/pages/partner/assets/icon-application.png" mode="aspectFit" aria-hidden="true" /></button>
        </view>
        <scroll-view wx:if="{{moreExpanded}}" class="profile-more" scroll-y="{{true}}">
        <view class="profile-secondary-actions">
          <button wx:for="{{secondaryActions}}" wx:key="key" class="profile-action" data-key="{{item.key}}" bindtap="onActionTap" hover-class="profile-control--hover"><text class="profile-action__label">{{item.label}}</text><text class="profile-action__arrow" aria-hidden="true">›</text></button>
        </view>
        <view class="profile-details">
          <view class="profile-detail"><text class="profile-detail__label">{{identityLabel}}</text><text class="profile-detail__value">{{displayName}}</text></view>
          <view class="profile-detail"><text class="profile-detail__label">校区资料</text><text class="profile-detail__value">{{campusCodeLabel}}</text></view>
          <view class="profile-detail"><text class="profile-detail__label">联系电话</text><text class="profile-detail__value">{{contactPhoneLabel}}</text></view>
          <view class="profile-detail"><text class="profile-detail__label">校区地址</text><text class="profile-detail__value">{{addressLabel}}</text></view>
          <view class="profile-detail"><text class="profile-detail__label">课时预警阈值</text><text class="profile-detail__value">{{warningThresholdLabel}}</text></view>
        </view>
        <view class="profile-session">
          <session-logout id="sessionLogout" />
        </view>
        </scroll-view>
      </view>
    </block>
  </view>
</partner-page-shell>
