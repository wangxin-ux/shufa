.home {
  position: relative;
  min-height: calc(100vh - 150rpx);
  box-sizing: border-box;
}

.home__focus-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 96rpx;
  padding-top: 38rpx;
}

.home__title {
  min-width: 0;
  overflow-wrap: anywhere;
  font-family: var(--partner-font-display);
  font-size: 62rpx;
  font-weight: 700;
  line-height: 1.08;
  color: #ffffff;
}

.home__more,
.home__campaigns {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--role-home-more-height);
  margin: 0;
  padding: 0 var(--role-home-more-padding-x);
  box-sizing: border-box;
  border: var(--role-home-more-border);
  border-radius: 999rpx;
  background: transparent;
  font-size: var(--role-home-more-font-size);
  line-height: var(--role-home-more-height);
  color: #ffffff;
}

.page-state__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--partner-touch-min);
  margin: 0;
  box-sizing: border-box;
  border: 3rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 44rpx;
  background: transparent;
  font-size: 24rpx;
  color: #ffffff;
}

.home__more::after,
.home__campaigns::after,
.page-state__retry::after,
.focus::after,
.home__identity::after,
.quick-action::after {
  border: 0;
}

.focus {
  display: grid;
  grid-template-columns: 210rpx 4rpx minmax(0, 1fr);
  align-items: center;
  width: 100%;
  min-height: 250rpx;
  margin: 10rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--partner-ink);
  text-align: left;
}

.focus--hover,
.button--hover,
.quick-action--hover {
  opacity: 0.74;
}

.focus__count,
.focus__detail {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.focus__count {
  align-items: center;
}

.focus__number {
  position: relative;
  top: 20rpx;
  display: inline-block;
  max-width: 100%;
  padding-right: 34rpx;
}

.focus__value {
  max-width: 100%;
  overflow: hidden;
  font-family: var(--partner-font-display);
  font-size: 126rpx;
  font-weight: 700;
  line-height: 0.9;
  color: var(--partner-red);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.focus__unit {
  position: absolute;
  right: 0;
  bottom: 5rpx;
  font-family: var(--partner-font-display);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--partner-red);
}

.focus__label {
  margin-top: 8rpx;
  font-family: var(--partner-font-display);
  font-size: 38rpx;
  font-weight: 700;
  color: var(--partner-red);
}

.focus__divider {
  width: 4rpx;
  height: 132rpx;
  background: rgba(255, 255, 255, 0.96);
}

.focus__detail {
  justify-content: center;
  padding-left: 34rpx;
}

.focus__summary,
.focus__class {
  display: -webkit-box;
  max-width: 100%;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 25rpx;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.92);
  overflow-wrap: anywhere;
}

.focus__student {
  display: block;
  max-width: 100%;
  margin-top: 8rpx;
  overflow: hidden;
  font-family: var(--partner-font-display);
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.08;
  color: #ffffff;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.focus__class {
  margin-top: 5rpx;
  font-family: var(--partner-font-display);
  font-size: 26rpx;
  font-weight: 700;
}

.home__stage {
  position: relative;
  height: 752rpx;
  margin: -40rpx -32rpx 0;
  overflow: visible;
}

.home__character {
  position: absolute;
  top: -20rpx;
  left: 28rpx;
  z-index: 0;
  width: 700rpx;
  pointer-events: none;
}

.home__identity {
  position: absolute;
  right: 48rpx;
  bottom: 238rpx;
  left: 48rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-height: var(--partner-touch-min);
  margin: 0;
  padding: 8rpx 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--partner-ink);
  text-align: left;
}

.home__campus {
  display: block;
  width: 100%;
  overflow: hidden;
  font-family: var(--partner-font-display);
  font-size: 43rpx;
  font-weight: 700;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home__partner {
  display: block;
  width: 100%;
  margin-top: 5rpx;
  overflow: hidden;
  font-size: 22rpx;
  color: rgba(32, 29, 23, 0.68);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home__stats {
  position: absolute;
  right: var(--role-home-glass-right);
  bottom: 42rpx;
  left: var(--role-home-glass-left);
  z-index: 2;
}

.home__footer {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 148rpx;
  margin-top: 8rpx;
  padding: 0 12rpx 18rpx;
}

.quick-actions {
  position: relative;
  flex: none;
  display: flex;
  align-items: flex-start;
  width: var(--role-home-nav-width);
  height: var(--role-home-nav-active-size);
  overflow: visible;
  background: transparent;
}

.quick-actions::before {
  position: absolute;
  top: 17rpx;
  left: 0;
  width: var(--role-home-nav-capsule-width);
  height: var(--role-home-nav-capsule-height);
  border-radius: 999rpx;
  background: var(--role-home-nav-background);
  box-shadow: var(--role-home-nav-shadow);
  content: '';
  pointer-events: none;
}

.quick-action {
  position: relative;
  z-index: 1;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: var(--role-home-nav-item-width);
  min-width: var(--role-home-nav-item-width);
  min-height: var(--partner-touch-min);
  margin: 23rpx 0 0;
  padding: 4rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.15;
}

.quick-action:first-child {
  margin-left: 4rpx;
}

.quick-action--active {
  width: var(--role-home-nav-active-size);
  min-width: var(--role-home-nav-active-size);
  height: var(--role-home-nav-active-size);
  min-height: var(--role-home-nav-active-size);
  margin: 0 0 0 -13rpx;
  border-radius: 50%;
  background: var(--role-home-nav-active-background);
  box-shadow: var(--role-home-nav-active-shadow);
}

.quick-action__icon {
  width: 43rpx;
  height: 43rpx;
  pointer-events: none;
}

.quick-action__label {
  max-width: 100%;
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 16rpx;
  color: var(--role-home-nav-ink);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-action--active .quick-action__icon {
  width: 54rpx;
  height: 56rpx;
}

.quick-action--active .quick-action__label {
  font-size: 16rpx;
  font-weight: 600;
  color: var(--role-home-nav-ink);
}

.home__campaigns {
  flex: none;
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 600rpx;
  padding: 70rpx 18rpx;
}

.page-state__title {
  max-width: 100%;
  overflow-wrap: anywhere;
  font-family: var(--partner-font-display);
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

.page-state__message {
  max-width: 100%;
  margin-top: 18rpx;
  overflow-wrap: anywhere;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.84);
}

.page-state__retry {
  margin-top: 28rpx;
  padding: 0 30rpx;
}

@media (min-width: 420px) {
  .home__character {
    left: 48rpx;
  }

  .focus__detail {
    padding-left: 42rpx;
  }
}
