@import "../styles/pdf-typography.wxss";

page {
  --partner-shell-wave-filter: drop-shadow(0 5rpx 17rpx rgba(24, 18, 14, 0.28));
}

.home {
  position: relative;
  min-height: var(--partner-body-height, calc(100vh - 150rpx));
  box-sizing: border-box;
}

.home__refresh-error {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  color: #ffffff;
  font-size: 24rpx;
}

.home__refresh-error text {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}

.home__refresh-error button {
  flex: none;
  margin: 0;
  padding: 0 20rpx;
  border: 2rpx solid #ffffff;
  border-radius: 8rpx;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: 56rpx;
}

.home__refresh-error button::after {
  border: 0;
}

.home__focus-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 96rpx;
  padding-top: 38rpx;
  padding-left: 16rpx;
}

.home__title {
  min-width: 0;
  overflow-wrap: anywhere;
  font-family: var(--partner-font-display);
  font-size: 64rpx;
  font-weight: 400;
  line-height: 1.08;
  transform: translateY(-8rpx);
  color: #ffffff;
}

.home__more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--role-home-more-height);
  margin: 0;
  padding: 0 var(--role-home-more-padding-x);
  box-sizing: border-box;
  border: var(--role-home-more-border);
  border-radius: 999rpx;
  background: transparent;
  font-size: var(--role-home-more-font-size);
  line-height: var(--role-home-more-height);
  color: #ffffff;
}

.page-state__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--partner-touch-min);
  margin: 0;
  box-sizing: border-box;
  border: 3rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 44rpx;
  background: transparent;
  font-size: 24rpx;
  color: #ffffff;
}

.home__more::after,
.home__application::after,
.page-state__retry::after,
.focus::after,
.home__identity::after,
.quick-action::after {
  border: 0;
}

.focus {
  display: grid;
  overflow: visible;
  grid-template-columns: 230rpx 4rpx minmax(0, 1fr);
  align-items: center;
  width: 100%;
  min-height: 250rpx;
  margin: 10rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--partner-ink);
  text-align: left;
}

.focus--hover,
.button--hover,
.quick-action--hover {
  opacity: 0.74;
}

.focus__count,
.focus__detail {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.focus__count {
  align-self: start;
  align-items: center;
}

.focus__number {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 137rpx;
  max-width: 100%;
}

.focus__value {
  display: block;
  max-width: 100%;
  overflow: hidden;
  font-family: var(--partner-font-display);
  font-size: 152rpx;
  font-weight: 400;
  line-height: 0.9;
  color: var(--partner-red);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.focus__label {
  margin-top: 14rpx;
  font-family: var(--partner-font-body);
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 400;
  color: var(--partner-red);
}

.focus__divider {
  width: 4rpx;
  height: 132rpx;
  background: rgba(255, 255, 255, 0.96);
}

.focus__detail {
  align-self: start;
  justify-content: center;
  margin-top: -22rpx;
  /* Keep growing text clear of the figure's 110rpx overhang. */
  margin-bottom: 122rpx;
  padding-left: 34rpx;
}

.focus__summary,
.focus__class {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.92);
}

.focus__enrollment {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 12rpx;
  min-height: 34rpx;
  max-width: 100%;
  font-size: 21rpx;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.92);
}

.focus__enrollment text {
  min-width: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
}

.focus__student {
  display: block;
  max-width: 100%;
  margin-top: 8rpx;
  overflow: hidden;
  font-family: var(--partner-font-display);
  font-size: 74rpx;
  font-weight: 400;
  line-height: 1.08;
  color: #ffffff;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.focus__class {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  margin-top: 0;
  font-family: var(--partner-font-display);
  font-size: 26rpx;
  font-weight: 400;
}

.focus__student-row {
  display: flex;
  align-items: flex-end;
  min-width: 0;
}

.focus__courses {
  max-height: 64rpx;
  overflow-y: auto;
  margin-top: 6rpx;
}

.focus__course,
.focus__attendance {
  display: block;
  font-size: 21rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
  color: rgba(255, 255, 255, 0.92);
}

.focus__attendance {
  margin-top: 4rpx;
}

.focus__student-row .focus__student {
  flex: 0 1 auto;
  max-width: 62%;
}

.focus__student--empty {
  font-size: 40rpx;
}

.home__stage {
  position: relative;
  height: 752rpx;
  margin: -40rpx -32rpx 0;
  overflow: visible;
}

.home__character {
  position: absolute;
  top: -70rpx;
  left: 91rpx;
  z-index: 0;
  width: 658rpx;
  pointer-events: none;
}

.home__identity {
  position: absolute;
  right: 48rpx;
  bottom: 238rpx;
  left: 48rpx;
  z-index: 3;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 18rpx;
  min-height: var(--partner-touch-min);
  margin: 0;
  padding: 8rpx 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--partner-ink);
  text-align: left;
}

.home__campus {
  display: block;
  min-width: 0;
  max-width: calc(100% - 100rpx);
  overflow: hidden;
  font-family: var(--partner-font-display);
  font-size: 64rpx;
  font-weight: 400;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home__partner {
  display: block;
  flex: none;
  margin-top: 0;
  overflow: hidden;
  font-size: 26rpx;
  font-family: var(--partner-font-display);
  font-weight: 400;
  color: #000000;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home__stats {
  position: absolute;
  right: var(--role-home-glass-right);
  bottom: 60rpx;
  left: var(--role-home-glass-left);
  z-index: 2;
}

.home__footer {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 148rpx;
  margin-top: -2rpx;
  padding: 0 12rpx 18rpx;
}

.quick-actions {
  position: relative;
  margin-left: 10rpx;
  flex: none;
  display: flex;
  align-items: flex-start;
  width: var(--role-home-nav-width);
  height: var(--role-home-nav-active-size);
  overflow: visible;
  background: transparent;
}

.quick-actions::before {
  position: absolute;
  top: 17rpx;
  left: 0;
  width: var(--role-home-nav-capsule-width);
  height: var(--role-home-nav-capsule-height);
  border-radius: 999rpx;
  background: var(--role-home-nav-background);
  box-shadow: var(--role-home-nav-shadow);
  content: '';
  pointer-events: none;
}

.quick-action {
  position: relative;
  z-index: 1;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: var(--role-home-nav-item-width);
  min-width: var(--role-home-nav-item-width);
  min-height: var(--partner-touch-min);
  margin: 23rpx 0 0;
  padding: 4rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.15;
}

.quick-action:first-child {
  margin-left: 4rpx;
}

.quick-action--active {
  width: var(--role-home-nav-active-size);
  min-width: var(--role-home-nav-active-size);
  height: var(--role-home-nav-active-size);
  min-height: var(--role-home-nav-active-size);
  margin: 0 0 0 -13rpx;
  border-radius: 50%;
  background: var(--role-home-nav-active-background);
  box-shadow: var(--role-home-nav-active-shadow);
}

.quick-action__icon {
  width: 43rpx;
  height: 43rpx;
  pointer-events: none;
}

.quick-action__label {
  max-width: 100%;
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 16rpx;
  color: var(--role-home-nav-ink);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-action--active .quick-action__icon {
  width: 54rpx;
  height: 56rpx;
}

.quick-action--active .quick-action__label {
  font-size: 16rpx;
  font-weight: 600;
  color: var(--role-home-nav-ink);
}

.home__application {
  position: absolute;
  right: -14rpx;
  bottom: max(18rpx, calc(env(safe-area-inset-bottom) - 42rpx));
  z-index: 4;
  width: 140rpx;
  height: 140rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1;
}

.home__application-icon {
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 600rpx;
  padding: 70rpx 18rpx;
}

.page-state__title {
  max-width: 100%;
  overflow-wrap: anywhere;
  font-family: var(--partner-font-display);
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

.page-state__message {
  max-width: 100%;
  margin-top: 18rpx;
  overflow-wrap: anywhere;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.84);
}

.page-state__retry {
  margin-top: 28rpx;
  padding: 0 30rpx;
}
.home__menu-toggle {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  margin: 0 0 0 auto;
  padding: 14rpx;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

.home__menu-bars {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
}

.home__menu-bars view {
  height: 3rpx;
  background: #ffffff;
}

.home__menu-toggle::after,
.home-menu button::after {
  border: 0;
}

.home-menu-backdrop {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  background: rgba(30, 24, 18, 0.38);
}

.home-menu {
  width: 100%;
  padding: 24rpx 32rpx max(24rpx, env(safe-area-inset-bottom));
  background: #fffdf7;
  box-sizing: border-box;
}

.home-menu__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  color: var(--partner-ink);
  font-size: 30rpx;
  font-weight: 700;
}

.home-menu__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #efeee9;
  color: #53534e;
  font-size: 38rpx;
  line-height: 1;
}

.home-menu__body {
  height: 650rpx;
  max-height: 65vh;
}

.home-menu__entries {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 24rpx;
}

.home-menu__entries--secondary {
  margin-top: 16rpx;
  border-top: 2rpx solid #dedbd0;
}

.home-menu__entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
  width: 100%;
  min-height: 96rpx;
  margin: 0;
  padding: 16rpx 0;
  border: 0;
  border-bottom: 1rpx solid #e8e4da;
  border-radius: 0;
  background: transparent;
  color: var(--partner-ink);
  font-size: 26rpx;
  line-height: 1.4;
  text-align: left;
}

.home-menu__entry text:first-child {
  min-width: 0;
  overflow-wrap: anywhere;
}

.home-menu__entry--primary {
  font-weight: 700;
  color: #963b20;
}
