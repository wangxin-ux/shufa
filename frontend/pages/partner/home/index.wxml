<partner-page-shell
  markTitle="首页"
  markIcon="/pages/partner/assets/home-mark-glyph.png"
>
  <view class="home">
    <view wx:if="{{viewState === 'loading'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">正在加载校区经营数据</text>
    </view>

    <view wx:elif="{{viewState === 'forbidden'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">无访问权限</text>
      <text class="page-state__message">{{errorMessage}}</text>
    </view>

    <view wx:elif="{{viewState === 'error'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">经营数据加载失败</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-state__retry" bindtap="onRetry" hover-class="button--hover">重试</button>
    </view>

    <view
      wx:elif="{{viewState === 'ready' || viewState === 'empty'}}"
      class="home__content home__content--{{viewState}}"
    >
      <view class="home__focus-head">
        <text class="home__title">重点关注</text>
        <button
          class="home__more"
          data-key="warnings"
          bindtap="onActionTap"
          hover-class="button--hover"
        >查看更多</button>
      </view>

      <button
        class="focus"
        data-key="warnings"
        bindtap="onActionTap"
        hover-class="focus--hover"
        aria-label="进入课时预警"
      >
        <view class="focus__count">
          <view class="focus__number">
            <text class="focus__value">{{highlightValue}}</text>
            <text class="focus__unit">{{highlightUnit}}</text>
          </view>
          <text class="focus__label">剩余课时</text>
        </view>
        <view class="focus__divider" aria-hidden="true"></view>
        <view class="focus__detail">
          <text class="focus__summary">{{highlightSummary}}</text>
          <text class="focus__student">{{highlightStudent}}</text>
          <text class="focus__class">{{highlightClass}}</text>
        </view>
      </button>

      <view class="home__stage">
        <image
          class="home__character"
          src="/pages/partner/assets/home-character.png"
          mode="widthFix"
          aria-hidden="true"
        />
        <button
          class="home__identity"
          data-key="profile"
          bindtap="onActionTap"
          hover-class="button--hover"
          aria-label="进入合作方我的页面"
        >
          <text class="home__campus">{{campusName}}</text>
          <text class="home__partner">{{partnerName}} · 合作方</text>
        </button>
        <partner-stat-strip class="home__stats" items="{{stats}}" />
      </view>

      <view class="home__footer">
        <view class="quick-actions">
          <button
            wx:for="{{actions}}"
            wx:key="key"
            class="quick-action {{item.key === 'students' ? 'quick-action--active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onActionTap"
            hover-class="quick-action--hover"
          >
            <image class="quick-action__icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" />
            <text class="quick-action__label">{{item.label}}</text>
          </button>
        </view>
        <button
          class="home__campaigns"
          data-key="more"
          bindtap="onActionTap"
          hover-class="button--hover"
          aria-label="进入活动中心"
        >查看更多</button>
      </view>
    </view>
  </view>
</partner-page-shell>
