@import "../../../styles/partner-workspace.wxss";

.campaign-page {
  padding-top: 8rpx;
}

.campaign-head__eyebrow,
.campaign-head__title,
.campaign-head__subtitle,
.campaign-card__course,
.campaign-card__title,
.campaign-card__description {
  display: block;
}

.campaign-head__eyebrow {
  font-size: 21rpx;
  font-weight: 700;
  color: #9c470d;
}

.campaign-head__title {
  margin-top: 6rpx;
  font-family: var(--partner-font-display);
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.12;
  color: var(--partner-ink);
}

.campaign-head__subtitle {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--partner-muted);
}

.campaign-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 28rpx;
}

.campaign-card {
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  background: rgba(255, 253, 248, 0.94);
  box-shadow: 0 12rpx 24rpx rgba(76, 48, 20, 0.14);
}

.campaign-card--pressed {
  opacity: 0.82;
}

.campaign-card__visual {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  background: #f3c64b;
}

.campaign-card__cover {
  width: 100%;
  height: 100%;
}

.campaign-card__fallback {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  padding: 36rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, #ffd75e, #fe8419);
  color: #4f1c0d;
}

.campaign-card__fallback-course {
  font-size: 24rpx;
  font-weight: 700;
}

.campaign-card__fallback-title {
  margin-top: 10rpx;
  font-family: var(--partner-font-display);
  font-size: 52rpx;
  font-weight: 700;
}

.campaign-card__status {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(36, 30, 25, 0.74);
  font-size: 20rpx;
  color: #ffffff;
}

.campaign-card__body {
  padding: 26rpx 28rpx 28rpx;
}

.campaign-card__course {
  font-size: 21rpx;
  font-weight: 700;
  color: #9c470d;
}

.campaign-card__title {
  margin-top: 10rpx;
  overflow-wrap: anywhere;
  font-family: var(--partner-font-display);
  font-size: 35rpx;
  font-weight: 700;
  color: var(--partner-ink);
}

.campaign-card__description {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--partner-muted);
}

.campaign-card__facts {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 22rpx;
}

.campaign-card__price {
  flex: none;
  font-family: var(--partner-font-display);
  font-size: 42rpx;
  font-weight: 700;
  color: #e85c1a;
}

.campaign-card__deadline {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 20rpx;
  color: var(--partner-muted);
  text-align: right;
}

.campaign-card__command {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  margin-top: 22rpx;
  border-radius: 36rpx;
  background: var(--partner-orange);
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

.load-more {
  align-self: center;
}

button::after {
  border: 0;
}
