@import "../../../styles/partner-workspace.wxss";
@import "../styles/pdf-typography.wxss";

.campaign-page {
  position: relative;
  min-height: var(--partner-body-height);
  margin: 0 17rpx;
  /* Reserve the full 519rpx-wide figure, its overhang, and a content gap. */
  padding: 48rpx 0 calc(638.37rpx - 42rpx + 28rpx);
}

.campaign-page__footer {
  position: absolute;
  bottom: -42rpx;
  left: calc(50% - 375rpx);
  z-index: 0;
  width: 750rpx;
  height: 240rpx;
  pointer-events: none;
}

.campaign-page__character {
  position: absolute;
  bottom: -42rpx;
  left: -88rpx;
  z-index: 0;
  width: 519rpx;
  pointer-events: none;
}

.campaign-head,
.campaign-kinds,
.campaign-phases,
.campaign-refresh-error,
.campaign-list,
.campaign-page > .partner-state {
  position: relative;
  z-index: 1;
  width: 652rpx;
  max-width: 100%;
  margin-left: 8rpx;
  box-sizing: border-box;
}

.campaign-head { min-height: 152rpx; }
.campaign-create {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
  min-height: 152rpx;
  margin: 0;
  padding: 24rpx 30rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 32rpx;
  background: #fe8419;
  box-shadow: 0 9rpx 16rpx rgba(24, 18, 14, 0.19);
  font-family: var(--partner-font-display);
  font-size: 46rpx;
  font-weight: 400;
  line-height: 1.25;
  color: #111111;
  text-align: left;
}
.campaign-create > text:first-child { min-width: 0; overflow-wrap: anywhere; }
.campaign-create__icon { flex: none; font-size: 56rpx; line-height: 1; }
.campaign-kinds { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4rpx 16rpx; margin-top: 20rpx; }
.campaign-kind { display: flex; align-items: center; gap: 8rpx; min-height: 76rpx; font-size: 26rpx; line-height: 1.4; }
.campaign-kind radio { flex: none; }
.campaign-kind > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.campaign-draft__title, .campaign-draft__type, .campaign-draft__time { display: block; overflow-wrap: anywhere; }
.campaign-draft__title { font-family: var(--partner-font-display); font-size: 42rpx; line-height: 1.25; }
.campaign-draft__type { margin-top: 8rpx; font-size: 24rpx; }
.campaign-draft__time { margin-top: 8rpx; font-size: 21rpx; line-height: 1.45; color: var(--partner-muted); }
.campaign-draft__review, .campaign-draft__notice, .campaign-draft__reason {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.campaign-draft__notice { color: var(--partner-muted); }
.campaign-draft__reason { color: #990a04; }

.campaign-card__course,
.campaign-card__title,
.campaign-card__description {
  display: block;
}

.campaign-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 28rpx;
}

.campaign-phases {
  display: flex;
  margin-top: 24rpx;
  border-bottom: 2rpx solid rgba(44, 66, 64, 0.2);
}

.campaign-phase {
  flex: 1;
  margin: 0;
  height: 76rpx;
  border-radius: 0;
  border-bottom: 4rpx solid transparent;
  background: transparent;
  font-size: 28rpx;
  line-height: 72rpx;
  color: var(--partner-muted);
}

.campaign-phase::after { border: none; }
.campaign-phase--active { border-bottom-color: var(--partner-ink); color: var(--partner-ink); }

.campaign-refresh-error,
.campaign-pagination-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--partner-ink);
}

.campaign-refresh-error text,
.campaign-pagination-error text {
  min-width: 0;
  overflow-wrap: anywhere;
}

.campaign-refresh-error .partner-command,
.campaign-pagination-error .partner-command {
  flex: none;
  margin: 0;
}

.campaign-card,
.campaign-draft {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  min-height: 152rpx;
  padding: 24rpx 26rpx 24rpx 30rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #f6d468;
  box-shadow: 0 9rpx 16rpx rgba(24, 18, 14, 0.19);
}

.campaign-row__main {
  flex: 1;
  min-width: 0;
}

.campaign-row__action {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  min-height: 108rpx;
  padding: 14rpx 22rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: #fe8419;
  font-family: var(--partner-font-display);
  font-size: 30rpx;
  line-height: 1.2;
  color: #111111;
  text-align: center;
  overflow-wrap: anywhere;
}

.campaign-card--pressed { opacity: 0.82; }

.campaign-card__course {
  font-size: 21rpx;
  margin-top: 8rpx;
  color: #9c470d;
}

.campaign-card__title {
  overflow-wrap: anywhere;
  font-family: var(--partner-font-display);
  font-size: 42rpx;
  line-height: 1.25;
  color: var(--partner-ink);
}

.campaign-card__description {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--partner-muted);
}

.campaign-card__facts {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.campaign-card__price {
  flex: none;
  font-family: var(--partner-font-display);
  max-width: 100%;
  overflow-wrap: anywhere;
  font-size: 32rpx;
  color: #9c470d;
}

.campaign-card__deadline {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 20rpx;
  color: var(--partner-muted);
}

.load-more {
  align-self: center;
}

button::after {
  border: 0;
}
