<partner-page-shell
  markTitle="活动中心"
  markIcon="/pages/partner/assets/profile-mark-glyph.png"
  showBack="{{true}}"
  plainGradient="{{true}}"
>
  <view class="partner-workspace campaign-page">
    <view class="campaign-head">
      <text class="campaign-head__eyebrow">本校区活动</text>
      <text class="campaign-head__title">招生推广</text>
      <text class="campaign-head__subtitle">使用总部配置的活动素材开展本校区招生</text>
    </view>

    <view wx:if="{{viewState === 'loading'}}" class="partner-state">
      <text class="partner-state__title">正在加载活动</text>
    </view>
    <view wx:elif="{{viewState === 'forbidden'}}" class="partner-state">
      <text class="partner-state__title">无访问权限</text>
      <text class="partner-state__message">{{errorMessage}}</text>
    </view>
    <view wx:elif="{{viewState === 'error'}}" class="partner-state">
      <text class="partner-state__title">活动加载失败</text>
      <text class="partner-state__message">{{errorMessage}}</text>
      <button class="partner-command" bindtap="onRetry">重试</button>
    </view>
    <view wx:elif="{{viewState === 'empty'}}" class="partner-state">
      <text class="partner-state__title">暂无可推广活动</text>
      <text class="partner-state__message">本校区当前没有正在进行的拼团活动</text>
    </view>

    <view wx:elif="{{viewState === 'ready'}}" class="campaign-list">
      <view
        class="campaign-card"
        wx:for="{{campaigns}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onOpen"
        hover-class="campaign-card--pressed"
      >
        <view class="campaign-card__visual">
          <image
            wx:if="{{item.posterImages.length}}"
            class="campaign-card__cover"
            src="{{item.posterImages[0].accessUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="campaign-card__fallback">
            <text class="campaign-card__fallback-course">{{item.courseName}}</text>
            <text class="campaign-card__fallback-title">限时拼团</text>
          </view>
          <text class="campaign-card__status">推广中</text>
        </view>
        <view class="campaign-card__body">
          <text class="campaign-card__course">{{item.courseName}}</text>
          <text class="campaign-card__title">{{item.title}}</text>
          <text class="campaign-card__description">{{item.description}}</text>
          <view class="campaign-card__facts">
            <text class="campaign-card__price">{{item.priceLabel}}</text>
            <text class="campaign-card__deadline">{{item.deadlineLabel}}</text>
          </view>
          <view class="campaign-card__command">查看活动 <text>›</text></view>
        </view>
      </view>
      <button
        wx:if="{{hasMore}}"
        class="partner-command load-more"
        loading="{{loadingMore}}"
        disabled="{{loadingMore}}"
        bindtap="onReachBottom"
      >{{loadingMore ? '加载中' : '加载更多'}}</button>
    </view>
  </view>
</partner-page-shell>
