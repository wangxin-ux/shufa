@import "../styles/pdf-typography.wxss";

.application {
  min-height: 100vh;
  background: #fff;
  color: #24352f;
  font-family: var(--partner-font-body);
}
.application__header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 88rpx;
  padding-left: 28rpx;
  padding-bottom: 18rpx;
}
.application__back {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 var(--role-back-size);
  width: var(--role-back-size);
  height: var(--role-back-size);
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: var(--role-back-background);
  box-shadow: var(--role-back-shadow);
  color: #24352f;
  font-size: 52rpx;
  line-height: 1;
}
.application button::after { border: 0; }
.application__icon { flex: 0 0 46rpx; width: 46rpx; height: 46rpx; }
.application__role { font-size: 28rpx; }
.application__body {
  padding: 16rpx 36.67rpx calc(48rpx + env(safe-area-inset-bottom)) 58.67rpx;
}
.application__title {
  display: block;
  margin-bottom: 28rpx;
  color: #fe8419;
  font-family: var(--partner-font-display);
  font-size: 64rpx;
  line-height: 1.2;
  letter-spacing: 0;
}
.application__identity {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin: 0 0 24rpx;
}
.application__identity-name { flex: 1; min-width: 0; overflow-wrap: anywhere; font-size: 26rpx; }
.application__status { flex-shrink: 0; font-size: 24rpx; color: #54705f; }
.application__stage {
  position: relative;
  margin-bottom: 24rpx;
  padding-bottom: 81.33rpx;
}
.application__stage--empty { padding-bottom: 0; }
.application__character {
  position: absolute;
  right: -36.67rpx;
  bottom: 0;
  width: 518rpx;
  height: 617.33rpx;
  pointer-events: none;
}
.application__panel {
  position: relative;
  z-index: 1;
  padding: 30rpx 32rpx;
  border-radius: 12rpx;
  background: #f5d671;
}
.application__character-clip {
  position: absolute;
  inset: 0;
  overflow: hidden;
  border-radius: inherit;
  pointer-events: none;
}
.application__character--muted { bottom: -81.33rpx; opacity: 0.25098; }
.application__panel-content { position: relative; }
.application__panel--empty { padding: 0; background: transparent; }
.application__form { padding: 0; }
.application__basics--saved { margin-top: 24rpx; padding-top: 24rpx; border-top: 2rpx solid rgba(255, 255, 255, 0.9); }
.application__section-title { display: block; font-size: 32rpx; font-weight: 700; line-height: 1.4; }
.application__field { margin-top: 28rpx; }
.application__label { display: block; margin-bottom: 14rpx; font-family: var(--partner-font-display); font-size: 34rpx; font-weight: 400; }
.application__input, .application__region-value, .application__address {
  width: 100%;
  box-sizing: border-box;
  border-radius: 10rpx;
  background: #fff;
  color: #24352f;
  font-size: 28rpx;
}
.application__input { height: 88rpx; padding: 0 20rpx; }
.application__region-row { display: flex; gap: 8rpx; align-items: center; }
.application__region { flex: 1; min-width: 0; }
.application__region-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 20rpx;
  overflow-wrap: anywhere;
}
.application__region-value text:first-child { flex: 1; min-width: 0; }
.application__placeholder { color: #858c87; }
.application__clear {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 80rpx;
  margin: 0;
  padding: 0;
  line-height: 80rpx;
  font-size: 36rpx;
  color: #24352f;
  background: transparent;
}
.application__address { min-height: 160rpx; padding: 20rpx; line-height: 1.55; }
.application__feedback { min-height: 48rpx; margin: 22rpx 0 12rpx; font-size: 24rpx; line-height: 1.5; }
.application__message { display: block; color: #a52e25; overflow-wrap: anywhere; }
.application__unsaved { color: #54705f; }
.application__primary, .application__reload {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  margin: 0 0 20rpx;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  font-size: 30rpx;
  line-height: 1.4;
  background: #ff8614;
  color: #fff;
}
.application__reload { background: #e4f0e8; color: #245139; }
.application__logout {
  margin: 0;
  padding: 18rpx;
  background: transparent;
  color: #54705f;
  font-size: 26rpx;
}
.application__state { padding-top: 48rpx; font-size: 28rpx; }
.application__state .application__message { margin: 24rpx 0; }
.application__hover { opacity: 0.72; }
.application__bank { margin: 24rpx 0 0; padding: 24rpx 0 0; border-top: 2rpx solid rgba(255, 255, 255, 0.9); }
.application__bank-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 88rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 16rpx 0;
  background: transparent;
  color: #24352f;
  text-align: left;
  font-size: 32rpx;
  line-height: 1.4;
}
.application__bank-status { display: block; padding: 24rpx 0; font-size: 26rpx; }
.application__bank-fields {
  display: grid;
  grid-template-columns: minmax(0, 2.04fr) minmax(0, 1fr) minmax(0, 1.93fr);
  gap: 12rpx;
  margin: 0 -20rpx;
}
.application__bank-fields .application__field { min-width: 0; margin-top: 16rpx; }
.application__bank-fields .application__label { min-height: 40rpx; font-size: 28rpx; line-height: 1.4; overflow-wrap: anywhere; }
.application__materials { margin: 24rpx 0 0; padding-top: 24rpx; border-top: 2rpx solid rgba(255, 255, 255, 0.9); }
.application__materials--documents { margin: 0; padding: 0; border-top: 0; }
.application__material-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.application__material-row { min-width: 0; padding: 16rpx 0; }
.application__material-row--wide { grid-column: 1 / -1; border-top: 2rpx solid rgba(255, 255, 255, 0.9); }
.application__material-heading { display: flex; flex-direction: column; align-items: stretch; gap: 14rpx; }
.application__material-heading .application__label { min-width: 0; margin: 0; overflow-wrap: anywhere; }
.application__material-add, .application__material-remove {
  display: flex; align-items: center; justify-content: center; padding: 0; margin: 0;
  flex: 0 0 72rpx; width: 72rpx; height: 72rpx; line-height: 1; font-size: 40rpx;
  background: #e4f0e8; color: #245139; border-radius: 8rpx;
}
.application__material-add {
  position: relative;
  flex: none;
  width: 100%;
  height: 213.33rpx;
  border-radius: 12rpx;
  background: #fe8419;
  color: #ffbc81;
  font-size: 0;
}
.application__material-add::before, .application__material-add::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  display: block;
  width: 88rpx;
  height: 24rpx;
  border-radius: 6rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
  pointer-events: none;
}
.application__material-add::after { width: 24rpx; height: 88rpx; }
.application__material-add--compact::before, .application__material-add--compact::after { display: none; }
.application__material-row--wide .application__material-add { max-width: 420rpx; margin: 0 auto; }
.application__material-heading--filled { flex-direction: row; align-items: center; justify-content: space-between; }
.application__material-heading--filled .application__label { flex: 1; }
.application__material-heading--filled .application__material-add--compact {
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 72rpx;
  margin: 0;
  border-radius: 8rpx;
  color: #fff;
  font-family: var(--partner-font-body);
  font-size: 26rpx;
}
.application__material-files { display: flex; flex-wrap: wrap; gap: 20rpx; padding-top: 16rpx; }
.application__material-file { position: relative; flex: 1 1 180rpx; min-width: 0; width: 180rpx; max-width: 100%; }
.application__material-preview {
  display: flex; flex-direction: column; justify-content: center; gap: 8rpx;
  width: 100%; height: 256rpx; margin: 0; padding: 12rpx; box-sizing: border-box;
  background: #f1f5f2; border: 2rpx solid #b8cfc0; border-radius: 8rpx; color: #24352f;
}
.application__material-image { display: block; width: 100%; height: 128rpx; }
.application__material-empty { display: block; padding: 24rpx 0; font-size: 24rpx; color: #54705f; }
.application__material-file-label { min-height: 88rpx; padding-top: 20rpx; font-size: 24rpx; line-height: 1.4; overflow-wrap: anywhere; }
.application__material-caption { display: block; font-size: 22rpx; line-height: 1.4; overflow-wrap: anywhere; }
.application__material-remove { margin: 8rpx auto 0; width: 72rpx; height: 64rpx; background: transparent; }
.application__material-outstanding { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; padding: 16rpx 0; font-size: 24rpx; }
.application__material-recover { margin: 0; padding: 14rpx 18rpx; font-size: 24rpx; line-height: 1.4; background: #e4f0e8; color: #245139; border-radius: 8rpx; }
 .application__history { margin: 20rpx 0; }
 .application__history-row { padding: 14rpx 0; border-bottom: 1rpx solid rgba(0, 0, 0, 0.12); }
 .application__history-row text { display: block; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
