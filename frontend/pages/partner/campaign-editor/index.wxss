@import "../styles/pdf-typography.wxss";

.editor { min-height: 100vh; background: #fff; color: #24352f; font-family: var(--partner-font-body); }
.editor__header { position: fixed; top: 0; left: 0; right: 0; z-index: 7; background: #fff; display: flex; align-items: center; gap: 18rpx; min-height: 88rpx; padding-left: 28rpx; padding-bottom: 18rpx; }
.editor__back {
  display: flex; align-items: center; justify-content: center;
  flex: 0 0 var(--role-back-size); width: var(--role-back-size); height: var(--role-back-size);
  margin: 0; padding: 0; border-radius: 50%; background: var(--role-back-background);
  box-shadow: var(--role-back-shadow); font-size: var(--role-back-icon-size); color: #24352f; line-height: 1;
}
.editor__icon { flex: none; width: 38rpx; height: 38rpx; }
.editor__role { font-size: 24rpx; overflow-wrap: anywhere; }
.editor__body { width: 653.33rpx; max-width: calc(100% - 64rpx); margin: 22rpx auto 0; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.editor__title { display: block; margin-bottom: 28rpx; font-family: var(--partner-font-display); font-size: 64rpx; font-weight: 400; line-height: 1.2; color: #fe8419; letter-spacing: 0; }
.editor__identity { display: flex; justify-content: space-between; gap: 20rpx; margin-bottom: 18rpx; font-size: 28rpx; }
.editor__stage { position: relative; padding-bottom: 160rpx; }
.editor__character { position: absolute; right: -48.33rpx; bottom: 0; width: 518rpx; height: 617.33rpx; pointer-events: none; }
.editor__panel { position: relative; z-index: 1; min-width: 0; padding: 28rpx 32rpx 34rpx; border-radius: 21.333333rpx; background: #f5d671; box-shadow: 0 6.67rpx 8rpx rgba(24, 18, 14, 0.28); }
.editor__character-clip { position: absolute; inset: 0; overflow: hidden; border-radius: inherit; pointer-events: none; }
.editor__character--muted { right: -40.33rpx; bottom: -159.33rpx; width: 522rpx; height: 621.33rpx; opacity: 0.14902; }
.editor__panel-content { position: relative; }
.editor__form { min-width: 0; }
.editor__field + .editor__field { margin-top: 32rpx; }
.editor__label-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.editor__label { display: block; min-width: 0; margin-bottom: 16rpx; font-family: var(--partner-font-display); font-size: 34rpx; font-weight: 400; line-height: 1.4; overflow-wrap: anywhere; }
.editor__count { flex: none; font-size: 24rpx; color: #52665b; }
.editor__input, .editor__description {
  width: 100%; box-sizing: border-box; border-radius: 10rpx;
  background: #fff; color: #24352f; font-size: 28rpx; line-height: 1.5;
}
.editor__input { height: 88rpx; padding: 0 20rpx; }
.editor__description { min-height: 200rpx; padding: 20rpx; }
.editor__content { min-height: 320rpx; }
.editor__image-frame { position: relative; width: 100%; height: 0; background: #fff; }
.editor__image-frame--cover { padding-top: 150%; }
.editor__image-frame--share { padding-top: 75%; }
.editor__image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.editor__image-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; margin: 32rpx 0; }
.editor__image-slot { min-width: 0; }
.editor__image-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-top: 16rpx; }
.editor__image-actions .editor__secondary { flex: 1 1 100%; min-width: 0; width: 100%; margin-bottom: 0; }
.editor__image-actions .editor__clear-time { margin-bottom: 0; }
.editor__image-actions .editor__image-empty { min-height: 220rpx; border: 0; background: #fe8419; color: #ffbc81; }
.editor__image-plus { position: relative; flex: none; width: 88rpx; height: 88rpx; font-size: 0; line-height: 0; pointer-events: none; }
.editor__image-plus::before, .editor__image-plus::after {
  content: ""; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: 88rpx; height: 24rpx; border-radius: 6rpx; background: currentColor; pointer-events: none;
}
.editor__image-plus::after { width: 24rpx; height: 88rpx; }
.editor__image-size { display: block; margin-top: 10rpx; font-size: 22rpx; line-height: 1.4; text-align: center; color: #52665b; }
.editor__types { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx 16rpx; }
.editor__type { display: flex; align-items: center; gap: 12rpx; min-height: 56rpx; font-size: 28rpx; }
.editor__type radio { flex: none; }
.editor__type text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.editor__feedback { min-height: 60rpx; margin: 24rpx 0 12rpx; font-size: 24rpx; line-height: 1.5; }
.editor__message { display: block; color: #a52e25; overflow-wrap: anywhere; }
.editor__state { padding: 48rpx 0; font-size: 28rpx; line-height: 1.6; }
.editor__primary, .editor__secondary {
  display: flex; align-items: center; justify-content: center; width: 100%;
  min-height: 88rpx; margin: 0; padding: 14rpx 20rpx; box-sizing: border-box;
  border-radius: 10rpx; font-size: 28rpx; line-height: 1.5; overflow-wrap: anywhere;
}
.editor__primary { background: #f86114; color: #fff; }
.editor__secondary { margin-bottom: 18rpx; border: 2rpx solid #f86114; background: #fff; color: #a23c0c; }
.editor__primary[disabled], .editor__secondary[disabled] { opacity: .6; }
.editor__pressed { opacity: .82; }
button::after { border: 0; }
.editor__free { margin-top: 32rpx; padding-top: 28rpx; border-top: 2rpx solid rgba(255, 255, 255, 0.9); }
.editor__timezone { display: block; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; margin: 12rpx 0; }
.editor__time-controls { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: 12rpx; }
.editor__picker { min-width: 0; }
.editor__picker-value { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; height: 88rpx; padding: 0 16rpx; box-sizing: border-box; border-radius: 10rpx; background: #fff; color: #24352f; font-size: 28rpx; line-height: 1.5; }
.editor__picker-value text { min-width: 0; white-space: nowrap; }
.editor__picker-value--empty { color: #52665b; }
.editor__clear-time { flex: none; min-height: 56rpx; margin: 0 0 16rpx; padding: 8rpx 12rpx; border-radius: 0; background: transparent; color: #a23c0c; font-size: 24rpx; line-height: 1.5; }
.editor__clear-time[disabled] { opacity: .6; }
.editor__capacity { margin-top: 20rpx; }
.editor__copy { margin-top: 24rpx; }
.editor__tabs { display: flex; margin-top: 32rpx; border-bottom: 2rpx solid #edce68; }
.editor__tab { flex: 1; min-width: 0; min-height: 80rpx; margin: 0; padding: 16rpx 8rpx; border-radius: 0; background: #fff; font-size: 28rpx; line-height: 1.5; color: #52665b; }
.editor__tab--active { border-bottom: 4rpx solid #f86114; color: #a23c0c; }
.editor__record { padding: 24rpx 0; border-bottom: 1rpx solid #e4e9e6; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.editor__record > text { display: block; margin-top: 10rpx; }
.editor__record-heading { display: flex; justify-content: space-between; gap: 16rpx; font-size: 28rpx; }
.editor__record-heading text:first-child { flex: 1; min-width: 0; }
.editor__record-heading text:last-child { flex: none; }
.editor__mode-tabs { margin: 0 0 28rpx; }
.editor__mode-tabs .editor__tab[disabled] { opacity: .6; }
.editor__preview { min-width: 0; }
.editor__preview-title { display: block; margin-top: 28rpx; font-family: var(--partner-font-display); font-size: 44rpx; line-height: 1.4; overflow-wrap: anywhere; }
.editor__preview-type { display: block; margin: 12rpx 0 28rpx; font-size: 26rpx; color: #a23c0c; }
.editor__preview-section { padding: 24rpx 0; border-top: 1rpx solid #e4e9e6; }
.editor__preview-label { display: block; margin-bottom: 12rpx; font-size: 24rpx; color: #52665b; }
.editor__preview-label--next { margin-top: 24rpx; }
.editor__preview-description { display: block; font-size: 28rpx; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; }
.editor__preview .editor__secondary { margin-top: 24rpx; }
