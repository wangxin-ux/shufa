@import "../../../styles/parent-pdf.wxss";
@import "../styles/pdf-typography.wxss";

.profile {
  position: relative;
  isolation: isolate;
  padding: 24rpx 0 100rpx;
}

.profile::before {
  content: '';
  position: absolute;
  left: -160rpx;
  right: -160rpx;
  bottom: -180rpx;
  height: 230rpx;
  border-radius: 50% 50% 0 0;
  background: var(--parent-pdf-bottom-gradient);
  transform: rotate(7deg);
  z-index: -1;
  pointer-events: none;
}

/* 原稿下半页的绿衣背包狗背景装饰 */
.profile__backdrop {
  position: absolute;
  top: 370rpx;
  left: 50%;
  z-index: 0;
  width: 1050rpx;
  transform: translateX(-61%);
  pointer-events: none;
}

.tap-hover {
  opacity: 0.72;
}

.profile__hero {
  position: relative;
  z-index: 1;
  height: 507rpx;
}

.profile__mascot {
  position: absolute;
  top: -68rpx;
  left: 50%;
  z-index: 1;
  width: 496rpx;
  transform: translateX(-31%);
  pointer-events: none;
}

.profile__student-card-bg,
.profile__student-card {
  position: absolute;
  left: 14rpx;
  bottom: 0;
  width: 653rpx;
  min-height: 265rpx;
  box-sizing: border-box;
  border-radius: 40rpx;
}

.profile__student-card-bg {
  z-index: 0;
  background: var(--parent-orange);
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.profile__student-card {
  z-index: 2;
  display: flex;
  align-items: baseline;
  padding: 136rpx 34rpx 24rpx;
  color: var(--parent-on-color);
}

/* 入口卡压在背景装饰之上 */
.profile parent-action-card {
  position: relative;
  z-index: 2;
  display: block;
  width: 653rpx;
  margin-top: 54rpx;
  margin-left: 14rpx;
  box-sizing: border-box;
  border-radius: var(--parent-card-radius);
  background-color: #ffd650;
  --parent-yellow-card: transparent;
  --parent-action-card-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.profile__menu-surface {
  position: absolute;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  border-radius: var(--parent-card-radius);
  pointer-events: none;
}

.profile__menu-backdrop {
  position: absolute;
  top: -215rpx;
  left: calc(50% - 646rpx);
  width: 1050rpx;
}

.profile__menu-surface::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255, 214, 80, 0.84);
}

.profile__student-name {
  flex: 0 1 auto;
  min-width: 0;
  max-width: 480rpx;
  font-size: 95rpx;
  font-family: var(--parent-font-display);
  line-height: 1.1;
  font-weight: 400;
  overflow-wrap: anywhere;
  white-space: normal;
}

.profile__student-age {
  flex: none;
  margin-left: 18rpx;
  font-size: 63rpx;
  font-family: var(--parent-font-display);
  font-weight: 400;
}

.profile__empty {
  font-size: 44rpx;
  font-weight: 700;
}

.actions {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
}

.actions__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82rpx;
  gap: 24rpx;
  border-bottom: 4rpx solid #ffffff;
}

.actions__row:last-child {
  border-bottom: none;
}

.actions__label-wrap {
  display: flex;
  align-items: center;
  min-width: 0;
}

.actions__dot {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  margin-right: 40rpx;
  border-radius: 50%;
  background: var(--parent-success);
}

.actions__label {
  font-size: 34rpx;
  font-family: var(--parent-font-display);
  font-weight: 400;
  color: var(--parent-ink);
}

.actions__button {
  flex: none;
  min-width: 108rpx;
  min-height: 55rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  line-height: 55rpx;
  text-align: center;
  font-size: 24rpx;
  background: var(--parent-orange);
  color: var(--parent-on-color);
}

.profile__refresh-error {
  position: relative;
  z-index: 2;
  margin: 20rpx 14rpx 0;
  font-size: 24rpx;
  color: var(--parent-ink);
}
.profile__refresh-error button {
  display: inline-block;
  margin: 0 0 0 20rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #bf5600;
  font-size: 24rpx;
  line-height: 1.5;
}
.profile__refresh-error button::after { border: none; }

@media (max-width: 350px) {
  .actions__label {
    font-size: 30rpx;
  }
}
