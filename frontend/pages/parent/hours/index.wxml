<parent-page-shell class="hours-shell" markTitle="课时" markIcon="/pages/parent/assets/icon-mark-hours.png" bg="yellow" showBack="{{true}}" showWave="{{false}}">
  <view-state
    wx:if="{{viewState !== 'ready'}}"
    state="{{viewState}}"
    errorText="{{errorMessage}}"
    bind:retry="onRetry"
  />

  <view wx:else class="hours">
    <text class="hours__title">课时账户</text>

    <view class="balance-card {{remainingTotal >= 100 || paidAmountLabel.length > 10 ? 'balance-card--long' : ''}}">
      <text class="balance-card__label">{{hasReservations ? '可用课时' : '剩余课时'}}</text>
      <view class="balance-card__value-row">
        <text class="balance-card__value" style="font-size: {{balanceValueSize || 155}}rpx;">{{remainingTotal}}</text>
        <text class="balance-card__unit">节</text>
      </view>
      <view class="balance-card__meta">
        <view class="balance-card__meta-row">
          <text class="balance-card__meta-label">报名金额</text>
          <text class="balance-card__meta-value">{{paidAmountLabel}}</text>
        </view>
        <view class="balance-card__meta-row">
          <text class="balance-card__meta-label">有效期</text>
          <text class="balance-card__meta-value">{{validUntilLabel || '待确认'}}</text>
        </view>
      </view>
      <view class="balance-card__mascot-frame" aria-hidden="true">
        <image class="balance-card__mascot" src="/pages/parent/assets/hours-mascot.png" mode="widthFix" />
      </view>
      <view class="balance-card__renew">
        <parent-primary-button id="parent-hours-renew" topText="立即" bottomText="续费" theme="deep" bind:tap="onRenewTap" />
      </view>
    </view>

    <view class="hour-cards {{hourCards.length === 1 ? 'hour-cards--single' : ''}}">
      <block wx:for="{{hourCards}}" wx:key="key">
        <text wx:if="{{index === 1}}" class="hour-cards__plus">+</text>
        <view class="hour-card">
          <text class="hour-card__label">{{item.label}}</text>
          <view class="hour-card__value-row {{item.hasKnownGrant ? '' : 'hour-card__value-row--unknown'}}">
            <text class="hour-card__value {{item.grantedLabel.length >= 3 ? 'hour-card__value--compact' : ''}}" style="font-size: {{item.valueSize}}rpx;">{{item.grantedLabel}}</text>
            <text wx:if="{{item.hasKnownGrant}}" class="hour-card__unit">节</text>
          </view>
          <text class="hour-card__sub">剩余 {{item.remaining}} 节课</text>
        </view>
      </block>
    </view>

    <view wx:if="{{hasReservations}}" class="hours__refund-status">
      <text class="hours__refund-title">退课处理中</text>
      <text class="hours__refund-line">购买 {{reservedPaidHours}} 节 · 赠送 {{reservedGiftHours}} 节</text>
      <text class="hours__refund-line">账面剩余 {{grossTotal}} 节</text>
    </view>

    <view class="ledger">
      <view class="ledger__head">
        <text class="ledger__title">课时流水</text>
        <button class="ledger__filter-toggle" bindtap="onToggleFilters">筛选</button>
      </view>
      <view wx:if="{{showFilters}}" class="ledger__filter-panel">
        <picker mode="selector" range="{{subjectOptions}}" value="{{subjectIndex}}" bindchange="onSubjectChange">
          <view class="ledger__subject">{{subjectOptions[subjectIndex]}} <text>⌄</text></view>
        </picker>
        <view class="ledger__filters">
          <view
            wx:for="{{filters}}"
            wx:key="key"
            class="ledger__filter {{activeFilter === item.key ? 'ledger__filter--active' : ''}}"
            data-filter="{{item.key}}"
            bindtap="onFilterTap"
            hover-class="tap-hover"
          >{{item.label}}</view>
        </view>
      </view>

      <view-state wx:if="{{isEmpty}}" state="empty" emptyText="当前筛选下暂无课时流水" />
      <view wx:else class="ledger__card {{showFilters ? 'ledger__card--filtered' : ''}}">
        <image class="ledger__mascot" src="/pages/parent/assets/hours-ledger-mascot.png" mode="widthFix" aria-hidden="true" />
        <view class="ledger__panel">
          <block wx:for="{{entries}}" wx:key="id">
            <view wx:if="{{index > 0}}" class="ledger__divider" aria-hidden="true"></view>
            <parent-record-card
              flat="{{true}}"
              title="{{item.title}}"
              subtitle="{{item.subtitleLabel}}"
              tagText="{{item.deltaLabel}}"
              tagTone="orange"
              dotColor="{{item.delta > 0 ? '#fe8419' : '#23b574'}}"
            />
          </block>
        </view>
      </view>
      <button wx:if="{{hasMore}}" class="ledger__load-more" disabled="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '正在加载…' : paginationError ? '重试加载' : '加载更多'}}</button>
      <text wx:if="{{paginationError}}" class="ledger__page-error">{{paginationError}}</text>
    </view>
  </view>
</parent-page-shell>
