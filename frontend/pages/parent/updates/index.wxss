.updates {
  padding: 76rpx 0 72rpx;
}

.updates__heading {
  margin-bottom: 34rpx;
}

.updates__title,
.updates__subtitle {
  display: block;
}

.updates__title {
  font-size: 60rpx;
  font-family: var(--parent-font-display);
  line-height: 1.15;
  font-weight: 800;
  color: var(--parent-orange);
}

.updates__subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(42, 35, 30, 0.62);
}

.updates__list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.update-card {
  position: relative;
  padding: 30rpx 30rpx 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.82);
  border-left: 8rpx solid var(--parent-orange);
  border-radius: 18rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(255, 248, 226, 0.94));
  box-shadow: 0 14rpx 26rpx rgba(99, 70, 28, 0.16), 0 3rpx 7rpx rgba(99, 70, 28, 0.08), inset 0 2rpx 0 rgba(255, 255, 255, 0.96);
}

.update-card__head,
.update-card__course,
.update-card__attendance {
  display: flex;
  align-items: center;
}

.update-card__head,
.update-card__attendance {
  justify-content: space-between;
  gap: 24rpx;
}

.update-card__course {
  min-width: 0;
  gap: 14rpx;
}

.update-card__dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--parent-orange);
}

.update-card__name {
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #2a231e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.update-card__status {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.update-card__status--green {
  background: rgba(35, 181, 116, 0.14);
  color: #168358;
}

.update-card__status--gray {
  background: rgba(107, 111, 110, 0.14);
  color: #666b69;
}

.update-card__meta {
  display: block;
  margin: 12rpx 0 20rpx 26rpx;
  font-size: 23rpx;
  color: rgba(42, 35, 30, 0.58);
}

.update-card__attendance {
  padding: 18rpx 0;
  border-top: 2rpx solid rgba(42, 35, 30, 0.08);
  border-bottom: 2rpx solid rgba(42, 35, 30, 0.08);
}

.update-card__label {
  flex: none;
  font-size: 24rpx;
  font-weight: 600;
  color: #7d5a3e;
}

.update-card__value {
  font-size: 26rpx;
  color: #2a231e;
}

.update-card__feedback {
  margin-top: 22rpx;
}

.update-card__feedback-text {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #2a231e;
  word-break: break-all;
}

.update-card__images {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.update-card__image {
  display: block;
  width: 100%;
  height: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
  background: rgba(42, 35, 30, 0.08);
}
