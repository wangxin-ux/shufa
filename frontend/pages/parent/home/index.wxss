@import "../../../styles/parent-pdf.wxss";
@import "../styles/pdf-typography.wxss";

parent-page-shell {
  --parent-yellow: var(--parent-pdf-home-gradient);
  --parent-shell-wave-top: 0;
  --parent-shell-wave-left: 0;
  --parent-shell-wave-width: 100%;
  --parent-shell-wave-height: 240rpx;
  --parent-shell-wave-radius: 0;
  --parent-shell-wave-transform: none;
  --parent-shell-wave-origin: center;
  --parent-shell-wave-filter: drop-shadow(0 5rpx 17rpx rgba(24, 18, 14, 0.28));
  --parent-metric-label-color: var(--parent-pdf-metric-label);
}

.home {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.tap-hover {
  opacity: 0.7;
}

/* ---------- 近期课程 ---------- */
.course {
  margin-top: 106rpx;
}

.course__head {
  display: flex;
  align-items: center;
  margin-left: 9rpx;
}

.course__title {
  font-size: 64rpx;
  font-family: var(--parent-font-display);
  font-weight: 400;
  color: var(--parent-on-color);
}

.course__more,
.quickbar__more {
  min-height: var(--role-home-more-height);
  padding: 0 var(--role-home-more-padding-x);
  border: var(--role-home-more-border);
  border-radius: 999rpx;
  font-size: var(--role-home-more-font-size);
  line-height: var(--role-home-more-height);
  color: var(--parent-on-color);
}

.course__more {
  margin-left: 24rpx;
}

.course__body {
  display: flex;
  align-items: center;
  margin-top: 42rpx;
}

.course__date {
  position: relative;
  z-index: 2;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 190rpx;
  margin-left: 8rpx;
}

.course__day {
  font-size: 172rpx;
  font-family: var(--parent-font-display);
  font-weight: 400;
  line-height: 1;
  color: var(--parent-date-red);
}

.course__weekday {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-family: var(--parent-font-display);
  font-weight: 400;
  color: var(--parent-date-red);
}

.course__divider {
  flex: none;
  width: 5rpx;
  height: 130rpx;
  margin: 0 30rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 2rpx;
}

.course__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.course__campus {
  font-size: 29rpx;
  color: var(--parent-on-color);
}

.course__campus-tail {
  display: inline-block;
  white-space: nowrap;
}

.course__name {
  margin-top: 8rpx;
  font-size: 82rpx;
  font-family: var(--parent-font-display);
  font-weight: 400;
  line-height: 1.1;
  color: var(--parent-on-color);
  overflow-wrap: anywhere;
  white-space: normal;
}

.course__name--short {
  font-size: 101rpx;
}

.course__name--long {
  font-size: 64rpx;
}

.course__name-tail {
  display: inline-block;
  white-space: nowrap;
}

.course__time {
  margin-top: 8rpx;
  font-size: 29rpx;
  color: var(--parent-on-color);
}

/* ---------- 学员 + 人物 + 统计 ---------- */
.stage {
  position: relative;
  margin-top: 8rpx;
  height: 704rpx;
}

.stage__mascot {
  position: absolute;
  top: -122rpx;
  right: -40rpx;
  width: 750rpx;
  pointer-events: none;
  z-index: 1;
}

.stage__student {
  position: absolute;
  left: 0;
  bottom: 202rpx;
  z-index: 2;
  display: flex;
  align-items: baseline;
  min-height: var(--parent-touch-min);
}

.stage__student-name {
  max-width: 480rpx;
  font-size: 64rpx;
  font-family: var(--parent-font-display);
  font-weight: 400;
  color: #000000;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stage__student-age {
  flex: none;
  margin-left: 12rpx;
  font-size: 42rpx;
  font-family: var(--parent-font-display);
  font-weight: 400;
  color: #000000;
}

.stage__metrics {
  position: absolute;
  left: 7rpx;
  right: 9rpx;
  bottom: 24rpx;
  z-index: 3;
}

/* ---------- 快捷入口 ---------- */
.quickbar {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: flex-start;
  margin-top: 29rpx;
  margin-left: 9rpx;
}

.quickbar__capsule {
  flex: none;
  display: flex;
  align-items: center;
  background: var(--role-home-nav-background);
  border-radius: 999rpx;
  box-shadow: var(--role-home-nav-shadow);
  margin-top: 17rpx;
  padding: 6rpx 4rpx;
}

.quickbar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: var(--role-home-nav-item-width);
  min-height: var(--parent-touch-min);
  padding: 4rpx;
  box-sizing: border-box;
}

.quickbar__icon {
  width: 38rpx;
  height: 38rpx;
}

.quickbar__label {
  margin-top: 4rpx;
  font-size: 16rpx;
  color: var(--role-home-nav-ink);
}

.quickbar__remind {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: var(--role-home-nav-active-size);
  height: var(--role-home-nav-active-size);
  margin-left: -17rpx;
  margin-top: 0;
  border-radius: 50%;
  background: var(--role-home-nav-active-background);
  box-shadow: var(--role-home-nav-active-shadow);
  z-index: 2;
}

.quickbar__remind-icon {
  width: 64rpx;
  height: 64rpx;
}

.quickbar__remind-label {
  font-size: 16rpx;
  font-weight: 600;
  color: var(--role-home-nav-ink);
}

.quickbar__more {
  flex: none;
  margin-left: auto;
}

.quickbar__remind--collapsed {
  margin-left: 0;
}

.course__empty {
  display: flex;
  align-items: center;
  height: 222rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.home__refresh-error {
  margin-top: 12rpx;
  color: #880000;
  font-size: 22rpx;
}

.home-sheet-backdrop {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.3);
}

.home-sheet {
  width: 100%;
  padding: 32rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 16rpx 16rpx 0 0;
  background: #ffffff;
  color: #242424;
}

.home-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.home-sheet__title {
  font-size: 32rpx;
  font-weight: 700;
}

.home-sheet__close {
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  margin: 0;
  line-height: 72rpx;
  font-size: 40rpx;
  background: transparent;
}

.home-sheet__close::after {
  border: 0;
}

.home-sheet__body {
  max-height: 52vh;
}

.home-sheet__row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.home-sheet__name,
.home-sheet__detail {
  display: block;
  overflow-wrap: anywhere;
}

.home-sheet__name {
  font-size: 28rpx;
  font-weight: 600;
}

.home-sheet__detail,
.home-sheet__empty {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666666;
}
