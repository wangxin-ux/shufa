@import "../../../styles/parent-pdf.wxss";
@import "../styles/pdf-typography.wxss";

.leave {
  position: relative;
  padding: 64rpx 0 80rpx;
}

.leave parent-action-card {
  display: block;
  margin: 0 9rpx;
  --parent-yellow-bright: #ffd75e;
  --parent-action-card-shadow: 0 8rpx 9rpx rgba(24, 18, 14, 0.1);
}

.form-card {
  position: relative;
  top: -9rpx;
  min-height: 692rpx;
}

.form-card__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.form-card__title,
.records__title {
  font-size: 64rpx;
  font-family: var(--parent-font-display);
  line-height: 1.1;
  font-weight: 400;
}

.form-card__title {
  color: #000000;
}

.form-card__cutoff {
  padding-top: 12rpx;
  font-size: 15rpx;
  color: var(--parent-on-color);
}

.field {
  position: relative;
  z-index: 2;
  margin-top: 37rpx;
}

.form-card__head + .field {
  margin-top: 55rpx;
}

.field__label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--parent-ink);
}

.field__control,
.field__textarea {
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid rgba(44, 66, 64, 0.18);
  border-radius: 24rpx;
  background: #fbd45d;
  color: var(--parent-ink);
  font-size: 28rpx;
}

.field__control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  padding: 12rpx 24rpx;
}

.field__value {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  white-space: normal;
}

.field__arrow {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
  margin-left: 20rpx;
}

.field__arrow::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: translateY(-3rpx) rotate(45deg);
}

.field__textarea {
  height: 131rpx;
  padding: 18rpx 24rpx;
}

.form-card__message {
  position: relative;
  z-index: 3;
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--parent-danger);
}

.form-card__submit {
  position: relative;
  z-index: 3;
  width: 294rpx;
  margin-top: 25rpx;
  margin-left: 6rpx;
  --parent-primary-color: #000000;
  --parent-primary-shadow: 0 8rpx 9rpx rgba(24, 18, 14, 0.1);
}

.leave__mascot-frame {
  position: absolute;
  top: 624rpx;
  right: -13rpx;
  z-index: 2;
  width: 360rpx;
  height: 404rpx;
  overflow: hidden;
  pointer-events: none;
}

.leave__mascot {
  display: block;
  width: 360rpx;
}

.records {
  position: relative;
  z-index: 3;
  margin-top: 64rpx;
}

.records__head {
  position: relative;
  min-height: 64rpx;
  display: flex;
  align-items: flex-end;
}

.leave__contact,
.leave__refresh-error {
  position: relative;
  margin-bottom: 24rpx;
  padding: 16rpx 0;
  border-top: 2rpx solid var(--parent-orange);
  border-bottom: 2rpx solid var(--parent-orange);
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--parent-ink);
  background: #ffffff;
  overflow-wrap: anywhere;
}
.leave__contact-campus { display: block; margin-top: 8rpx; }
.leave__contact-call,
.leave__refresh-error button {
  margin: 8rpx 0 0;
  padding: 0;
  background: transparent;
  text-align: left;
  font-size: 24rpx;
  line-height: 1.5;
  color: #bf5600;
}
.leave__contact-call::after,
.leave__refresh-error button::after { border: none; }

.records__title {
  margin-left: 43rpx;
  color: #000000;
}

.records__list {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin: 0 6rpx 0 7rpx;
}

.records__list {
  --parent-record-card-padding: 48rpx 32rpx;
  --parent-record-card-subtitle-size: 20rpx;
  --parent-record-card-subtitle-family: var(--parent-font-display);
  --parent-record-card-subtitle-weight: 600;
  --parent-record-card-background: var(--parent-yellow-card);
  --parent-record-card-border: 0;
  --parent-record-card-shadow: none;
  --parent-record-card-subtitle-color: var(--parent-ink);
  --parent-record-card-plain-tag-size: 32rpx;
}

.records__item {
  border: 4rpx dashed rgba(254, 131, 25, 0.4);
  border-radius: 16rpx;
  background: var(--parent-yellow-card);
  background-clip: padding-box;
  overflow: hidden;
}

.records__review-note {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: var(--parent-ink);
  overflow-wrap: anywhere;
}

@media (max-width: 350px) {
  .form-card__head {
    flex-direction: column;
  }

  .form-card__cutoff {
    padding-top: 0;
  }

  .form-card__submit {
    width: 294rpx;
  }
}
