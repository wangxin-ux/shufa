@import "../../../styles/parent-pdf.wxss";
@import "../styles/pdf-typography.wxss";

.catalog {
  position: relative;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 64rpx 9rpx 8rpx;
}
.catalog::before {
  content: '';
  position: absolute;
  left: -140rpx;
  right: -140rpx;
  bottom: -110rpx;
  height: 250rpx;
  border-radius: 50% 50% 0 0;
  background: var(--parent-pdf-bottom-gradient);
  transform: rotate(6deg);
  z-index: -1;
  pointer-events: none;
}
.catalog__list {
  position: relative;
  z-index: 2;
  flex: none;
  height: calc(46% + 8rpx);
  min-height: 260rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--parent-yellow-card);
  box-shadow: 0 8rpx 14rpx rgba(24, 18, 14, 0.16);
}
.catalog__scroll { height: 100%; }
.course-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  box-sizing: border-box;
  margin: 0 28rpx;
  padding: 14rpx 0;
  gap: 12rpx;
  border-bottom: 2rpx solid #ffffff;
  color: var(--parent-ink);
}
.course-row:last-child { border-bottom: none; }
.course-row__name { display: flex; align-items: center; flex: 1; min-width: 0; gap: 10rpx; font-family: var(--parent-font-display); font-size: 38rpx; font-weight: 800; line-height: 1.3; overflow-wrap: anywhere; }
.course-row__dot { flex: none; width: 16rpx; height: 16rpx; border-radius: 50%; background: #12b687; }
.course-row__quote { flex: none; width: 132rpx; display: flex; flex-direction: column; align-items: flex-end; }
.course-row__price { font-family: var(--parent-font-display); font-size: 36rpx; font-weight: 800; line-height: 1.25; white-space: nowrap; max-width: 100%; }
.course-row__units { font-size: 17rpx; line-height: 1.35; text-align: right; }
.class-type-button { flex: none; margin: 0; padding: 0; width: 96rpx; height: 52rpx; border-radius: 12rpx; background: var(--parent-orange); color: #fff; font-family: var(--parent-font-display); font-size: 24rpx; line-height: 52rpx; }
button::after { border: none; }
.catalog__map { position: relative; flex: 1; min-height: 160rpx; margin: 28rpx 0; border-radius: 20rpx; overflow: hidden; background: #fff; box-shadow: 0 6rpx 12rpx rgba(24, 18, 14, 0.14); }
.catalog__native-map { width: 100%; height: 100%; }
.catalog__map-campus { position: absolute; top: 16rpx; left: 16rpx; max-width: 85%; min-height: 56rpx; margin: 0; padding: 8rpx 20rpx; box-sizing: border-box; background: #fff; color: var(--parent-ink); border-radius: 28rpx; font-size: 22rpx; line-height: 1.6; text-align: left; overflow-wrap: anywhere; }
.catalog__map-arrow { padding-left: 12rpx; font-size: 28rpx; }
.catalog__mascot { position: absolute; right: -42rpx; bottom: calc(-8rpx - env(safe-area-inset-bottom)); width: 300rpx; z-index: 3; pointer-events: none; }
.catalog__offers { position: relative; flex: none; z-index: 4; width: 100%; margin: 0; height: 108rpx; line-height: 108rpx; padding: 0 12rpx; box-sizing: border-box; border-radius: 22rpx; background: var(--parent-orange); color: #fff; font-size: 56rpx; font-family: var(--parent-font-display); box-shadow: 0 7rpx 6rpx 1rpx rgba(24, 18, 14, 0.28); }
.catalog__quote-backdrop { position: absolute; inset: 0; z-index: 8; background: transparent; }
.catalog__popover { position: absolute; top: 220rpx; right: 18rpx; z-index: 9; width: 400rpx; max-width: calc(100% - 36rpx); padding: 14rpx 18rpx; box-sizing: border-box; border-radius: 12rpx; background: var(--parent-orange); color: #fff; box-shadow: 0 8rpx 18rpx rgba(24, 18, 14, 0.2); }
.catalog__popover-head { display: flex; gap: 12rpx; align-items: center; font-size: 28rpx; font-family: var(--parent-font-display); }
.catalog__popover-head > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.catalog__close { flex: none; width: 48rpx; height: 48rpx; line-height: 48rpx; margin: 0; padding: 0; background: transparent; color: #fff; font-size: 36rpx; }
.catalog__quote-scroll { max-height: 390rpx; }
.quote-type { padding-right: 16rpx; box-sizing: border-box; }
.quote-type__name { display: block; font-size: 23rpx; line-height: 1.5; margin-top: 8rpx; }
.quote-row { display: flex; align-items: center; gap: 12rpx; padding: 6rpx 0; border-top: 1rpx solid rgba(255,255,255,0.8); }
.quote-row__map { flex: none; width: 44rpx; height: 44rpx; padding: 0; margin: 0; background: transparent; line-height: 1; }
.quote-row__map image { width: 36rpx; height: 44rpx; }
.quote-row__details { flex: 1; min-width: 0; font-family: var(--parent-font-display); font-size: 18.66667rpx; font-weight: 400; line-height: 1.4; text-align: right; overflow-wrap: anywhere; }
.quote-row__details text { display: block; }
.catalog__more-campuses { margin: 10rpx 0 0; padding: 0; background: transparent; color: #fff; font-size: 21rpx; line-height: 1.6; text-align: left; }
