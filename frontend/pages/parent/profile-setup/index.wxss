@import "../../../styles/parent-pdf.wxss";
@import "../styles/pdf-typography.wxss";

.profile-setup {
  padding: 56rpx 9rpx calc(48rpx + env(safe-area-inset-bottom));
  color: var(--parent-ink);
}

.profile-setup__form {
  padding: 32rpx;
  border-radius: 16rpx;
  background: #ffd75e;
  box-shadow: 0 8rpx 9rpx rgba(24, 18, 14, 0.1);
}

.profile-setup__title {
  display: block;
  font-family: var(--parent-font-display);
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #000000;
}

.profile-setup__field {
  margin-top: 32rpx;
}

.profile-setup__label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 600;
}

.profile-setup__input,
.profile-setup__date {
  box-sizing: border-box;
  width: 100%;
  min-height: 80rpx;
  padding: 18rpx 24rpx;
  border: 2rpx solid rgba(44, 66, 64, 0.18);
  border-radius: 16rpx;
  background: #fbd45d;
  font-size: 28rpx;
  line-height: 1.5;
}

.profile-setup__input {
  height: 80rpx;
}

.profile-setup__date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.profile-setup__date-value {
  min-width: 0;
  overflow-wrap: anywhere;
}

.profile-setup__placeholder {
  color: var(--parent-text-muted);
}

.profile-setup__arrow {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin: 0 8rpx 6rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.profile-setup__photo-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-setup__photo {
  flex: none;
  box-sizing: border-box;
  width: 168rpx;
  height: 168rpx;
  border: 2rpx solid rgba(44, 66, 64, 0.18);
  border-radius: 16rpx;
  background: #fbd45d;
}

.profile-setup__photo--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: var(--parent-text-muted);
}

.profile-setup__photo-actions {
  flex: 1;
  min-width: 0;
}

.profile-setup__choose {
  min-height: 72rpx;
  margin: 0;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--parent-ink);
  font-size: 26rpx;
  line-height: 1.5;
}

.profile-setup__limit {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.profile-setup__message {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
  color: var(--parent-danger);
}

.profile-setup__refresh,
.profile-setup__logout {
  min-height: 72rpx;
  padding: 16rpx 0;
  background: transparent;
  color: var(--parent-ink);
  font-size: 26rpx;
  line-height: 1.5;
}

.profile-setup__refresh {
  margin: 8rpx 0 0;
  text-align: left;
}

.profile-setup__logout {
  margin: 28rpx 0 0;
}

.profile-setup__choose::after,
.profile-setup__refresh::after,
.profile-setup__logout::after {
  border: none;
}

.profile-setup__submit {
  display: block;
  margin-top: 32rpx;
  --parent-primary-color: #000000;
  --parent-primary-shadow: 0 8rpx 9rpx rgba(24, 18, 14, 0.1);
}
