.group-list {
  padding: 44rpx 0 100rpx;
}

.group-list__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.group-list__intro {
  flex: 1;
  min-width: 0;
}

.group-list__eyebrow,
.group-list__title,
.group-list__subtitle {
  display: block;
}

.group-list__eyebrow {
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #a34a13;
}

.group-list__title {
  font-family: var(--parent-font-display);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #211b17;
}

.group-list__subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: rgba(42, 35, 30, 0.64);
}

button.orders-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-sizing: border-box;
  min-width: 172rpx;
  min-height: 80rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow: 0 8rpx 18rpx rgba(82, 59, 32, 0.1);
  backdrop-filter: blur(16rpx);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  color: #2a231e;
}

button.orders-button::after {
  border: 0;
}

.orders-button__arrow {
  margin-left: 8rpx;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

.campaigns {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.campaign-card {
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 32rpx;
  background: #fffdf8;
  box-shadow: 0 16rpx 32rpx rgba(77, 48, 20, 0.16);
  transition: opacity 120ms ease, transform 120ms ease;
}

.campaign-card--pressed {
  opacity: 0.88;
  transform: scale(0.99);
}

.campaign-card__visual {
  position: relative;
  height: 420rpx;
  overflow: hidden;
  background: #f4c72f;
}

.campaign-card__cover {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
}

.campaign-card__cover-fallback {
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  height: 100%;
  padding: 44rpx;
  background: linear-gradient(145deg, #ffd75e 0%, #f4bf2d 62%, #fe8419 100%);
  color: #4f1c0d;
}

.campaign-card__fallback-course,
.campaign-card__fallback-title {
  display: block;
}

.campaign-card__fallback-course {
  font-size: 26rpx;
  font-weight: 700;
}

.campaign-card__fallback-title {
  margin-top: 12rpx;
  font-family: var(--parent-font-display);
  font-size: 56rpx;
  font-weight: 800;
}

.campaign-card__status {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  display: flex;
  align-items: center;
  padding: 12rpx 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.48);
  border-radius: 28rpx;
  background: rgba(36, 30, 25, 0.72);
  box-shadow: 0 6rpx 16rpx rgba(36, 23, 12, 0.18);
  backdrop-filter: blur(12rpx);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1;
  color: #ffffff;
}

.campaign-card__status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #ffd75e;
  box-shadow: 0 0 0 5rpx rgba(255, 215, 94, 0.2);
}

.campaign-card__body {
  padding: 28rpx 30rpx 30rpx;
}

.campaign-card__top,
.campaign-card__footer,
.campaign-card__time-row {
  display: flex;
  align-items: center;
}

.campaign-card__top,
.campaign-card__footer {
  justify-content: space-between;
  gap: 20rpx;
}

.campaign-card__course,
.campaign-card__team {
  font-size: 21rpx;
}

.campaign-card__course {
  overflow: hidden;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #8f4b18;
}

.campaign-card__team {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 215, 94, 0.5);
  color: #60411f;
}

.campaign-card__title {
  display: block;
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #211b17;
}

.campaign-card__desc {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 23rpx;
  line-height: 1.55;
  color: rgba(42, 35, 30, 0.66);
}

.campaign-card__footer {
  margin-top: 24rpx;
}

.campaign-card__price {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.price__caption {
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(42, 35, 30, 0.58);
}

.price__mark {
  font-size: 26rpx;
  font-weight: 800;
  color: #eb561d;
}

.price__value {
  font-family: var(--parent-font-display);
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1;
  color: #eb561d;
}

.campaign-card__action {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 196rpx;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: linear-gradient(180deg, #ffad52 0%, #ff7d22 100%);
  box-shadow: inset 0 3rpx 0 rgba(255, 255, 255, 0.34), 0 8rpx 16rpx rgba(224, 91, 18, 0.2);
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

.campaign-card__action-arrow {
  margin-left: 8rpx;
  font-size: 34rpx;
  font-weight: 400;
  line-height: 1;
}

.campaign-card__time-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(42, 35, 30, 0.08);
}

.campaign-card__time-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #fe8419;
}

.campaign-card__time {
  font-size: 21rpx;
  color: rgba(42, 35, 30, 0.54);
}

@media (max-width: 350px) {
  .group-list__head {
    align-items: flex-start;
  }

  .group-list__title {
    font-size: 38rpx;
  }

  button.orders-button {
    min-width: 150rpx;
    padding: 0 16rpx;
    font-size: 21rpx;
  }

  .campaign-card__visual {
    height: 390rpx;
  }
}
