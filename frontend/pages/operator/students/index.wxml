<operator-page-shell
  markTitle="档案"
  markIcon="/pages/operator/assets/page-mark-pdf.png" markIconSize="44"
  showBack="{{true}}"
>
  <view class="students-page">
    <view class="student-utility"><button bindtap="onToggleTools" aria-expanded="{{toolsOpen}}">{{toolsOpen ? '收起筛选' : '筛选'}}</button></view>
    <view wx:if="{{toolsOpen}}" class="students-page__heading">
      <view class="students-page__heading-copy">
        <text class="students-page__title">人员管理</text>
        <text class="students-page__summary">{{activeQuery ? '匹配到' : '本校区共'}} {{total}} 名在读学员</text>
      </view>
    </view>

    <block wx:if="{{toolsOpen && (viewState === 'ready' || viewState === 'empty')}}">
    <view class="roster-tabs">
      <button class="roster-tab roster-tab--active" hover-class="none">学员名册</button>
      <button class="roster-tab" bindtap="onTeacherRosterTap">教师名册</button>
    </view>

    <view class="roster-actions">
      <button class="roster-action roster-action--primary" disabled="{{rosterBusy}}" bindtap="onQuickToggle">{{quickOpen ? '收起录入' : '快捷录入'}}</button>
      <button class="roster-action" disabled="{{rosterBusy}}" bindtap="onRosterImport">Excel 导入</button>
      <button class="roster-action" disabled="{{rosterBusy}}" bindtap="onRosterExport">导出 Excel</button>
    </view>

    <view wx:if="{{quickOpen}}" class="quick-form">
      <text class="quick-form__title">录入顾客</text>
      <input class="quick-form__field" maxlength="100" value="{{quickStudentName}}" bindinput="onQuickStudentInput" placeholder="学员姓名" />
      <input class="quick-form__field" type="number" maxlength="11" value="{{quickParentPhone}}" bindinput="onQuickPhoneInput" placeholder="家长手机号" />
      <button class="quick-form__submit" disabled="{{rosterBusy}}" bindtap="onQuickSubmit">{{rosterBusy ? '正在录入' : '确认录入'}}</button>
    </view>

    <view class="student-search">
      <button class="student-search__command student-search__icon" bindtap="onSearchSubmit" aria-label="搜索学员">⌕</button>
      <input
        class="student-search__input"
        value="{{searchValue}}"
        placeholder="搜索学员姓名"
        confirm-type="search"
        maxlength="100"
        bindinput="onSearchInput"
        bindconfirm="onSearchSubmit"
      />
      <button wx:if="{{searchValue || activeQuery}}" class="student-search__command" bindtap="onSearchClear" aria-label="清空搜索">×</button>
    </view>
    </block>

    <view wx:if="{{viewState === 'loading'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">正在加载学员</text>
    </view>
    <view wx:elif="{{viewState === 'forbidden'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">无访问权限</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-state__retry" bindtap="onLogin" hover-class="control--hover">重新登录</button>
    </view>
    <view wx:elif="{{viewState === 'error'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">学员加载失败</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-state__retry" bindtap="onRetry" hover-class="control--hover">重试</button>
    </view>
    <view wx:elif="{{viewState === 'empty'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">暂无匹配学员</text>
      <text class="page-state__message">可调整姓名关键词，或使用上方快捷录入</text>
    </view>

    <view wx:if="{{(viewState === 'ready' || viewState === 'empty') && (refreshError || refreshing)}}" class="student-notice" aria-live="polite">
      <text>{{refreshError || '正在刷新学员'}}</text>
      <button wx:if="{{refreshError}}" class="student-notice__retry" bindtap="onRetry">重试</button>
    </view>
    <view wx:if="{{viewState === 'ready'}}" class="student-list">
      <view
        class="student-row"
        wx:for="{{items}}"
        wx:key="id"
      >
        <button
          class="student-row__toggle"
          aria-label="{{item.displayName}}的基础资料"
          aria-expanded="{{item.expanded}}"
          data-id="{{item.id}}"
          bindtap="onStudentToggle"
          hover-class="student-row--hover"
        >
        <view class="student-row__head">
          <text class="student-row__name {{item.displayName.length > 3 ? 'student-row__name--compact' : ''}}">{{item.displayName}}</text>
          <view class="student-row__summary"><text class="student-row__classes">{{item.classLabel}}</text><text>{{item.archive ? '剩余 ' + item.archive.totalBalanceLabel + '课时' : '查看课时 ›'}}</text></view>
        </view>
        </button>
        <view wx:if="{{item.expanded}}" class="student-row__expanded">
          <text wx:if="{{item.archiveState === 'loading'}}" class="student-notice">正在读取档案摘要</text>
          <view wx:if="{{item.archiveState === 'error'}}" class="student-notice">
            <text>{{item.archiveError}}</text>
            <button class="student-notice__retry" data-id="{{item.id}}" bindtap="onArchiveRetry">重试</button>
          </view>
          <block wx:if="{{item.archive}}">
            <view class="student-archive__identity">
              <image wx:if="{{item.photoPath}}" class="student-archive__photo" src="{{item.photoPath}}" mode="aspectFill" data-id="{{item.id}}" binderror="onPhotoError" />
              <view wx:else class="student-archive__photo student-archive__photo--empty"><text>暂无可用照片</text></view>
              <view class="student-archive__identity-copy">
                <text>报名 {{item.archive.initialMainLabel}}课时 {{item.archive.receivedAmountLabel}}</text>
                <text>剩余 {{item.archive.totalBalanceLabel}}课时</text>
                <text>出勤率 {{item.archive.attendanceRateLabel}}</text>
                <button class="student-row__detail" data-id="{{item.id}}" bindtap="onStudentTap">点击查看更多</button>
              </view>
            </view>
            <view wx:if="{{item.photoError}}" class="student-notice">
              <text>{{item.photoError}}</text>
              <button class="student-notice__retry" data-id="{{item.id}}" bindtap="onArchiveRetry">重试照片</button>
            </view>
            <view wx:if="{{toolsOpen}}" class="student-archive__facts">
              <view class="student-archive__fact"><text>报名实收</text><text class="student-archive__value">{{item.archive.receivedAmountLabel}}</text></view>
              <view class="student-archive__fact"><text>实际退款</text><text class="student-archive__value">{{item.archive.refundedAmountLabel}}</text></view>
              <view class="student-archive__fact"><text>原始购买课时</text><text class="student-archive__value">{{item.archive.initialMainLabel}}</text></view>
              <view class="student-archive__fact"><text>原始赠送课时</text><text class="student-archive__value">{{item.archive.initialGiftLabel}}</text></view>
              <view class="student-archive__fact"><text>当前可用</text><text class="student-archive__value">{{item.archive.totalBalanceLabel}} 节</text></view>
              <view class="student-archive__fact"><text>有效出勤率</text><text class="student-archive__value">{{item.archive.attendanceRateLabel}}</text></view>
            </view>
            <text wx:if="{{item.archive.reservationLabel}}" class="student-archive__note">{{item.archive.reservationLabel}}</text>
            <text wx:if="{{item.archive.warningLabel}}" class="student-archive__warning">{{item.archive.warningLabel}}</text>
            <text wx:if="{{item.archive.pendingIssuanceLabel}}" class="student-archive__note">{{item.archive.pendingIssuanceLabel}}</text>
          </block>
        <button wx:if="{{!item.archive}}" class="student-row__detail" data-id="{{item.id}}" bindtap="onStudentTap" hover-class="control--hover">查看详情 ›</button>
        </view>
      </view>

      <text wx:if="{{loadMoreError}}" class="student-notice" aria-live="polite">{{loadMoreError}}</text>
      <button
        wx:if="{{hasMore}}"
        class="load-more"
        disabled="{{loadingMore || refreshing}}"
        bindtap="onLoadMore"
        hover-class="control--hover"
      >{{loadingMore ? '加载中' : (loadMoreError ? '重试加载更多' : '加载更多')}}</button>
    </view>
  </view>
</operator-page-shell>
