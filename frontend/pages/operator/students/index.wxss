@import "../runtime/operator-tokens.wxss";

.students-page {
  position: relative;
  padding: 34rpx 18rpx 60rpx;
}

.student-utility { position:absolute; top:0; right:18rpx; }
.student-utility button { min-width:88rpx; min-height:44rpx; margin:0; padding:0; background:transparent; font-size:18rpx; line-height:44rpx; color:var(--operator-muted); }
.student-utility button::after { border:0; }

.students-page__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  min-height: 164rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  border-radius: 0;
  background: transparent;
}

.students-page__heading-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.students-page__title {
  max-width: 100%;
  overflow-wrap: anywhere;
  font-family: var(--operator-font-display);
  font-size: 38rpx;
  font-weight: 400;
  line-height: 1.15;
  color: var(--operator-ink);
}

.students-page__summary {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--operator-muted);
}

.page-state__retry,
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--operator-touch-min);
  margin: 0;
  padding: 0 26rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 16rpx;
  background: var(--operator-surface);
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--operator-ink);
}

.page-state__retry::after,
.load-more::after,
.roster-action::after,
.roster-tab::after,
.quick-form__submit::after {
  border: 0;
}

.student-search__command::after,
.student-row__toggle::after,
.student-row__detail::after,
.student-notice__retry::after {
  border: 0;
}

.roster-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 116, 71, 0.2);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 7rpx 16rpx rgba(63, 46, 15, 0.1);
}

.roster-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  margin: 0;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 6rpx;
  background: transparent;
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--operator-muted);
}

.roster-tab--active {
  background: var(--operator-orange);
  box-shadow: 0 6rpx 14rpx rgba(158, 69, 21, 0.2);
  font-weight: 700;
  color: #ffffff;
}

.roster-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.roster-action,
.quick-form__submit {
  display: flex;
  min-height: var(--operator-touch-min);
  margin: 0;
  padding: 0 14rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 0;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 6rpx 14rpx rgba(63, 46, 15, 0.12);
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--operator-ink);
  text-align: center;
}

.roster-action--primary,
.quick-form__submit {
  background: var(--operator-orange);
  color: #ffffff;
}

.quick-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border-left: 8rpx solid var(--operator-orange);
  border-radius: 8rpx;
  background: var(--operator-glass);
  box-shadow: 0 7rpx 16rpx rgba(63, 46, 15, 0.13);
}

.quick-form__title,
.quick-form__submit {
  grid-column: 1 / -1;
}

.quick-form__title {
  font-family: var(--operator-font-display);
  font-size: 30rpx;
  font-weight: 400;
}

.quick-form__field {
  width: 100%;
  min-height: var(--operator-touch-min);
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 116, 71, 0.26);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.94);
  font-size: 25rpx;
  color: var(--operator-ink);
}

.student-search {
  display: flex;
  align-items: center;
  min-height: var(--operator-touch-min);
  margin-top: 24rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 16rpx;
  background: var(--operator-glass);
  box-shadow: 0 6rpx 14rpx rgba(63, 46, 15, 0.12);
}

.student-search__icon {
  flex: none;
  width: 40rpx;
  font-size: 34rpx;
  color: var(--operator-muted);
}

.student-search__command {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: var(--operator-touch-min);
  min-height: var(--operator-touch-min);
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 34rpx;
  line-height: 1;
  color: var(--operator-ink);
}

.student-search__input {
  flex: 1;
  min-width: 0;
  height: var(--operator-touch-min);
  font-size: 27rpx;
  color: var(--operator-ink);
}

.student-list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  margin-top: 26rpx;
}

.student-row {
  min-height: 164rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: var(--operator-card-radius);
  background: transparent;
  box-shadow: none;
}

.student-row--hover {
  opacity: 0.76;
}

.student-row__toggle {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 164rpx;
  margin: 0;
  padding: 24rpx 30rpx;
  border: 0;
  border-radius: 32rpx;
  background: var(--operator-orange);
  box-shadow: var(--operator-shadow);
  line-height: 1.2;
  color: #ffffff;
  text-align: left;
}

.student-row__detail {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: var(--operator-touch-min);
  width: 100%;
  margin: 8rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 24rpx;
  color: var(--operator-ink);
}

.student-row__head {
  display: flex;
  align-items: center;
  width: 100%;
  justify-content: space-between;
  gap: 20rpx;
}

.student-row__name {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
  font-family: var(--operator-font-display);
  font-size: 95rpx;
  font-weight: 400;
  line-height: 1.2;
}

.student-row__status {
  flex: none;
  max-width: 112rpx;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(35, 135, 96, 0.14);
  font-size: 21rpx;
  color: #176a4b;
}

.student-row__classes {
  display: block;
  margin-top: 13rpx;
  overflow-wrap: anywhere;
  font-size: 25rpx;
  line-height: 1.5;
  color: #ffffff;
}

.student-row__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(32, 29, 23, 0.12);
}

.student-row__meta-label {
  flex: none;
  font-size: 21rpx;
  color: var(--operator-muted);
}

.student-row__meta-value {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 24rpx;
  text-align: right;
}

.student-row__meta-command {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
}

.student-row__chevron {
  flex: none;
  margin-left: 12rpx;
  font-size: 42rpx;
  line-height: 1;
  color: #ffffff;
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 390rpx;
  margin-top: 26rpx;
  padding: 34rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--operator-glass);
}

.page-state__title {
  max-width: 100%;
  overflow-wrap: anywhere;
  font-family: var(--operator-font-display);
  font-size: 42rpx;
  font-weight: 400;
}

.page-state__message {
  max-width: 100%;
  margin-top: 14rpx;
  overflow-wrap: anywhere;
  font-size: 25rpx;
  color: var(--operator-muted);
}

.student-notice {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  margin-top: 22rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--operator-red);
  overflow-wrap: anywhere;
}

.student-notice__retry {
  flex: none;
  min-height: var(--operator-touch-min);
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 24rpx;
  color: var(--operator-red);
}

.page-state__retry,
.load-more {
  margin-top: 24rpx;
  background: var(--operator-orange);
  color: #ffffff;
}

.load-more {
  align-self: center;
  min-width: 220rpx;
}

.control--hover {
  opacity: 0.72;
}

.student-row__expanded { margin-top:26rpx; padding:24rpx 30rpx; border-radius:32rpx; background:var(--operator-orange); box-shadow:var(--operator-shadow); color:#fff; }
.student-archive__identity { display: flex; gap: 22rpx; align-items: center; }
.student-archive__photo { flex: none; width:197rpx; height:263rpx; border-radius:0; }
.student-archive__photo--empty {
  display: flex; align-items: center; justify-content: center; padding: 12rpx; box-sizing: border-box;
  background: rgba(255, 255, 255, 0.7); text-align: center; font-size: 21rpx; color: var(--operator-muted);
}
.student-archive__identity-copy { display:flex; flex-direction:column; flex:1; min-width:0; min-height:263rpx; font-family:var(--operator-font-display); font-size:32rpx; line-height:1.3; overflow-wrap:anywhere; }
.student-archive__identity-copy .student-row__detail { margin-top:auto; justify-content:center; font-family:var(--operator-font-display); font-size:34rpx; color:#fff; }
.student-row__summary { display:flex; flex:0 1 280rpx; flex-direction:column; align-items:flex-end; gap:6rpx; min-width:0; font-family:var(--operator-font-display); font-size:32rpx; text-align:right; }
.student-row__summary .student-row__classes { margin-top:0; font-family:var(--operator-font-display); font-size:32rpx; }
.student-row .student-row__name--compact { font-size:64rpx; }
.student-archive__age { display: block; font-size: 28rpx; font-weight: 700; }
.student-archive__classes, .student-archive__note {
  display: block; margin-top: 10rpx; font-size: 23rpx; line-height: 1.5; color: var(--operator-muted); overflow-wrap: anywhere;
}
.student-archive__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx 24rpx; margin-top: 24rpx; }
.student-archive__fact { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; font-size: 22rpx; color: var(--operator-muted); }
.student-archive__value { font-size: 27rpx; font-weight: 700; color: var(--operator-ink); overflow-wrap: anywhere; }
.student-archive__warning { display: block; margin-top: 16rpx; font-size: 23rpx; color: #a62d27; overflow-wrap: anywhere; }

@media (max-width: 380px) {
  .students-page__heading {
    align-items: flex-start;
  }

  .roster-actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .quick-form {
    grid-template-columns: 1fr;
  }

  .quick-form__title,
  .quick-form__submit {
    grid-column: 1;
  }
}
