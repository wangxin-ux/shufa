@import "../runtime/operator-tokens.wxss";

.profile {
  position: relative;
  min-height: 0;
  padding: 84rpx 0 0;
  box-sizing: border-box;
  overflow: visible;
}

.profile::after {
  position: absolute;
  top: calc(100vh - 350rpx);
  right: -160rpx;
  bottom: auto;
  left: -160rpx;
  z-index: 0;
  height: 560rpx;
  border-radius: 50% 50% 0 0;
  background: linear-gradient(180deg, #e6b431 0%, #e3ab1d 100%);
  content: "";
}

.profile-hero {
  position: relative;
  z-index: 2;
  height: 456rpx;
}

.profile-card {
  position: absolute;
  bottom: 0;
  left: 14rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 653rpx;
  min-height: 265rpx;
  padding: 28rpx 43% 28rpx 42rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 32rpx;
  background: #fe8419;
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.profile-card__name,
.profile-card__campus,
.profile-card__role {
  position: relative;
  z-index: 3;
  max-width: 100%;
  overflow-wrap: anywhere;
  color: #ffffff;
}

.profile-card__name {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-family: var(--operator-font-display);
  width: 510rpx;
  max-width: 510rpx;
  font-size: 95rpx;
  font-weight: 400;
  line-height: 1.05;
}

.profile-card__name--compact {
  font-size: 76rpx;
}

.profile-card__name--long { font-size: 54rpx; }

.profile-card__meta {
  order: 2;
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10rpx;
  width: 360rpx;
  max-width: 360rpx;
  min-width: 0;
  margin-top: 8rpx;
}

.profile-card__campus,
.profile-card__role {
  display: inline-block;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  font-family: var(--operator-font-display);
  font-size: 18rpx;
  font-weight: 400;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-card__campus {
  flex: 1;
}

.profile-card__role {
  flex: none;
  font-size: 18rpx;
}

.profile-hero__character {
  position: absolute;
  right: -32rpx;
  bottom: 0;
  z-index: 2;
  width: 462rpx;
  pointer-events: none;
}

.profile-card__count {
  order: 1;
  position: relative;
  z-index: 3;
  max-width: 100%;
  margin-top: 10rpx;
  font-family: var(--operator-font-display);
  font-size: 76rpx;
  line-height: 1.05;
  color: #ffffff;
  overflow-wrap: anywhere;
}

.profile-refresh {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 14rpx 24rpx;
  font-size: 24rpx;
  overflow-wrap: anywhere;
}

.profile-refresh__retry {
  flex: none;
  min-height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.profile-actions-stage {
  position: relative;
  z-index: 1;
  min-height: 850rpx;
  margin-top: 54rpx;
}

.profile-actions-stage__character {
  position: absolute;
  top: 100rpx;
  left: -32rpx;
  z-index: 0;
  width: 573rpx;
  pointer-events: none;
}

.profile-actions {
  position: relative;
  z-index: 2;
  width: 653rpx;
  margin-left: 14rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 215, 94, 0.84);
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.profile-action {
  display: flex;
  align-items: center;
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border: 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 0;
  background: transparent;
  line-height: 1.2;
  text-align: left;
}

.profile-action:last-child {
  border-bottom: 0;
}

.profile-action::after,
.page-state__retry::after {
  border: 0;
}

.profile-action__bullet {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  margin-right: 32rpx;
  border-radius: 50%;
  background: #2fbd82;
}

.profile-action__label {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-family: var(--operator-font-display);
  font-size: 34rpx;
  font-weight: 400;
  color: #243b36;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-action__command {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  min-height: 56rpx;
  margin-left: 16rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #fe8419;
  font-size: 24rpx;
  color: #ffffff;
}

.profile-session {
  position: relative;
  z-index: 3;
  width: 653rpx;
  margin: 28rpx 0 120rpx 14rpx;
}

.page-state__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: var(--operator-touch-min);
  margin: 18rpx 0 0;
  border: 0;
  border-radius: 16rpx;
  background: #fe8419;
  font-size: 26rpx;
  color: #ffffff;
}

.page-state {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 520rpx;
  padding: 34rpx;
}

.page-state__title {
  font-family: var(--operator-font-display);
  font-size: 45rpx;
  font-weight: 400;
}

.page-state__message {
  max-width: 100%;
  margin-top: 16rpx;
  overflow-wrap: anywhere;
  font-size: 24rpx;
  color: var(--operator-muted);
}

.page-state__retry {
  width: auto;
  padding: 0 34rpx;
}

.button--hover {
  opacity: 0.72;
}

.profile-tools-button { display:flex; align-items:center; justify-content:center; width:88rpx; min-height:88rpx; margin:0; padding:0; background:transparent; color:#243b36; font-size:44rpx; line-height:1; }
.profile-tools-button::after, .profile-tools-heading button::after { border:0; }
.profile-tools-layer { position:fixed; inset:0; z-index:100; display:flex; align-items:flex-end; }
.profile-tools-backdrop { position:absolute; inset:0; background:rgba(0,0,0,.28); }
.profile-tools-sheet { position:relative; width:100%; max-height:75vh; overflow-y:auto; padding:24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing:border-box; border-radius:28rpx 28rpx 0 0; background:#fff; }
.profile-tools-heading { display:flex; justify-content:space-between; align-items:center; font-size:32rpx; margin-bottom:16rpx; }
.profile-tools-heading button { width:88rpx; min-height:88rpx; margin:0; padding:0; background:transparent; font-size:44rpx; }
.profile-extra-action { display:flex; justify-content:space-between; align-items:center; min-height:88rpx; margin:0; padding:0 16rpx; border-radius:0; border-bottom:1rpx solid #eee; background:transparent; font-size:28rpx; }
.profile-extra-action::after { border:0; }

.profile-card__name--long { max-width:300rpx; font-size:44rpx; line-height:1.15; }
