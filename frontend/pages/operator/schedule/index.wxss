@import "../runtime/operator-tokens.wxss";

.schedule-page {
  padding: 52rpx 18rpx 64rpx;
}

.schedule-page__heading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  min-height: 164rpx;
  padding: 24rpx 30rpx;
  box-sizing: border-box;
  border-radius: var(--operator-card-radius);
  background: var(--operator-success);
  box-shadow: var(--operator-shadow);
}

.schedule-page__heading-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.schedule-page__title {
  overflow-wrap: anywhere;
  font-family: var(--operator-font-display);
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1.15;
  color: #ffffff;
}

.schedule-page__summary {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.88);
}

.schedule-control {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--operator-touch-min);
  margin: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.2;
}

.schedule-control::after {
  border: 0;
}

.schedule-page__create {
  width: 100%;
  min-height: 164rpx;
  background: var(--operator-success);
  border: 0;
  font-family: var(--operator-font-display);
  font-size: 88rpx;
  font-weight: 400;
  color: #ffffff;
}

.schedule-utility { display: flex; justify-content: flex-end; min-height: 44rpx; }
.schedule-utility__filter {
  min-width: 88rpx; min-height: 44rpx; margin: 0; padding: 0;
  background: transparent; font-size: 18rpx; line-height: 44rpx; color: var(--operator-muted);
}
.schedule-utility__filter::after { border:0; }

.schedule-filters {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-top: 24rpx;
}

.schedule-filter {
  flex: 1;
  min-width: 0;
  min-height: var(--operator-touch-min);
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 16rpx;
  background: var(--operator-glass);
}

.schedule-filter__content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: var(--operator-touch-min);
  gap: 14rpx;
}

.schedule-filter__label {
  flex: none;
  font-size: 21rpx;
  color: var(--operator-muted);
}

.schedule-filter__value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 24rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-filter__clear {
  flex: none;
  width: var(--operator-touch-min);
  padding: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.74);
  font-size: 38rpx;
  color: var(--operator-muted);
}

.page-state__retry,
.load-more {
  background: var(--operator-orange);
  color: #ffffff;
}

.load-more[disabled] {
  opacity: 0.58;
}

.schedule-notice {
  margin-top: 24rpx;
}

.schedule-notice__message {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  font-size: 24rpx;
  color: #9b1919;
}

.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  margin-top: 26rpx;
}

.lesson-row {
  min-height: 164rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: var(--operator-card-radius);
  background: transparent;
  color: #ffffff;
  box-shadow: none;
}

.lesson-row__summary {
  display: flex; align-items: center; justify-content: space-between; gap: 24rpx;
  width: 100%; min-height: 164rpx; margin: 0; padding: 24rpx 32rpx;
  box-sizing: border-box; border: 0; border-radius: 32rpx;
  background: var(--operator-orange); box-shadow: var(--operator-shadow);
  font-family: var(--operator-font-display); font-size: 46rpx; font-weight: 400;
  line-height: 1.15; color: #ffffff; text-align: left;
}
.lesson-row__summary::after { border: 0; }
.lesson-row__summary[disabled] { background: var(--operator-orange); color: #ffffff; opacity: 0.65; }
.lesson-row__date-time, .lesson-row__identity { display: flex; flex-direction: column; min-width: 0; gap: 4rpx; }
.lesson-row__date-time { flex: 1; }
.lesson-row__identity { flex: 1; align-items: flex-end; text-align: right; overflow-wrap: anywhere; }
.lesson-row__identity--compact { font-size: 36rpx; }
.lesson-row__expanded { padding: 20rpx 30rpx; margin-top: 20rpx; border-radius: 32rpx; background: var(--operator-orange); }

.lesson-row__head,
.lesson-row__time,
.lesson-row__meta,
.lesson-row__actions {
  flex-wrap: wrap;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.lesson-row__heading-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.lesson-row__course {
  overflow-wrap: anywhere;
  font-family: var(--operator-font-display);
  font-size: 36rpx;
  font-weight: 400;
}

.lesson-row__class {
  margin-top: 7rpx;
  overflow-wrap: anywhere;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.94);
}

.lesson-row__status {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(35, 135, 96, 0.14);
  font-size: 21rpx;
  color: #176a4b;
}

.lesson-row__status--COMPLETED,
.lesson-row__status--REVERSED,
.lesson-row__status--CANCELLED {
  background: rgba(32, 29, 23, 0.1);
  color: var(--operator-muted);
}

.lesson-row__status--IN_PROGRESS {
  background: rgba(255, 116, 71, 0.16);
  color: #9a3c20;
}

.lesson-row__time {
  margin-top: 18rpx;
  font-family: var(--operator-font-display);
  font-size: 38rpx;
  font-weight: 400;
}

.lesson-row__meta {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.94);
}

.lesson-row__actions {
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(32, 29, 23, 0.12);
}

.lesson-row__edit,
.lesson-row__cancel {
  min-width: 132rpx;
  min-height: 72rpx;
}

.lesson-row__edit {
  background: var(--operator-orange);
  color: #ffffff;
}

.lesson-row__cancel {
  border: 2rpx solid rgba(153, 10, 4, 0.36);
  background: rgba(255, 255, 255, 0.72);
  color: var(--operator-red);
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 390rpx;
  margin-top: 26rpx;
  padding: 34rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--operator-glass);
}

.page-state__title {
  font-family: var(--operator-font-display);
  font-size: 42rpx;
  font-weight: 400;
}

.page-state__message {
  margin-top: 14rpx;
  overflow-wrap: anywhere;
  font-size: 25rpx;
  color: var(--operator-muted);
}

.page-state__retry,
.load-more {
  margin-top: 24rpx;
}

.load-more {
  align-self: center;
  min-width: 220rpx;
}

.control--hover {
  opacity: 0.72;
}
.cancellation-panel { margin-top: 24rpx; padding-top: 24rpx; border-top: 2rpx solid rgba(32, 29, 23, 0.2); }
.cancellation-panel__heading { display: flex; justify-content: space-between; align-items: center; gap: 14rpx; }
.cancellation-panel__modes { display: flex; flex-direction: column; margin-top: 16rpx; font-size: 25rpx; }
.cancellation-panel__modes label { display: flex; align-items: center; min-height: 88rpx; gap: 10rpx; }
.cancellation-panel__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10rpx; min-height: 74rpx; padding: 12rpx 0; border-bottom: 2rpx solid rgba(32, 29, 23, 0.12); box-sizing: border-box; font-size: 24rpx; overflow-wrap: anywhere; }
.cancellation-panel__version { font-size: 21rpx; color: var(--operator-muted); }
.cancellation-panel__confirm { margin-top: 24rpx; width: 100%; }

.lesson-row__members,
.member-panel__quiet,
.member-row__remove,
.member-search__button {
  min-height: 88rpx;
  padding: 0 18rpx;
  flex: none;
}

.lesson-row__members,
.member-panel__quiet {
  background: rgba(255, 255, 255, 0.78);
  color: #201d17;
  border: 2rpx solid rgba(32, 29, 23, 0.2);
}

.member-panel {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(32, 29, 23, 0.2);
}

.member-panel__heading,
.member-panel__summary,
.member-row__identity,
.member-row,
.member-row__confirm,
.member-search__bar,
.member-search__selection {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.member-panel__heading,
.member-panel__summary,
.member-row {
  justify-content: space-between;
}

.member-panel__title {
  font-size: 29rpx;
  line-height: 1.4;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.member-panel__summary {
  flex-wrap: wrap;
  margin-top: 20rpx;
  font-size: 24rpx;
}

.member-panel__hint,
.member-panel__notice,
.member-panel__error {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.member-panel__hint { color: rgba(32, 29, 23, 0.65); }
.member-panel__notice { color: #176a4b; }
.member-panel__error { color: #990a04; }

.member-row {
  flex-wrap: wrap;
  min-height: 104rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid rgba(32, 29, 23, 0.1);
  box-sizing: border-box;
}

.member-row__identity {
  flex: 1;
  flex-wrap: wrap;
}

.member-row__name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.member-row__source {
  flex: none;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(32, 29, 23, 0.1);
  color: #524f47;
  font-size: 21rpx;
}

.member-row__source--TEMPORARY {
  background: #e1f0e6;
  color: #176a4b;
}

.member-row__remove {
  border: 2rpx solid rgba(153, 10, 4, 0.3);
  background: #fff;
  color: #990a04;
}

.member-row__confirm {
  flex-basis: 100%;
  flex-wrap: wrap;
  justify-content: flex-end;
  font-size: 24rpx;
}

.member-search {
  margin-top: 28rpx;
}

.member-search__bar {
  margin-top: 18rpx;
}

.member-search__input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 16rpx;
  border: 2rpx solid rgba(32, 29, 23, 0.24);
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #fff;
  font-size: 24rpx;
}

.member-search__button {
  background: #176a4b;
  color: #fff;
}

.member-candidate {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 96rpx;
  padding: 12rpx 8rpx;
  border-bottom: 2rpx solid rgba(32, 29, 23, 0.1);
  box-sizing: border-box;
}

.member-candidate--selected {
  background: rgba(23, 106, 75, 0.08);
}

.member-candidate__radio {
  flex: none;
}

.member-search__selection {
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20rpx;
}

.member-search__selected {
  flex: 1 1 220rpx;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.member-panel button[disabled] {
  opacity: 0.55;
}

@media (max-width: 380px) {
  .schedule-page__heading {
    align-items: flex-start;
  }

  .schedule-page__create {
    min-width: 136rpx;
    padding: 0 18rpx;
  }

  .schedule-filters,
  .lesson-row__time {
    flex-wrap: wrap;
  }

  .schedule-filter {
    flex-basis: 250rpx;
  }
}
