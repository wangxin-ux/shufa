@import "../runtime/operator-tokens.wxss";

.teacher-page {
  position: relative;
  min-width: 0;
  padding: 8rpx 18rpx 64rpx;
  font-family: var(--operator-font-body), "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  line-height: 1.55;
  letter-spacing: 0;
  color: var(--operator-ink);
}

.teacher-heading {
  padding: 0 0 12rpx;
}

.teacher-utility { position: absolute; top: -28rpx; right: 18rpx; display: flex; justify-content: flex-end; min-height: 44rpx; }
.teacher-utility__filter {
  min-width: 88rpx; min-height: 44rpx; margin: 0; padding: 0;
  background: transparent; font-size: 18rpx; line-height: 44rpx;
  color: var(--operator-muted);
}

.teacher-heading__title {
  display: block;
  font-family: var(--operator-font-display), "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 38rpx;
  font-weight: 400;
  line-height: 1.25;
}

.teacher-heading__summary,
.teacher-meta,
.teacher-note {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--operator-muted);
}

.teacher-page text,
.teacher-page button,
.teacher-page view {
  min-width: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
  box-sizing: border-box;
  letter-spacing: 0;
}

.teacher-page button {
  white-space: normal;
  font-family: inherit;
}

.teacher-page button::after {
  border: 0;
}

.teacher-search {
  display: flex;
  align-items: center;
  min-height: var(--operator-touch-min);
  margin-top: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 24rpx;
  background: var(--operator-glass);
}

.teacher-search__command {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: var(--operator-touch-min);
  min-height: var(--operator-touch-min);
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 34rpx;
  line-height: 1;
  color: var(--operator-ink);
}

.teacher-search__input {
  flex: 1;
  min-width: 0;
  height: var(--operator-touch-min);
  padding-right: 16rpx;
  font-size: 27rpx;
  color: var(--operator-ink);
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 300rpx;
  padding: 32rpx 0;
}

.page-state__title {
  font-size: 32rpx;
  font-weight: 700;
}

.page-state__message {
  display: block;
  margin-top: 14rpx;
  color: var(--operator-muted);
}

.teacher-list {
  margin-top: 0;
}

.teacher-row {
  margin-top: 26rpx;
}

.teacher-row__toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  min-height: 164rpx;
  margin: 0;
  padding: 24rpx 30rpx;
  border: 0;
  border-radius: var(--operator-card-radius);
  background: var(--operator-orange);
  box-shadow: var(--operator-shadow);
  text-align: left;
  color: #ffffff;
}

.teacher-row__name {
  flex: 1;
  font-family: var(--operator-font-display);
  font-size: 84rpx;
  font-weight: 400;
  line-height: 1.4;
}

.teacher-row__chevron {
  flex: none;
  width: 24rpx;
  font-size: 28rpx;
  line-height: 1.3;
  text-align: center;
  color: #ffffff;
}

.teacher-row .teacher-row__name--compact { font-size: 64rpx; }
.teacher-row .teacher-row__specialties-value--compact { font-size: 34rpx; }

.teacher-row__specialties {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.teacher-label {
  font-size: 23rpx;
  color: var(--operator-muted);
}

.teacher-row__specialties .teacher-label {
  flex: none;
}

.teacher-row__specialties-value {
  flex: 0 1 220rpx;
  font-family: var(--operator-font-display);
  font-size: 46rpx;
  line-height: 1.25;
  text-align: right;
}

.teacher-detail {
  margin-top: 26rpx;
  padding: 8rpx 30rpx 30rpx;
  border-radius: var(--operator-card-radius);
  background: #fe8e2e;
  box-shadow: var(--operator-shadow);
}

.teacher-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(32, 29, 23, 0.14);
}

.teacher-section__head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx 20rpx;
}

.teacher-section__title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
}

.teaching-class {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(32, 29, 23, 0.1);
}

.teaching-class__name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
}

.month-picker {
  min-width: 0;
  max-width: 100%;
}

.month-picker__value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 210rpx;
  min-height: var(--operator-touch-min);
  padding: 12rpx 16rpx;
  border-bottom: 2rpx solid var(--operator-orange);
  font-size: 25rpx;
}

.month-picker__chevron {
  flex: none;
  color: var(--operator-orange);
}

.teacher-metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.teacher-detail > .teacher-section:first-child {
  margin-top: 16rpx;
  padding-top: 0;
  border-top: 0;
}

.teacher-detail > .teacher-section:nth-child(2) {
  margin-top: 14rpx;
  padding-top: 0;
  border-top: 0;
}

.teacher-metric .teacher-label { font-size: 16rpx; }
.teacher-metric .teacher-metric__value--compact { font-size: 76rpx; }

.teacher-page:not(.teacher-page--tools) .teacher-detail .teacher-meta,
.teacher-page:not(.teacher-page--tools) .evaluation-meta,
.teacher-page:not(.teacher-page--tools) .teacher-guidance__label,
.teacher-page:not(.teacher-page--tools) .teacher-guidance,
.teacher-page:not(.teacher-page--tools) .teacher-detail > .teacher-section:nth-child(n+3),
.teacher-page:not(.teacher-page--tools) .teacher-detail > .teacher-section:nth-child(2) > .teacher-section__title {
  display: none;
}

.teacher-page:not(.teacher-page--tools) .teacher-section__head { justify-content: flex-end; }
.teacher-page:not(.teacher-page--tools) .teacher-section__head > .teacher-section__title { display: none; }
.teacher-page:not(.teacher-page--tools) .month-picker__value { min-height: 44rpx; font-size: 16rpx; }

.teacher-metric {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 0 8rpx 0 0;
}

.teacher-metric__value {
  font-family: var(--operator-font-display);
  font-size: 96rpx;
  font-weight: 400;
  line-height: 1.05;
  color: #000000;
}

.evaluation-meta {
  margin-top: 18rpx;
}

.evaluation-meta__author {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
}

.teacher-ratings {
  margin-top: 18rpx;
}

.teacher-rating {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx 16rpx;
  min-height: 64rpx;
  padding: 0;
  margin-bottom: 8rpx;
}

.teacher-rating__label {
  font-family: var(--operator-font-display);
  font-size: 38rpx;
  color: #ffffff;
}

.teacher-rating__score {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 14rpx;
}

.rating-stars {
  display: flex;
  flex: none;
  gap: 4rpx;
  height: 61rpx;
}

.rating-star {
  position: relative;
  flex: none;
  width: 64rpx;
  height: 61rpx;
  font-family: "Arial", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 36rpx;
}

.rating-star__base {
  display: block;
  width: 64rpx;
  height: 61rpx;
  filter: grayscale(1);
  opacity: 0.25;
}

.rating-star__fill {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 64rpx;
  height: 61rpx;
  overflow: hidden;
  white-space: nowrap;
  color: #ffdf72;
}

.rating-star__fill--full {
  width: 100%;
}

.rating-star__fill--half {
  width: 64rpx;
  clip-path: inset(0 50% 0 0);
}

.rating-star__fill--empty {
  width: 0;
}

.teacher-rating__value {
  font-size: 16rpx;
  color: var(--operator-red);
}

.teacher-guidance__label {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.teacher-guidance {
  display: block;
  margin-top: 10rpx;
  white-space: pre-wrap;
  font-size: 26rpx;
  line-height: 1.75;
}

.evaluation-revision {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(32, 29, 23, 0.12);
}

.teacher-notice {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 16rpx;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--operator-red);
}

.teacher-notice__message {
  flex: 1 1 240rpx;
}

.teacher-command {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--operator-touch-min);
  margin: 20rpx 0 0;
  padding: 16rpx 24rpx;
  border: 0;
  border-radius: 8rpx;
  background: var(--operator-surface);
  font-size: 25rpx;
  line-height: 1.4;
  color: var(--operator-ink);
}

.teacher-command--primary {
  background: var(--operator-orange);
  color: #ffffff;
}

.teacher-command--text {
  flex: none;
  margin-top: 0;
  padding: 12rpx 16rpx;
  background: transparent;
  color: var(--operator-red);
}

.teacher-command--more {
  width: 100%;
  border: 2rpx solid rgba(32, 29, 23, 0.14);
  background: transparent;
}

.teacher-page button[disabled] {
  opacity: 0.55;
}

.control--hover {
  opacity: 0.72;
}

.teacher-metric .teacher-metric__value--percent { font-size:72rpx; white-space:nowrap; }
.teacher-metric .teacher-metric__value--long-percent { font-size:56rpx; }
