<operator-page-shell
  markTitle="首页"
  homePage="{{true}}"
  markIcon="/pages/operator/assets/page-mark-pdf.png" markIconSize="44"
>
  <view class="home">
    <view wx:if="{{viewState === 'loading'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">正在加载校区数据</text>
    </view>

    <view wx:elif="{{viewState === 'forbidden'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">无访问权限</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-state__retry" bindtap="onLogin" hover-class="button--hover">重新登录</button>
    </view>

    <view wx:elif="{{viewState === 'error'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">校区数据加载失败</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-state__retry" bindtap="onRetry" hover-class="button--hover">重试</button>
    </view>

    <view
      wx:elif="{{viewState === 'ready' || viewState === 'empty'}}"
      class="home__content home__content--{{viewState}}"
    >
      <view wx:if="{{refreshError}}" class="home-notice" aria-live="polite">
        <text>{{refreshError}}</text>
        <button class="home__more" bindtap="onRetry">重试</button>
      </view>
      <view class="home__pending-head">
        <text class="home__title">待处理</text>
        <button
          class="home__more"
          data-key="approvals"
          bindtap="onActionTap"
          hover-class="button--hover"
        >查看更多</button>
      </view>

      <button
        class="pending"
        bindtap="onLatestLeaveTap"
        hover-class="pending--hover"
        aria-label="进入请假审批"
      >
        <view class="pending__count">
          <text class="pending__value {{pendingCount.length > 2 ? 'pending__value--compact' : ''}}">{{pendingCount}}</text>
          <text class="pending__unit">{{pendingUnit}}</text>
        </view>
        <view class="pending__divider" aria-hidden="true"></view>
        <view class="pending__detail">
          <text class="pending__latest">{{latestLabel}}</text>
          <text class="pending__status">{{latestStatus}}</text>
        </view>
      </button>

      <view class="home__stage">
        <image
          class="home__character"
          src="/pages/operator/assets/home-character.png"
          mode="widthFix"
          aria-hidden="true"
        />
        <view class="home__identity-row">
          <button
            class="home__identity"
            data-key="profile"
            bindtap="onActionTap"
            hover-class="button--hover"
            aria-label="进入运营我的页面"
          >
            <text class="home__campus">{{campusName}}</text>
            <view class="home__manager">
              <text class="home__manager-name">{{managerName}}</text>
              <text class="home__manager-role">· 校区运营</text>
            </view>
          </button>
          <button
            class="home__settings"
            data-key="settings"
            bindtap="onActionTap"
            hover-class="button--hover"
          >校区设置</button>
        </view>
        <operator-stat-strip class="home__stats" items="{{stats}}" />
      </view>

      <view class="home__footer">
        <view class="quick-actions">
          <button
            wx:for="{{actions}}"
            wx:key="key"
            class="quick-action {{item.key === 'student-create' ? 'quick-action--active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onActionTap"
            hover-class="quick-action--hover"
          >
            <image class="quick-action__icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" />
            <text class="quick-action__label">{{item.label}}</text>
          </button>
        </view>
        <view class="home__footer-commands">
          <button
            class="home__menu-toggle"
            bindtap="onMenuToggle"
            aria-expanded="{{menuExpanded}}"
            hover-class="button--hover"
          >{{menuExpanded ? '收起菜单' : '查看更多'}}</button>
        </view>
      </view>
      <view wx:if="{{menuExpanded}}" class="home-menu">
        <button
          wx:for="{{menuActions}}"
          wx:key="key"
          class="home-menu__item"
          data-key="{{item.key}}"
          bindtap="onActionTap"
          hover-class="button--hover"
        >
          <text>{{item.label}}</text>
          <text aria-hidden="true">›</text>
        </button>
      </view>
    </view>
  </view>
</operator-page-shell>
