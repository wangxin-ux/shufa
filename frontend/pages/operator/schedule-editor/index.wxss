@import "../runtime/operator-tokens.wxss";
@import "../runtime/components/operator-page-shell/operator-page-shell.wxss";

.schedule-editor { padding: 42rpx 18rpx 64rpx; }
.schedule-editor__title { position:absolute; width:1rpx; height:1rpx; overflow:hidden; clip-path:inset(50%); }
.schedule-control { display: flex; align-items: center; justify-content: center; min-height: var(--operator-touch-min); margin: 0; padding: 0 24rpx; box-sizing: border-box; border: 0; border-radius: 16rpx; font-size: 24rpx; line-height: 1.2; }
.schedule-control::after { border: 0; }
.schedule-control[disabled] { opacity: 0.58; }
.schedule-form { position: relative; display:flex; flex-direction:column; min-height:681rpx; margin-top:0; padding:30rpx; box-sizing:border-box; border-radius:24rpx; background:var(--operator-panel); box-shadow:var(--operator-shadow); }
.schedule-form__character { position:absolute; right:0; bottom:0; width:470rpx; opacity:.25; pointer-events:none; }
.schedule-form > view { position: relative; z-index: 1; }
.schedule-form__field { display: flex; flex-direction: column; min-width: 0; margin-top: 24rpx; }
.schedule-form > .schedule-form__field:first-child { margin-top: 0; }
.schedule-form__label { font-family: var(--operator-font-display); font-size: 27rpx; font-weight: 400; }
.schedule-form__picker { display: flex; align-items: center; width: 100%; min-height: var(--operator-touch-min); margin-top: 10rpx; padding: 0 20rpx; box-sizing: border-box; border: 2rpx solid rgba(32, 29, 23, 0.14); border-radius: 14rpx; background: rgba(255, 255, 255, 0.78); }
.schedule-form__value { max-width: 100%; overflow-wrap: anywhere; font-size: 25rpx; line-height: 1.4; color: var(--operator-ink); padding: 12rpx 0; }
.schedule-form__value--placeholder { color: #77736c; }
.schedule-form__derived { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 18rpx; }
.schedule-form__derived-item { display: flex; flex-direction: column; min-width: 0; padding: 18rpx 20rpx; border-radius: 14rpx; background: rgba(255, 116, 71, 0.12); }
.schedule-form__derived-label { font-size: 20rpx; color: var(--operator-muted); }
.schedule-form__derived-value { margin-top: 7rpx; overflow-wrap: anywhere; font-size: 25rpx; font-weight: 700; }
.schedule-form__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16rpx; }
.schedule-form__field--wide { grid-column: 1 / -1; }
.schedule-form__error, .schedule-notice__message { display: block; margin-top: 22rpx; overflow-wrap: anywhere; font-size: 24rpx; color: #9b1919; }
.schedule-form__actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:30rpx; margin-top:auto; padding-top:40rpx; }
.schedule-form__submit, .page-state__retry { background: var(--operator-orange); color: #ffffff; }
.schedule-form__submit { min-height:112rpx; border-radius:34rpx; background:var(--operator-success); font-family:var(--operator-font-display); font-size:96rpx; font-weight:400; }
.schedule-form__cancel { min-height:112rpx; border-radius:34rpx; background:var(--operator-orange); color:#fff; font-family:var(--operator-font-display); font-size:96rpx; }
.schedule-form__section-title { position:relative; z-index:1; display:block; font-family:var(--operator-font-display); font-size:34rpx; line-height:1.2; color:#2c453f; }
.schedule-form__basic { display:grid; grid-template-columns:1fr 1.2fr 1.6fr; align-items:stretch; gap:16rpx; margin-top:14rpx; padding-bottom:18rpx; border-bottom:3rpx solid #fff; }
.schedule-form__basic .schedule-form__picker { margin-top:0; padding:0 16rpx; border:0; background:#fff; }
.schedule-form__basic .schedule-form__value { font-size:22rpx; }
.schedule-form__selector, .schedule-form__roster { display:flex; align-items:center; justify-content:space-between; gap:12rpx; min-width:0; min-height:88rpx; margin:0; padding:0 18rpx; border:0; border-radius:14rpx; background:#fff; font-size:22rpx; line-height:1.2; color:#243b36; }
.schedule-form__selector::after, .schedule-form__roster::after { border:0; }
.schedule-form__roster-section { margin-top:26rpx; padding-bottom:22rpx; border-bottom:3rpx solid #fff; }
.schedule-form__roster { width:100%; margin-top:16rpx; }
.schedule-form__class-meta { position:relative; z-index:1; margin-top:14rpx; font-size:18rpx; color:#2c453f; }
.schedule-options-layer { position:fixed; inset:0; z-index:100; display:flex; align-items:flex-end; }
.schedule-options-backdrop { position:absolute; inset:0; background:rgba(0,0,0,.28); }
.schedule-options-sheet { position:relative; height:78vh; width:100%; padding:24rpx 32rpx 48rpx; box-sizing:border-box; border-radius:28rpx 28rpx 0 0; background:#fffaf0; }
.schedule-options-heading { display:flex; justify-content:space-between; align-items:center; font-size:32rpx; }
.schedule-options-heading button { min-width:120rpx; min-height:88rpx; margin:0; background:#fe8419; color:#fff; font-size:28rpx; }
.schedule-editor__back { background: rgba(255, 255, 255, 0.78); color: var(--operator-ink); }
.page-state { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; min-height: 390rpx; margin-top: 26rpx; padding: 34rpx; box-sizing: border-box; border-radius: 16rpx; background: var(--operator-glass); }
.page-state__title { font-family: var(--operator-font-display); font-size: 38rpx; font-weight: 400; }
.page-state__message { margin-top: 14rpx; overflow-wrap: anywhere; font-size: 25rpx; color: var(--operator-muted); }
.page-state__retry, .schedule-editor__back { margin-top: 24rpx; }
.series-mode { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8rpx; margin-bottom: 24rpx; }
.series-mode__option { background: #fff; color: var(--operator-ink); border: 2rpx solid rgba(32, 29, 23, 0.2); }
.series-mode__option--selected { background: #176a4b; color: #fff; border-color: #176a4b; }
.series-weekdays { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 10rpx; }
.series-weekdays__day { display: flex; align-items: center; min-height: 88rpx; font-size: 25rpx; gap: 8rpx; }
.series-preview { margin-top: 24rpx; padding-top: 22rpx; border-top: 2rpx solid rgba(32, 29, 23, 0.15); }
.series-preview__meta { display: block; margin-top: 8rpx; font-size: 23rpx; line-height: 1.5; color: var(--operator-muted); overflow-wrap: anywhere; }
.series-preview__title { display: block; margin: 24rpx 0 12rpx; font-size: 28rpx; font-weight: 700; }
.series-preview__row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8rpx; min-height: 64rpx; padding: 12rpx 0; box-sizing: border-box; border-bottom: 2rpx solid rgba(32, 29, 23, 0.12); font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }
.series-preview__row--conflict { color: #990a04; font-weight: 700; }
