@import "../../operator-tokens.wxss";

.shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background: linear-gradient(
    180deg,
    var(--operator-yellow-top) 0%,
    var(--operator-yellow-mid) 48%,
    var(--operator-yellow-bottom) 100%
  );
  color: var(--operator-ink);
  font-family: var(--operator-font-body);
}

.shell--surface {
  background: var(--operator-surface);
}

.shell--account { background: #ffffff; }
.shell--account::before {
  position: absolute; top: 0; left: -20%; width: 140%; height: 680rpx;
  border-radius: 0 0 40% 15%; background: #f6d469; content: ''; pointer-events: none;
}

.shell__wave {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 228rpx;
  filter: drop-shadow(0 6rpx 18rpx rgba(0, 32, 54, 0.34));
  pointer-events: none;
}

.shell__wave::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--operator-surface);
  clip-path: polygon(
    0% 0%,
    100% 0%,
    100% 95.9%,
    98.5% 95.9%,
    95.2% 95.3%,
    91.9% 94%,
    88.6% 93.3%,
    85.3% 91.4%,
    82% 89.5%,
    78.8% 88.3%,
    75.5% 85.7%,
    72.2% 83.2%,
    68.9% 80.6%,
    65.6% 77.5%,
    62.4% 74.3%,
    59.1% 71.1%,
    55.8% 67.3%,
    52.5% 64.1%,
    49.2% 61%,
    45.9% 57.8%,
    42.7% 54.6%,
    39.4% 52.1%,
    36.1% 49.5%,
    32.8% 48.3%,
    29.5% 46.4%,
    26.3% 45.1%,
    23% 44.5%,
    19.7% 44.5%,
    16.4% 44.5%,
    13.1% 45.1%,
    9.8% 45.7%,
    6.6% 47%,
    3.3% 48.9%,
    0% 50.2%
  );
}

.shell__header,
.shell__body {
  position: relative;
  z-index: 1;
}

.shell__tools { display: flex; flex: none; margin-left: auto; }

.shell__header-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: var(--operator-header-height) !important;
  box-sizing: border-box;
  padding-left: 24rpx;
}

.shell__header-inner--surface {
  align-items: center;
  min-height: var(--operator-header-height) !important;
}

.shell__header-inner--home { min-height:150rpx !important; }

.shell__mark {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: var(--role-page-mark-size);
  min-width: var(--role-page-mark-size);
  height: var(--role-page-mark-size);
  border-radius: 50%;
  background: var(--role-page-mark-background);
  box-shadow: var(--role-page-mark-shadow);
}

.shell__mark-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--role-page-mark-icon-size);
  height: var(--role-page-mark-icon-size);
}

.shell__mark-icon {
  flex: none;
  pointer-events: none;
}

.shell__mark-icon--glyph {
  width: var(--role-page-mark-icon-size);
  height: var(--role-page-mark-icon-size);
}

.shell__mark-icon--framed {
  width: var(--role-page-mark-icon-size);
  height: var(--role-page-mark-icon-size);
}

.shell__mark--plain {
  justify-content: center;
  width: var(--role-profile-mark-width);
  min-width: var(--role-profile-mark-width);
  height: var(--role-profile-mark-height);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.shell__mark-disc--plain {
  width: var(--role-profile-mark-icon-size);
  height: var(--role-profile-mark-icon-size);
  overflow: visible;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.shell__mark-icon--plain {
  width: var(--role-profile-mark-icon-size);
  height: var(--role-profile-mark-icon-size);
}

.shell__mark--plain .shell__mark-title {
  margin-top: 0;
  font-family: var(--operator-font-body);
  font-size: var(--role-profile-mark-font-size);
  line-height: 1.2;
}

.shell__mark-title {
  max-width: 72rpx;
  margin-top: var(--role-page-mark-title-gap);
  font-family: var(--operator-font-body);
  font-size: var(--role-page-mark-title-font-size);
  font-weight: 700;
  line-height: 1.2;
  color: var(--role-page-mark-ink);
  text-align: center;
}

.shell__back {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: var(--role-back-size);
  height: var(--role-back-size);
  margin: 2rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--role-back-background);
  box-shadow: var(--role-back-shadow);
  line-height: 1;
}

.shell__header-inner--surface .shell__back {
  margin-top: 0;
}

.shell__back::after {
  border: 0;
}

.shell__back--hover {
  opacity: 0.72;
}

.shell__back-icon {
  margin-top: var(--role-back-icon-offset-y);
  font-size: var(--role-back-icon-size);
  line-height: 1;
  color: var(--parent-ink);
}

.shell__body {
  box-sizing: border-box;
  padding: 0 var(--operator-page-gap) 42rpx;
}
