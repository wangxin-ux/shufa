<super-admin-page-shell show-back fallback-url="/pages/finance/more/index" mark-title="流水" mark-icon="/pages/finance/assets/icon-receipts.png">
  <view class="workspace finance-overview">
    <view class="workspace__head"><view><text class="workspace__title">资金流水</text><text class="workspace__subtitle">已确认收款、实际退费和已完成教师提现</text></view></view>
    <view class="toolbar overview-filters"><picker range="{{campuses}}" range-key="name" value="{{campusIndex}}" bindchange="onCampusChange"><view class="select">{{campuses[campusIndex].name}}</view></picker><button class="button button--ghost" loading="{{exporting}}" disabled="{{exporting}}" bindtap="onExport">导出 Excel</button><view class="overview-dates"><picker mode="date" value="{{startDate}}" bindchange="onStartChange"><view class="select">{{startDate}}</view></picker><text class="overview-date-separator">至</text><picker mode="date" value="{{endDate}}" bindchange="onEndChange"><view class="select">{{endDate}}</view></picker></view></view>
    <text wx:if="{{exportError}}" class="notice">{{exportError}}</text>
    <view wx:if="{{viewState === 'ready' || viewState === 'empty'}}" class="metrics"><view class="metric"><text class="metric__label">收入</text><text class="metric__value">{{inflowLabel}}</text></view><view class="metric"><text class="metric__label">支出</text><text class="metric__value">{{outflowLabel}}</text></view><view class="metric"><text class="metric__label">收支差额</text><text class="metric__value">{{balanceLabel}}</text></view><view class="metric"><text class="metric__label">手续费</text><text class="metric__value">未记录</text></view></view>
    <view class="notice">当前支付流水没有服务商结算手续费字段，因此手续费保持“未记录”，不按 0 元计入利润。</view>
    <view wx:if="{{viewState === 'loading'}}" class="state"><text class="state__title">正在加载资金流水</text></view><view wx:elif="{{viewState === 'forbidden'}}" class="state"><text class="state__title">请使用总部财务账号</text></view><view wx:elif="{{viewState === 'error'}}" class="state"><text class="state__title">暂时无法加载</text><text class="state__message">{{errorMessage}}</text><button class="button" bindtap="onRetry">重试</button></view><view wx:elif="{{viewState === 'empty'}}" class="state"><text class="state__title">暂无资金流水</text></view>
    <view wx:else class="list"><view class="row" wx:for="{{rows}}" wx:key="id"><view class="row__main"><view class="overview-row-head"><text class="row__title">{{item.subjectName}}</text><text class="status {{item.direction === 'INFLOW' ? 'status--success' : 'status--danger'}}">{{item.directionLabel}}</text></view><text class="row__meta">{{item.campusName}} · {{item.type}}</text><text class="row__meta">{{item.timeLabel}} · {{item.status}}</text></view><text class="row__value">{{item.amountLabel}}</text></view><button wx:if="{{hasMore}}" class="button" bindtap="onLoadMore">加载更多</button></view>
  </view>
</super-admin-page-shell>
