<super-admin-page-shell show-back fallback-url="/pages/finance/more/index" mark-title="订单" mark-icon="/pages/finance/assets/icon-receipts.png">
  <view class="workspace finance-overview">
    <view class="workspace__head"><view><text class="workspace__title">订单与凭证</text><text class="workspace__subtitle">全平台订单、收款凭证和既有审核状态</text></view></view>
    <view class="toolbar overview-filters"><picker range="{{campuses}}" range-key="name" value="{{campusIndex}}" bindchange="onCampusChange"><view class="select">{{campuses[campusIndex].name}}</view></picker><picker range="{{statuses}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange"><view class="select">{{statuses[statusIndex].label}}</view></picker><input class="field" value="{{keyword}}" bindinput="onKeywordInput" placeholder="学员姓名或订单号" maxlength="100" /><view class="overview-dates"><picker mode="date" value="{{startDate}}" bindchange="onStartChange"><view class="select">{{startDate}}</view></picker><text class="overview-date-separator">至</text><picker mode="date" value="{{endDate}}" bindchange="onEndChange"><view class="select">{{endDate}}</view></picker></view></view>
    <view wx:if="{{viewState === 'ready' || viewState === 'empty'}}" class="metrics"><view class="metric"><text class="metric__label">订单记录</text><text class="metric__value">{{total}} 笔</text></view></view>
    <view wx:if="{{viewState === 'loading'}}" class="state"><text class="state__title">正在加载订单</text></view><view wx:elif="{{viewState === 'forbidden'}}" class="state"><text class="state__title">请使用总部财务账号</text></view><view wx:elif="{{viewState === 'error'}}" class="state"><text class="state__title">暂时无法加载</text><text class="state__message">{{errorMessage}}</text><button class="button" bindtap="onRetry">重试</button></view><view wx:elif="{{viewState === 'empty'}}" class="state"><text class="state__title">暂无订单记录</text></view>
    <view wx:else class="list"><view class="row" wx:for="{{rows}}" wx:key="id"><view class="row__main"><view class="overview-row-head"><text class="row__title">{{item.studentName}} · {{item.productName}}</text><text class="status {{item.status === 'EFFECTIVE' || item.status === 'PAID' ? 'status--success' : ''}}">{{item.statusLabel}}</text></view><text class="row__meta">{{item.campusName}} · {{item.sourceLabel}}</text><text class="row__meta">订单 {{item.orderNo}} · {{item.createdLabel}}</text><button wx:if="{{item.proofAvailable}}" class="button button--ghost" data-id="{{item.id}}" loading="{{proofLoadingId === item.id}}" disabled="{{!!proofLoadingId}}" bindtap="onProof">查看收款凭证</button><text wx:else class="row__meta">暂无收款凭证</text></view><text class="row__value">{{item.amountLabel}}</text></view><button wx:if="{{hasMore}}" class="button" bindtap="onLoadMore">加载更多</button></view>
  </view>
</super-admin-page-shell>
