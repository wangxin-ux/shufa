<super-admin-page-shell show-back fallback-url="/pages/finance/more/index" mark-title="成本" mark-icon="/pages/finance/assets/icon-reports.png">
  <view class="workspace finance-overview">
    <view class="workspace__head"><view><text class="workspace__title">成本收益</text><text class="workspace__subtitle">按期间、地址地区和单个或多个校区汇总</text></view></view>
    <view class="roster-tabs"><button wx:for="{{periods}}" wx:key="code" class="roster-tab {{period === item.code ? 'roster-tab--active' : ''}}" data-period="{{item.code}}" bindtap="onPeriod">{{item.label}}</button></view>
    <view class="toolbar overview-filters"><input class="field" value="{{region}}" bindinput="onRegionInput" bindconfirm="onRegionConfirm" confirm-type="search" placeholder="按校区地址筛选地区" maxlength="100" /><button class="button button--ghost" bindtap="onRegionConfirm">查询</button><view class="overview-dates"><picker mode="date" value="{{startDate}}" bindchange="onStartChange"><view class="select">{{startDate}}</view></picker><text class="overview-date-separator">至</text><picker mode="date" value="{{endDate}}" bindchange="onEndChange"><view class="select">{{endDate}}</view></picker></view></view>
    <view class="form"><text class="form__label">校区范围（不选表示全部）</text><checkbox-group class="overview-campus-checks" bindchange="onCampusesChange"><label class="overview-campus-check" wx:for="{{campusOptions}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#f07d2b" /><text>{{item.name}}</text></label></checkbox-group><button class="button button--ghost" loading="{{exporting}}" disabled="{{exporting}}" bindtap="onExport">导出 Excel</button></view>
    <text wx:if="{{exportError}}" class="notice">{{exportError}}</text>
    <view wx:if="{{viewState === 'ready' || viewState === 'empty'}}" class="metrics"><view class="metric"><text class="metric__label">课耗营收</text><text class="metric__value">{{grossLabel}}</text></view><view class="metric"><text class="metric__label">教师课时费</text><text class="metric__value">{{teacherLabel}}</text></view><view class="metric"><text class="metric__label">合作方收益</text><text class="metric__value">{{partnerLabel}}</text></view><view class="metric"><text class="metric__label">实际退费</text><text class="metric__value">{{refundLabel}}</text></view><view class="metric"><text class="metric__label">已知贡献</text><text class="metric__value">{{contributionLabel}}</text></view><view class="metric"><text class="metric__label">净收益</text><text class="metric__value">待手续费事实</text></view></view>
    <view class="notice">已知贡献 = 课耗营收 - 教师课时费 - 合作方收益 - 实际退费。手续费尚无结算字段，因此净收益不伪造为 0。</view>
    <view wx:if="{{viewState === 'loading'}}" class="state"><text class="state__title">正在汇总成本收益</text></view><view wx:elif="{{viewState === 'forbidden'}}" class="state"><text class="state__title">请使用总部财务账号</text></view><view wx:elif="{{viewState === 'error'}}" class="state"><text class="state__title">暂时无法加载</text><text class="state__message">{{errorMessage}}</text><button class="button" bindtap="onRetry">重试</button></view><view wx:elif="{{viewState === 'empty'}}" class="state"><text class="state__title">暂无成本收益数据</text></view>
    <view wx:else class="list"><view class="row" wx:for="{{rows}}" wx:key="campusId"><view class="row__main"><text class="row__title">{{item.campusName}}</text><text class="row__meta">{{item.regionLabel}}</text><text class="row__meta">课耗 {{item.grossLabel}} · 教师 {{item.teacherLabel}}</text><text class="row__meta">合作方 {{item.partnerLabel}} · 退费 {{item.refundLabel}}</text></view><text class="row__value">{{item.contributionLabel}}</text></view></view>
  </view>
</super-admin-page-shell>
