<super-admin-page-shell show-back fallback-url="/pages/finance/more/index" mark-title="收益" mark-icon="/pages/finance/assets/icon-reports.png">
  <view class="workspace finance-overview">
    <view class="workspace__head"><view><text class="workspace__title">经营收益</text><text class="workspace__subtitle">各校区内部课耗营收、平台留存与合作方分成</text></view></view>
    <view class="roster-tabs"><button wx:for="{{periods}}" wx:key="code" class="roster-tab {{period === item.code ? 'roster-tab--active' : ''}}" data-period="{{item.code}}" bindtap="onPeriod">{{item.label}}</button></view>
    <view class="toolbar overview-filters"><picker range="{{campuses}}" range-key="name" value="{{campusIndex}}" bindchange="onCampusChange"><view class="select">{{campuses[campusIndex].name}}</view></picker><view class="overview-dates"><picker mode="date" value="{{startDate}}" bindchange="onStartChange"><view class="select">{{startDate}}</view></picker><text class="overview-date-separator">至</text><picker mode="date" value="{{endDate}}" bindchange="onEndChange"><view class="select">{{endDate}}</view></picker></view></view>
    <view wx:if="{{viewState === 'ready' || viewState === 'empty'}}" class="metrics"><view class="metric"><text class="metric__label">课耗营收</text><text class="metric__value">{{grossLabel}}</text></view><view class="metric"><text class="metric__label">平台留存</text><text class="metric__value">{{platformLabel}}</text></view><view class="metric"><text class="metric__label">合作方收益</text><text class="metric__value">{{partnerLabel}}</text></view><view class="metric"><text class="metric__label">教师课时费</text><text class="metric__value">{{teacherLabel}}</text></view></view>
    <text class="overview-note">课耗营收沿用总端内部规则快照；平台留存尚未扣教师课时费和其他成本，不等于净利润。</text>
    <view wx:if="{{viewState === 'loading'}}" class="state"><text class="state__title">正在汇总经营收益</text></view><view wx:elif="{{viewState === 'forbidden'}}" class="state"><text class="state__title">请使用总部财务账号</text></view><view wx:elif="{{viewState === 'error'}}" class="state"><text class="state__title">暂时无法加载</text><text class="state__message">{{errorMessage}}</text><button class="button" bindtap="onRetry">重试</button></view><view wx:elif="{{viewState === 'empty'}}" class="state"><text class="state__title">暂无经营收益记录</text></view>
    <view wx:else class="list"><view class="row" wx:for="{{rows}}" wx:key="campusId"><view class="row__main"><text class="row__title">{{item.campusName}}</text><text class="row__meta">{{item.regionLabel}}</text><text class="row__meta">课耗营收 {{item.grossLabel}} · 平台留存 {{item.platformLabel}}</text><text class="row__meta">合作方 {{item.partnerLabel}} · 教师课时费 {{item.teacherLabel}}</text></view><text class="row__value">{{item.contributionLabel}}</text></view></view>
  </view>
</super-admin-page-shell>
