<super-admin-page-shell
  mark-title="首页"
  mark-icon="/pages/finance/assets/home-mark-glyph.png"
>
  <view class="home home--{{viewState}}">
      <view wx:if="{{viewState === 'loading'}}" class="page-state" aria-live="polite">
        <text class="page-state__title">正在加载财务工作台</text>
      </view>

      <view wx:elif="{{viewState === 'forbidden'}}" class="page-state" aria-live="polite">
        <text class="page-state__title">无访问权限</text>
        <text class="page-state__message">{{errorMessage}}</text>
        <button class="page-state__exit" bindtap="onLogoutTap" hover-class="button--hover">退出登录</button>
      </view>

      <view wx:elif="{{viewState === 'error'}}" class="page-state" aria-live="polite">
        <text class="page-state__title">财务工作台加载失败</text>
        <text class="page-state__message">{{errorMessage}}</text>
        <button class="page-state__retry" bindtap="onRetry" hover-class="button--hover">重试</button>
      </view>

      <view wx:elif="{{viewState === 'ready'}}" class="home__content">
        <view class="home__head">
          <text class="home__title">日常财务</text>
          <button
            class="home__more"
            data-key="more"
            bindtap="onActionTap"
            hover-class="button--hover"
          >查看更多</button>
        </view>

        <button
          class="focus"
          data-key="packages"
          bindtap="onActionTap"
          hover-class="button--hover"
          aria-label="进入课包录入"
        >
          <view class="focus__mark">
            <text class="focus__value">课包</text>
            <text class="focus__unit">对应收款</text>
          </view>
          <view class="focus__divider" aria-hidden="true"></view>
          <view class="focus__detail">
            <text class="focus__name">课包录入</text>
            <text class="focus__summary">选择收款 · 购买课时 · 赠送课时</text>
          </view>
        </button>

        <view class="home__stage">
          <image
            class="home__character"
            src="/pages/finance/assets/home-character.png"
            mode="widthFix"
            aria-hidden="true"
          />

          <button
            class="home__identity"
            data-key="profile"
            bindtap="onActionTap"
            hover-class="button--hover"
            aria-label="进入我的"
          >
            <text class="home__display-name">{{displayName}}</text>
            <text class="home__identity-label">{{identityLabel}}</text>
          </button>

          <view class="home__work-strip">
            <image
              class="home__work-glass"
              src="/pages/finance/assets/home-stat-glass.png"
              mode="scaleToFill"
              aria-hidden="true"
            />
            <button
              wx:for="{{workItems}}"
              wx:key="key"
              class="home__work-item"
              data-key="{{item.key}}"
              bindtap="onActionTap"
                hover-class="button--hover"
              >
                <text class="home__work-label">{{item.label}}</text>
                <view class="home__work-number">
                  <text class="home__work-value">{{item.value}}</text>
                  <text class="home__work-unit">{{item.unit}}</text>
                </view>
                <text class="home__work-sub">{{item.sub}}</text>
              </button>
          </view>
        </view>

        <view class="home__footer">
          <view class="quick-actions">
            <button
              wx:for="{{actions}}"
              wx:key="key"
              class="quick-action {{item.key === 'packages' ? 'quick-action--active' : ''}}"
              data-key="{{item.key}}"
              bindtap="onActionTap"
              hover-class="quick-action--hover"
            >
              <image class="quick-action__icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" />
              <text class="quick-action__label">{{item.label}}</text>
            </button>
          </view>
          <button
            class="home__footer-more"
            data-key="more"
            bindtap="onActionTap"
            hover-class="button--hover"
          >查看更多</button>
        </view>
      </view>
  </view>
</super-admin-page-shell>
