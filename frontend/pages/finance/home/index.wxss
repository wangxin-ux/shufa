@import "../../../styles/tokens.wxss";

.home {
  position: relative;
  min-height: calc(100vh - 150rpx);
}

.home__head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 96rpx;
  padding-top: 38rpx;
}

.home__title {
  min-width: 0;
  overflow-wrap: anywhere;
  font-family: var(--super-admin-font-display);
  font-size: 62rpx;
  font-weight: 700;
  line-height: 1.08;
  color: #ffffff;
}

.home__more,
.home__footer-more,
.page-state__retry,
.page-state__exit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--role-home-more-height);
  margin: 0;
  padding: 0 var(--role-home-more-padding-x);
  box-sizing: border-box;
  border: var(--role-home-more-border);
  border-radius: 999rpx;
  background: transparent;
  font-size: var(--role-home-more-font-size);
  line-height: var(--role-home-more-height);
  color: #ffffff;
}

.home__more::after,
.home__footer-more::after,
.page-state__retry::after,
.page-state__exit::after,
.focus::after,
.home__identity::after,
.home__work-item::after,
.quick-action::after {
  border: 0;
}

.focus {
  display: grid;
  grid-template-columns: 210rpx 4rpx minmax(0, 1fr);
  align-items: center;
  width: 100%;
  min-height: 250rpx;
  margin: 10rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #ffffff;
  text-align: left;
}

.focus__mark,
.focus__detail {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.focus__mark {
  align-items: center;
}

.focus__value {
  max-width: 100%;
  font-family: var(--super-admin-font-display);
  font-size: 82rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--super-admin-danger);
  white-space: nowrap;
}

.focus__unit {
  margin-top: 22rpx;
  font-family: var(--super-admin-font-display);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--super-admin-danger);
}

.focus__divider {
  width: 4rpx;
  height: 132rpx;
  background: rgba(255, 255, 255, 0.96);
}

.focus__detail {
  padding-left: 34rpx;
}

.focus__name {
  font-family: var(--super-admin-font-display);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.15;
  color: #ffffff;
  overflow-wrap: anywhere;
}

.focus__summary {
  display: -webkit-box;
  max-width: 100%;
  margin-top: 12rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 24rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.9);
  overflow-wrap: anywhere;
}

.home__stage {
  position: relative;
  height: 800rpx;
  margin: -74rpx -32rpx 0;
  overflow: visible;
}

.home__character {
  position: absolute;
  top: -10rpx;
  left: 95rpx;
  z-index: 0;
  width: 655rpx;
  pointer-events: none;
}

.home__identity {
  position: absolute;
  right: 48rpx;
  bottom: 218rpx;
  left: 48rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  min-height: var(--super-admin-touch-min);
  margin: 0;
  padding: 8rpx 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--super-admin-ink);
  text-align: left;
}

.home__display-name {
  display: block;
  max-width: 100%;
  overflow: hidden;
  font-family: var(--super-admin-font-display);
  font-size: 43rpx;
  font-weight: 700;
  line-height: 1.12;
  color: var(--super-admin-ink);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home__identity-label {
  display: block;
  max-width: 100%;
  margin-top: 5rpx;
  overflow: hidden;
  font-size: 21rpx;
  color: var(--super-admin-muted);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home__work-strip {
  position: absolute;
  right: var(--role-home-glass-right);
  bottom: 68rpx;
  left: var(--role-home-glass-left);
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  height: var(--role-home-glass-height);
  overflow: hidden;
  box-sizing: border-box;
  border-radius: var(--role-home-glass-radius);
  background: transparent;
  box-shadow: var(--role-home-glass-shadow);
}

.home__work-glass {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.home__work-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 8rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.home__work-item + .home__work-item {
  border-left: 3rpx solid rgba(255, 255, 255, 0.88);
}

.home__work-label {
  max-width: 100%;
  overflow: hidden;
  font-size: 19rpx;
  color: var(--super-admin-accent);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home__work-number {
  display: flex;
  align-items: baseline;
  justify-content: center;
  max-width: 100%;
  margin-top: 8rpx;
}

.home__work-value {
  max-width: 100%;
  overflow: hidden;
  font-family: var(--super-admin-font-display);
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.08;
  color: #000000;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home__work-unit {
  flex: none;
  margin-left: 4rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #000000;
}

.home__work-sub {
  margin-top: 6rpx;
  font-size: 17rpx;
  color: rgba(48, 47, 43, 0.55);
}

.home__footer {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 166rpx;
  margin-top: -32rpx;
  padding: 0 16rpx;
}

.quick-actions {
  position: relative;
  flex: none;
  display: flex;
  align-items: flex-start;
  width: var(--role-home-nav-width);
  height: var(--role-home-nav-active-size);
  overflow: visible;
  background: transparent;
}

.quick-actions::before {
  position: absolute;
  top: 17rpx;
  left: 0;
  width: var(--role-home-nav-capsule-width);
  height: var(--role-home-nav-capsule-height);
  border-radius: 999rpx;
  background: var(--role-home-nav-background);
  box-shadow: var(--role-home-nav-shadow);
  content: '';
  pointer-events: none;
}

.quick-action {
  position: relative;
  z-index: 1;
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: var(--role-home-nav-item-width);
  min-width: var(--role-home-nav-item-width);
  min-height: var(--super-admin-touch-min);
  margin: 23rpx 0 0;
  padding: 4rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.2;
}

.quick-action:first-child {
  margin-left: 4rpx;
}

.quick-action--active {
  width: var(--role-home-nav-active-size);
  min-width: var(--role-home-nav-active-size);
  height: var(--role-home-nav-active-size);
  min-height: var(--role-home-nav-active-size);
  margin: 0 0 0 -13rpx;
  border-radius: 50%;
  background: var(--role-home-nav-active-background);
  box-shadow: var(--role-home-nav-active-shadow);
}

.quick-action__icon {
  width: 40rpx;
  height: 40rpx;
  pointer-events: none;
}

.quick-action__label {
  max-width: 100%;
  margin-top: 4rpx;
  overflow: hidden;
  font-size: 16rpx;
  color: var(--role-home-nav-ink);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-action--active .quick-action__icon {
  width: 54rpx;
  height: 56rpx;
}

.quick-action--active .quick-action__label {
  font-weight: 600;
}

.home__footer-more {
  flex: none;
  align-self: flex-start;
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 600rpx;
  padding: 70rpx 18rpx;
}

.page-state__title {
  max-width: 100%;
  overflow-wrap: anywhere;
  font-family: var(--super-admin-font-display);
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

.page-state__message {
  max-width: 100%;
  margin-top: 18rpx;
  overflow-wrap: anywhere;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.84);
}

.page-state__retry,
.page-state__exit {
  min-height: 72rpx;
  margin-top: 28rpx;
  padding: 0 30rpx;
  font-size: 24rpx;
  line-height: 72rpx;
}

.button--hover,
.quick-action--hover {
  opacity: 0.74;
}
