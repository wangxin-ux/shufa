<super-admin-page-shell show-back fallback-url="/pages/finance/more/index" mark-title="出款" mark-icon="/pages/finance/assets/icon-refunds.png">
  <view class="workspace finance-overview">
    <view class="workspace__head"><view><text class="workspace__title">提现与退费记录</text><text class="workspace__subtitle">只读查看家长实际退费、教师课时费提现及审核状态</text></view></view>
    <view class="roster-tabs"><button wx:for="{{categories}}" wx:key="code" class="roster-tab {{category === item.code ? 'roster-tab--active' : ''}}" data-category="{{item.code}}" bindtap="onCategory">{{item.label}}</button></view>
    <view class="toolbar overview-filters"><picker range="{{campuses}}" range-key="name" value="{{campusIndex}}" bindchange="onCampusChange"><view class="select">{{campuses[campusIndex].name}}</view></picker><view class="overview-dates"><picker mode="date" value="{{startDate}}" bindchange="onStartChange"><view class="select">{{startDate}}</view></picker><text class="overview-date-separator">至</text><picker mode="date" value="{{endDate}}" bindchange="onEndChange"><view class="select">{{endDate}}</view></picker></view></view>
    <view wx:if="{{partnerUnavailable}}" class="notice">合作方当前只有内部收益账本，尚未建立提现或对公出款流程，因此不会生成虚构的合作方提现记录。</view>
    <view wx:if="{{viewState === 'loading'}}" class="state"><text class="state__title">正在加载出款记录</text></view><view wx:elif="{{viewState === 'forbidden'}}" class="state"><text class="state__title">请使用总部财务账号</text></view><view wx:elif="{{viewState === 'error'}}" class="state"><text class="state__title">暂时无法加载</text><text class="state__message">{{errorMessage}}</text><button class="button" bindtap="onRetry">重试</button></view><view wx:elif="{{viewState === 'empty'}}" class="state"><text class="state__title">暂无出款记录</text><text class="state__message">当前类型、校区与日期范围内没有记录</text></view>
    <view wx:else class="list"><view class="row" wx:for="{{rows}}" wx:key="id"><view class="row__main"><view class="overview-row-head"><text class="row__title">{{item.subjectName}}</text><text class="status">{{item.statusLabel}}</text></view><text class="row__meta">{{item.categoryLabel}} · {{item.campusName}}</text><text class="row__meta">申请 {{item.requestedLabel}} · 完成 {{item.paidLabel}}</text><text class="row__meta">记录号 {{item.referenceNo}}</text></view><text class="row__value">{{item.amountLabel}}</text></view><button wx:if="{{hasMore}}" class="button" bindtap="onLoadMore">加载更多</button></view>
  </view>
</super-admin-page-shell>
