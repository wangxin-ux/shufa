.warnings-page {
  min-height: calc(100vh - 150rpx);
  padding-top: 20rpx;
  box-sizing: border-box;
}

.workspace-heading,
.warning-card__head,
.warning-card__balances {
  display: flex;
  align-items: center;
}

.workspace-heading {
  justify-content: space-between;
  gap: 20rpx;
}

.workspace-heading__title {
  max-width: 100%;
  overflow-wrap: anywhere;
  font-family: var(--campus-manager-font-display);
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
}

.workspace-heading__count {
  flex: none;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.86);
}

.warning-search {
  margin-top: 22rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: var(--campus-manager-shadow);
}

.warning-search__input {
  width: 100%;
  min-height: var(--campus-manager-touch-min);
  font-size: 27rpx;
}

.warning-list {
  margin-top: 24rpx;
}

.warning-card {
  width: 100%;
  max-width: 100%;
  margin-bottom: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 3rpx solid rgba(255, 116, 71, 0.82);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 18rpx rgba(63, 46, 15, 0.15);
}

.warning-card__head {
  justify-content: space-between;
  gap: 18rpx;
}

.warning-card__identity {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.warning-card__name {
  overflow: hidden;
  font-family: var(--campus-manager-font-display);
  font-size: 35rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.warning-card__class {
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 22rpx;
  color: var(--campus-manager-muted);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.warning-card__status {
  flex: none;
  padding: 9rpx 18rpx;
  border-radius: 22rpx;
  background: var(--campus-manager-orange);
  font-size: 22rpx;
  color: #ffffff;
}

.warning-card__balances {
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(241, 199, 85, 0.42);
}

.balance-cell {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 18rpx 6rpx;
  border-right: 2rpx solid rgba(255, 255, 255, 0.92);
}

.balance-cell:last-child {
  border-right: 0;
}

.balance-cell__value {
  max-width: 100%;
  overflow: hidden;
  font-family: var(--campus-manager-font-display);
  font-size: 39rpx;
  font-weight: 700;
  color: var(--campus-manager-red);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.balance-cell__label {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: var(--campus-manager-muted);
}

.balance-cell--total {
  background: rgba(255, 116, 71, 0.12);
}

.warning-card__threshold {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--campus-manager-muted);
}

.warning-load-more,
.page-state__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--campus-manager-touch-min);
  margin: 24rpx 0 0;
  border: 0;
  border-radius: 8rpx;
  background: var(--campus-manager-orange);
  font-size: 25rpx;
  color: #ffffff;
}

.warning-load-more {
  width: 100%;
}

.warning-load-more::after,
.page-state__retry::after {
  border: 0;
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 420rpx;
  margin-top: 24rpx;
  padding: 30rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.8);
}

.page-state__title {
  font-family: var(--campus-manager-font-display);
  font-size: 42rpx;
  font-weight: 700;
}

.page-state__message {
  max-width: 100%;
  margin-top: 14rpx;
  overflow-wrap: anywhere;
  font-size: 24rpx;
  color: var(--campus-manager-muted);
}

.button--hover {
  opacity: 0.72;
}
