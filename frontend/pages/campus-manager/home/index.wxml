<campus-manager-page-shell
  markTitle="首页"
  markIcon="/pages/campus-manager/assets/home-mark-glyph.png"
>
  <view class="home">
    <view wx:if="{{viewState === 'loading'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">正在加载校区数据</text>
    </view>

    <view wx:elif="{{viewState === 'forbidden'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">无访问权限</text>
      <text class="page-state__message">{{errorMessage}}</text>
    </view>

    <view wx:elif="{{viewState === 'error'}}" class="page-state" aria-live="polite">
      <text class="page-state__title">校区数据加载失败</text>
      <text class="page-state__message">{{errorMessage}}</text>
      <button class="page-state__retry" bindtap="onRetry" hover-class="button--hover">重试</button>
    </view>

    <view
      wx:elif="{{viewState === 'ready' || viewState === 'empty'}}"
      class="home__content home__content--{{viewState}}"
    >
      <view class="home__pending-head">
        <text class="home__title">待处理</text>
        <button
          class="home__more"
          data-key="approvals"
          bindtap="onActionTap"
          hover-class="button--hover"
        >查看更多</button>
      </view>

      <button
        class="pending"
        data-key="approvals"
        bindtap="onActionTap"
        hover-class="pending--hover"
        aria-label="进入请假审批"
      >
        <view class="pending__count">
          <text class="pending__value">{{pendingCount}}</text>
          <text class="pending__unit">{{pendingUnit}}</text>
        </view>
        <view class="pending__divider" aria-hidden="true"></view>
        <view class="pending__detail">
          <text class="pending__latest">{{latestLabel}}</text>
          <text class="pending__status">{{latestStatus}}</text>
        </view>
      </button>

      <view class="home__stage">
        <image
          class="home__character"
          src="/pages/campus-manager/assets/home-character.png"
          mode="widthFix"
          aria-hidden="true"
        />
        <view class="home__identity-row">
          <button
            class="home__identity"
            data-key="profile"
            bindtap="onActionTap"
            hover-class="button--hover"
            aria-label="进入管理员我的页面"
          >
            <text class="home__campus">{{campusName}}</text>
            <text class="home__manager">{{managerName}} · 分校区管理员</text>
          </button>
          <button
            class="home__settings"
            data-key="settings"
            bindtap="onActionTap"
            hover-class="button--hover"
          >校区设置</button>
        </view>
        <campus-manager-stat-strip class="home__stats" items="{{stats}}" />
      </view>

      <view class="home__footer">
        <view class="quick-actions">
          <button
            wx:for="{{actions}}"
            wx:key="key"
            class="quick-action {{item.key === 'students' ? 'quick-action--active' : ''}}"
            data-key="{{item.key}}"
            bindtap="onActionTap"
            hover-class="quick-action--hover"
          >
            <image class="quick-action__icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" />
            <text class="quick-action__label">{{item.label}}</text>
          </button>
        </view>
          <button
            class="home__students"
            data-key="student-create"
            bindtap="onActionTap"
            hover-class="button--hover"
          >快捷录入</button>
      </view>
    </view>
  </view>
</campus-manager-page-shell>
