.schedule-page {
  padding: 24rpx 0 64rpx;
}

.schedule-page__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  min-height: 164rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--campus-manager-orange);
  box-shadow: var(--campus-manager-shadow);
}

.schedule-page__heading-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.schedule-page__title {
  overflow-wrap: anywhere;
  font-family: var(--campus-manager-font-display);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.15;
  color: #ffffff;
}

.schedule-page__summary {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.88);
}

.schedule-control {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--campus-manager-touch-min);
  margin: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.2;
}

.schedule-control::after {
  border: 0;
}

.schedule-page__create {
  flex: none;
  min-width: 150rpx;
  background: #ffffff;
  color: var(--campus-manager-ink);
}

.schedule-filters {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-top: 24rpx;
}

.schedule-filter {
  flex: 1;
  min-width: 0;
  min-height: var(--campus-manager-touch-min);
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.66);
  border-radius: 16rpx;
  background: var(--campus-manager-glass);
}

.schedule-filter__content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: var(--campus-manager-touch-min);
  gap: 14rpx;
}

.schedule-filter__label {
  flex: none;
  font-size: 21rpx;
  color: var(--campus-manager-muted);
}

.schedule-filter__value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 24rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-filter__clear,
.schedule-form__close {
  flex: none;
  width: var(--campus-manager-touch-min);
  padding: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.74);
  font-size: 38rpx;
  color: var(--campus-manager-muted);
}

.schedule-form {
  margin-top: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 16rpx;
  background: var(--campus-manager-glass);
  box-shadow: 0 9rpx 20rpx rgba(63, 46, 15, 0.15);
}

.schedule-form__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.schedule-form__title {
  font-family: var(--campus-manager-font-display);
  font-size: 38rpx;
  font-weight: 700;
}

.schedule-form__field {
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin-top: 24rpx;
}

.schedule-form__label {
  font-family: var(--campus-manager-font-display);
  font-size: 27rpx;
  font-weight: 700;
}

.schedule-form__picker {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: var(--campus-manager-touch-min);
  margin-top: 10rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(32, 29, 23, 0.14);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.78);
}

.schedule-form__value {
  max-width: 100%;
  overflow: hidden;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-form__derived {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.schedule-form__derived-item {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 116, 71, 0.12);
}

.schedule-form__derived-label {
  font-size: 20rpx;
  color: var(--campus-manager-muted);
}

.schedule-form__derived-value {
  margin-top: 7rpx;
  overflow-wrap: anywhere;
  font-size: 25rpx;
  font-weight: 700;
}

.schedule-form__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 16rpx;
}

.schedule-form__field--wide {
  grid-column: 1 / -1;
}

.schedule-form__error {
  display: block;
  margin-top: 22rpx;
  overflow-wrap: anywhere;
  font-size: 24rpx;
  color: #9b1919;
}

.schedule-form__submit,
.page-state__retry,
.schedule-options-error__retry,
.load-more {
  background: var(--campus-manager-orange);
  color: #ffffff;
}

.schedule-form__submit {
  width: 100%;
  margin-top: 28rpx;
  font-family: var(--campus-manager-font-display);
  font-size: 30rpx;
  font-weight: 700;
}

.schedule-form__submit[disabled],
.load-more[disabled] {
  opacity: 0.58;
}

.schedule-options-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.66);
  font-size: 22rpx;
  color: #9b1919;
}

.schedule-options-error__retry {
  flex: none;
  min-height: 64rpx;
  padding: 0 18rpx;
  font-size: 21rpx;
}

.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 26rpx;
}

.lesson-row {
  min-height: 250rpx;
  padding: 25rpx 27rpx;
  box-sizing: border-box;
  border-left: 8rpx solid var(--campus-manager-orange);
  border-radius: 16rpx;
  background: var(--campus-manager-glass);
  box-shadow: 0 8rpx 18rpx rgba(63, 46, 15, 0.14);
}

.lesson-row__head,
.lesson-row__time,
.lesson-row__meta,
.lesson-row__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.lesson-row__heading-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.lesson-row__course {
  overflow-wrap: anywhere;
  font-family: var(--campus-manager-font-display);
  font-size: 36rpx;
  font-weight: 700;
}

.lesson-row__class {
  margin-top: 7rpx;
  overflow-wrap: anywhere;
  font-size: 23rpx;
  color: var(--campus-manager-muted);
}

.lesson-row__status {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(35, 135, 96, 0.14);
  font-size: 21rpx;
  color: #176a4b;
}

.lesson-row__status--COMPLETED,
.lesson-row__status--REVERSED,
.lesson-row__status--CANCELLED {
  background: rgba(32, 29, 23, 0.1);
  color: var(--campus-manager-muted);
}

.lesson-row__status--IN_PROGRESS {
  background: rgba(255, 116, 71, 0.16);
  color: #9a3c20;
}

.lesson-row__time {
  margin-top: 18rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.lesson-row__meta {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--campus-manager-muted);
}

.lesson-row__actions {
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid rgba(32, 29, 23, 0.12);
}

.lesson-row__edit,
.lesson-row__cancel {
  min-width: 132rpx;
  min-height: 72rpx;
}

.lesson-row__edit {
  background: var(--campus-manager-orange);
  color: #ffffff;
}

.lesson-row__cancel {
  border: 2rpx solid rgba(153, 10, 4, 0.36);
  background: rgba(255, 255, 255, 0.72);
  color: var(--campus-manager-red);
}

.page-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 390rpx;
  margin-top: 26rpx;
  padding: 34rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--campus-manager-glass);
}

.page-state__title {
  font-family: var(--campus-manager-font-display);
  font-size: 42rpx;
  font-weight: 700;
}

.page-state__message {
  margin-top: 14rpx;
  overflow-wrap: anywhere;
  font-size: 25rpx;
  color: var(--campus-manager-muted);
}

.page-state__retry,
.load-more {
  margin-top: 24rpx;
}

.load-more {
  align-self: center;
  min-width: 220rpx;
}

.control--hover {
  opacity: 0.72;
}

@media (max-width: 380px) {
  .schedule-page__heading {
    align-items: flex-start;
  }

  .schedule-page__create {
    min-width: 136rpx;
    padding: 0 18rpx;
  }

  .schedule-filters,
  .lesson-row__time {
    flex-wrap: wrap;
  }

  .schedule-filter {
    flex-basis: 250rpx;
  }
}
