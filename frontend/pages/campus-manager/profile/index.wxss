.profile {
  position: relative;
  min-height: calc(100vh - 120rpx);
  padding: 84rpx 0 0;
  box-sizing: border-box;
  overflow: visible;
}

.profile::after {
  position: absolute;
  top: calc(100vh - 270rpx);
  right: -160rpx;
  bottom: auto;
  left: -160rpx;
  z-index: 0;
  height: 560rpx;
  border-radius: 50% 50% 0 0;
  background: #ffd75e;
  content: "";
}

.profile-hero {
  position: relative;
  z-index: 2;
  height: 456rpx;
}

.profile-card {
  position: absolute;
  bottom: 0;
  left: 14rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  width: 653rpx;
  min-height: 265rpx;
  padding: 28rpx 43% 28rpx 42rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 32rpx;
  background: #fe8419;
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.profile-card__name,
.profile-card__campus,
.profile-card__role {
  position: relative;
  z-index: 3;
  max-width: 100%;
  overflow-wrap: anywhere;
  color: #ffffff;
}

.profile-card__name {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-family: var(--campus-manager-font-display);
  font-size: 78rpx;
  font-weight: 700;
  line-height: 1.05;
}

.profile-card__meta {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10rpx;
  width: 360rpx;
  max-width: 360rpx;
  min-width: 0;
  margin-top: 14rpx;
}

.profile-card__campus,
.profile-card__role {
  display: inline-block;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  font-family: var(--campus-manager-font-display);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-card__campus {
  flex: 1;
}

.profile-card__role {
  flex: none;
  font-size: 28rpx;
}

.profile-hero__character {
  position: absolute;
  right: -32rpx;
  bottom: 0;
  z-index: 2;
  width: 462rpx;
  pointer-events: none;
}

.profile-actions-stage {
  position: relative;
  z-index: 1;
  min-height: 850rpx;
  margin-top: 54rpx;
}

.profile-actions-stage__character {
  position: absolute;
  top: 100rpx;
  left: -32rpx;
  z-index: 0;
  width: 573rpx;
  pointer-events: none;
}

.profile-actions {
  position: relative;
  z-index: 2;
  width: 653rpx;
  margin-left: 14rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: rgba(255, 215, 94, 0.84);
  box-shadow: 0 13rpx 24rpx rgba(24, 18, 14, 0.19);
}

.profile-action {
  display: flex;
  align-items: center;
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  border: 0;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 0;
  background: transparent;
  line-height: 1.2;
  text-align: left;
}

.profile-action:last-child {
  border-bottom: 0;
}

.profile-action::after,
.page-state__retry::after {
  border: 0;
}

.profile-action__bullet {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  margin-right: 32rpx;
  border-radius: 50%;
  background: #2fbd82;
}

.profile-action__label {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-family: var(--campus-manager-font-display);
  font-size: 34rpx;
  font-weight: 700;
  color: #243b36;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-action__command {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  min-height: 56rpx;
  margin-left: 16rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #fe8419;
  font-size: 24rpx;
  color: #ffffff;
}

.profile-session {
  position: relative;
  z-index: 3;
  width: 653rpx;
  margin: 28rpx 0 120rpx 14rpx;
}

.page-state__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: var(--campus-manager-touch-min);
  margin: 18rpx 0 0;
  border: 0;
  border-radius: 16rpx;
  background: #fe8419;
  font-size: 26rpx;
  color: #ffffff;
}

.page-state {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 520rpx;
  padding: 34rpx;
}

.page-state__title {
  font-family: var(--campus-manager-font-display);
  font-size: 45rpx;
  font-weight: 700;
}

.page-state__message {
  max-width: 100%;
  margin-top: 16rpx;
  overflow-wrap: anywhere;
  font-size: 24rpx;
  color: var(--campus-manager-muted);
}

.page-state__retry {
  width: auto;
  padding: 0 34rpx;
}

.button--hover {
  opacity: 0.72;
}
