NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:app_local_password@postgres:5432/education_app?schema=public
TEST_DATABASE_URL=postgresql://app:app_test_password@postgres_test:5432/education_app_test?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace_in_local_env
JWT_REFRESH_SECRET=replace_in_local_env
FILE_STORAGE_DRIVER=local
FILE_STORAGE_ROOT=/app/storage
AUTH_DRIVER=mock
# Required only when AUTH_DRIVER=wechat. Never expose the AppSecret to the mini program.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
PAYMENT_DRIVER=mock
# Required only when PAYMENT_DRIVER=wechat. Never commit real merchant secrets.
WECHAT_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERT=
WECHAT_PAY_NOTIFY_URL=
PAYOUT_DRIVER=manual
MESSAGE_DRIVER=mock
TZ=Asia/Shanghai
